# 复制本文件为 config.env 并填写（config.env 已被 .gitignore 排除，不会提交到仓库）

# 小程序 appid（已从 project.config.json 读出）
APPID=wx96f0086fe7b2b7cd

# 云环境 ID（云开发控制台首页可见，形如 xxx-xxx-xxx 或 cloud1-xxx）
ENV_ID=

# 代码上传密钥路径（微信公众平台 → 开发 → 开发设置 → 小程序代码上传密钥 下载）
# 建议放在仓库外，例如 ~/.wechat/private.wx96f0086fe7b2b7cd.key
PRIVATE_KEY_PATH=~/.wechat/private.wx96f0086fe7b2b7cd.key

# AppSecret（微信公众平台 → 开发 → 开发设置 → AppSecret），
# 仅数据库操作（HTTP API 换 access_token）需要，不填则跳过数据库功能
APP_SECRET=
