<view class="page viewport-page">
  <view class="card card-hero">
    <view class="card-bd">
      <view class="section-title-lg">数据检索</view>
      <view class="section-desc">按白名单集合和文档 ID 查询单条数据，适合快速核对线上记录。</view>

      <view class="field-block mt">
        <view class="field-label">集合</view>
        <picker mode="selector" range="{{collections}}" value="{{collectionIndex}}" bindchange="onCollectionChange">
          <view class="field-select"><text class="field-select__value">{{collections[collectionIndex]}}</text><text class="field-select__arrow">▾</text></view>
        </picker>
      </view>

      <view class="field-block mt">
        <view class="field-label">文档 ID</view>
        <input
          class="input"
          placeholder="输入 _id"
          placeholder-class="ph"
          value="{{docId}}"
          bindinput="onDocIdInput"
        />
      </view>

      <view class="row mt-sm">
        <view class="btn btn-primary flex" bindtap="onSearch">{{loading ? '查询中' : '开始查询'}}</view>
        <view class="btn btn-ghost mini ml" bindtap="onCopyResult">复制结果</view>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="viewport-scroll">
    <view wx:if="{{error}}" class="card mt">
      <view class="card-bd">
        <view class="tag tag-warn">{{error}}</view>
      </view>
    </view>

    <view wx:if="{{searched}}" class="card mt">
      <view class="card-hd">查询结果</view>
      <view class="card-bd">
        <view class="row">
          <view class="section-title">{{resultCollection || collections[collectionIndex]}}</view>
          <view class="tag {{found ? '' : 'tag-warn'}}">{{found ? '已找到' : '未找到'}}</view>
        </view>
        <view class="section-tip break-all">文档 ID: {{resultId || '-'}}</view>
        <view class="json-block mt">{{resultText || 'null'}}</view>
      </view>
    </view>
  </scroll-view>
</view>
