.viewport-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.viewport-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 18rpx;
}

.field-block {
  display: flex;
  flex-direction: column;
}

.json-block {
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(231, 233, 243, 0.82);
  white-space: pre-wrap;
  word-break: break-all;
}

.break-all {
  word-break: break-all;
}
