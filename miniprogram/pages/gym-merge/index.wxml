<view class="page ui-v2 mg-page {{preview ? 'mg-page--bar' : ''}}">
  <!-- 源岩馆 -->
  <view class="card mg-card">
    <text class="field-label">源岩馆（合并后停用）</text>
    <view class="mg-gymname">{{sourceGym.name || sourceGym.gymName || '加载中…'}}</view>
    <view wx:if="{{sourceGym.city || sourceGym.address}}" class="mg-sub">{{sourceGym.city}} {{sourceGym.address}}</view>
  </view>

  <!-- 目标岩馆：只选择一次，不重复展示完整卡片 -->
  <view class="card mg-card">
    <text class="field-label">目标岩馆（并入此馆）</text>
    <view class="field-select mg-select" bindtap="onOpenTargetSheet">
      <text class="field-select__value {{targetGym ? '' : 'ph'}}">{{targetGym ? targetGym.name : '请选择目标岩馆'}}</text>
      <text class="field-select__arrow">⌄</text>
    </view>
    <view class="btn btn-primary mg-submit {{(!targetGym || loadingPreview) ? 'btn--disabled' : ''}}" bindtap="onPreviewMerge">
      {{loadingPreview ? '检查中…' : '查看合并预览'}}
    </view>
  </view>

  <!-- 预览摘要 -->
  <view wx:if="{{preview}}" class="card mg-card">
    <view class="mg-sec-t">合并预览</view>
    <view class="mg-row">
      <text class="mg-row__k">源数据</text>
      <text class="mg-row__v">{{preview.summary.sourceText || '无数据'}}</text>
    </view>
    <view class="mg-row">
      <text class="mg-row__k">目标数据</text>
      <text class="mg-row__v">{{preview.summary.targetText || '无数据'}}</text>
    </view>
    <view class="mg-row">
      <text class="mg-row__k">周期冲突</text>
      <view class="mg-row__v">
        <text>{{preview.cyclePlan.conflictCount || 0}} 个</text>
        <text wx:if="{{preview.cyclePlan.conflictCount > 0}}" class="tag mg-conflict-tag">需映射</text>
      </view>
    </view>
    <view wx:if="{{preview.warnings && preview.warnings.length}}" class="mg-warn">
      <text wx:for="{{preview.warnings}}" wx:key="*this" class="mg-warn__item">{{item}}</text>
    </view>
    <view class="state-banner {{canSubmit ? 'is-success' : 'is-pending'}}">
      <text>{{canSubmit ? '条件已满足，可以执行合并' : '还差 ' + mappingRemaining + ' 项周期映射才能合并'}}</text>
    </view>
  </view>

  <!-- 必要周期映射：逐项纵向展开 -->
  <view wx:if="{{preview && cycleMappings.length}}" class="card mg-card">
    <view class="mg-sec-t">周期映射（{{cycleMappings.length - mappingRemaining}}/{{cycleMappings.length}}）</view>
    <view wx:for="{{cycleMappings}}" wx:key="sourceCycleId" class="mg-map">
      <view class="mg-map__src">{{item.sourceCycleName}} {{item.sourceRange}}</view>
      <view class="mg-map__cur {{item.targetCycleId ? '' : 'is-pending'}}">
        {{item.targetCycleName ? item.targetCycleName + ' ' + item.targetRange : '未选择目标周期'}}
      </view>
      <picker mode="selector" range="{{item.targetOptions}}" range-key="label" data-index="{{index}}" bindchange="onPickCycleMapping">
        <view class="field-select mg-map__select">
          <text class="field-select__value">选择目标周期</text>
          <text class="field-select__arrow">⌄</text>
        </view>
      </picker>
    </view>
    <view class="mg-map-summary">{{mappingSummaryText}}</view>
  </view>

  <!-- 目标岩馆选择 sheet -->
  <view wx:if="{{targetSheetVisible}}" class="sheet-mask" bindtap="onCloseTargetSheet" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet__hd">
        <text class="sheet__title">选择目标岩馆</text>
        <view class="sheet__close" bindtap="onCloseTargetSheet">✕</view>
      </view>
      <view class="sheet__search">
        <view class="searchbar">
          <text class="searchbar__ic">🔍</text>
          <input
            class="searchbar__input"
            placeholder="搜索名称 / 城市 / 地址"
            placeholder-class="ph"
            value="{{targetKeyword}}"
            bindinput="onTargetKeyword"
          />
        </view>
      </view>
      <scroll-view class="sheet__bd" scroll-y>
        <view
          wx:for="{{filteredTargetGyms}}"
          wx:key="_id"
          class="sheet-item"
          data-id="{{item._id}}"
          bindtap="onPickTarget"
        >
          <view class="sheet-item__info">
            <view class="sheet-item__name">{{item.name}}</view>
            <view class="sheet-item__sub">{{item.city || '未设置城市'}}</view>
          </view>
          <text wx:if="{{targetGymId === item._id}}" class="sheet-item__check">✓</text>
        </view>
        <view wx:if="{{!filteredTargetGyms.length && !loading}}" class="sheet-empty">暂无匹配的目标岩馆</view>
      </scroll-view>
    </view>
  </view>

  <!-- 确认动作：固定底栏，仅一段流程的最后一步使用 -->
  <view wx:if="{{preview}}" class="action-bar">
    <view class="btn btn-primary {{!canSubmit || submitting ? 'btn--disabled' : ''}}" bindtap="onSubmitMerge">
      {{submitting ? '合并中…' : '确认执行合并'}}
    </view>
  </view>
</view>
