/* 页面特有布局；元素样式统一由全局 app.wxss 提供 */

.page--merge {
  padding-bottom: 200rpx;
}

.mapping-source {
  font-weight: 700;
}

.pre-line {
  white-space: pre-line;
}

.warning-box {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(242, 193, 78, 0.1);
  border: 1rpx solid rgba(242, 193, 78, 0.24);
}

.warning-box .hint + .hint {
  margin-top: 8rpx;
}
