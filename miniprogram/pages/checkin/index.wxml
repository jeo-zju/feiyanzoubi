<view class="page">
  <view class="card card-hero">
    <view class="top">
      <view class="top-row">
        <view class="gym-wrap">
          <view class="gym">{{gym.name}}</view>
          <view class="section-desc top-desc">记下今天在馆里的完成情况</view>
        </view>
        <view class="actions">
          <view class="btn btn-ghost mini top-btn" bindtap="goWall">看攀岩墙</view>
          <view class="btn btn-warn mini top-btn" bindtap="goHome">换个馆</view>
        </view>
      </view>
      <view class="top-sub">
        <view class="tag cycle-tag">{{cycleLabel}}</view>
        <view class="date-chip" bindtap="openCalendar">
          <view class="muted date-label">打卡日期</view>
          <view class="tag tag-warn date-tag">{{date}}</view>
        </view>
      </view>
    </view>
    <view class="card-bd">
      <seg-tabs wx:if="{{modeTabs.length > 1}}" tabs="{{modeTabs}}" value="{{mode}}" bind:change="onModeChange" />
      <view wx:elif="{{modeTabs.length === 1}}" class="top-sub">
        <view class="tag cycle-tag">{{modeTabs[0].label}}</view>
      </view>
      <view class="panel table">
        <view class="thead">
          <view class="th th-grade muted">等级</view>
          <view class="th th-total muted">累计/上限</view>
          <view class="th th-check muted">打卡</view>
        </view>
        <view class="tbody">
          <view class="tr" wx:for="{{rows}}" wx:key="key">
            <view class="td td-grade">
              <view class="tag grade-tag">{{item.label}}</view>
            </view>
            <view class="td td-total">{{item.progressText}}</view>
            <view class="td td-check">
              <view class="stepper">
                <view
                  class="step-btn {{item.delta>0?'':'step-btn--disabled'}}"
                  data-key="{{item.key}}"
                  bindtap="onDec"
                >
                  -
                </view>
                <view class="delta-text">{{item.deltaText}}</view>
                <view
                  class="step-btn step-btn--inc {{item.canInc?'':'step-btn--disabled'}}"
                  data-key="{{item.key}}"
                  bindtap="onInc"
                >
                  +
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="btn btn-primary submit" bindtap="onSubmit">保存打卡</view>

  <date-cal
    visible="{{calendarVisible}}"
    value="{{date}}"
    min="{{dateStart}}"
    max="{{dateEnd}}"
    bind:change="onCalendarChange"
    bind:close="closeCalendar"
  />
</view>

