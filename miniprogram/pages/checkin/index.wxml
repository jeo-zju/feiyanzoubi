<view class="page">
  <view class="card card-hero">
    <view class="top">
      <view class="row">
        <view class="section-kicker">打卡</view>
        <view
          wx:if="{{revertAvailable || revertJustNow}}"
          class="btn mini {{revertAvailable ? 'btn-warn' : 'btn-ghost btn--disabled'}}"
          bindtap="onTapRevert"
        >撤销本次打卡</view>
      </view>
      <view class="top-row">
        <view class="gym-wrap">
          <view class="gym">{{gym.name}}</view>
          <view class="section-desc top-desc">记录今天在馆里的完成情况</view>
        </view>
        <view class="actions">
          <view class="btn btn-ghost mini" bindtap="goWall">攀岩墙</view>
          <view class="btn btn-warn mini" bindtap="goHome">去爬其他馆</view>
        </view>
      </view>
      <view class="top-sub">
        <view class="tag">{{cycleLabel}}</view>
        <view class="tag tag-warn" bindtap="openCalendar">打卡日期 {{date}} ▾</view>
      </view>
    </view>
    <view class="card-bd">
      <seg-tabs tabs="{{modeTabs}}" value="{{mode}}" bind:change="onModeChange" />
      <view class="panel table">
        <view class="thead">
          <view class="th th-grade muted">等级</view>
          <view class="th th-total muted">累计/上限</view>
          <view class="th th-check muted">打卡</view>
        </view>
        <view class="tbody">
          <view class="tr" wx:for="{{rows}}" wx:key="key">
            <view class="td td-grade">
              <view class="tag">{{item.label}}</view>
            </view>
            <view class="td td-total">{{item.progressText}}</view>
            <view class="td td-check">
              <view class="stepper">
                <view
                  class="icon-btn {{item.delta>0?'':'step-disabled'}}"
                  data-key="{{item.key}}"
                  bindtap="onDec"
                >
                  -
                </view>
                <view class="delta-text">{{item.deltaText}}</view>
                <view
                  class="icon-btn icon-btn--warn {{item.canInc?'':'step-disabled'}}"
                  data-key="{{item.key}}"
                  bindtap="onInc"
                >
                  +
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="btn btn-primary mt" bindtap="onSubmit">今天就爬到这了！</view>

  <date-cal
    visible="{{calendarVisible}}"
    value="{{date}}"
    min="{{dateStart}}"
    max="{{dateEnd}}"
    bind:change="onCalendarChange"
    bind:close="closeCalendar"
  />
</view>

