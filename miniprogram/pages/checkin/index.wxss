/* 记录攀爬（compact）：馆名/日期 → 周期/类型 → 等级步进 → 唯一保存 */
page {
  background: #151714;
}

.ck-page {
  padding: 24rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
}

.ck-page .btn::after {
  border: none;
}

/* 馆名 + 日期 */
.ck-head {
  padding: 12rpx 24rpx;
}

.ck-gym {
  padding: 16rpx 0;
}

.ck-gym__main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.ck-gym__sub {
  font-size: 22rpx;
  color: #969D90;
}

.ck-head__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 0 12rpx;
}

.ck-date {
  color: #B9BDB0;
}

.ck-wall {
  flex-shrink: 0;
}

.ck-cycle {
  margin: 18rpx 4rpx 0;
  font-size: 24rpx;
  color: #969D90;
}

.ck-tabs {
  margin-top: 18rpx;
}

/* 保存结果摘要 */
.ck-result {
  margin-top: 20rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ck-result__text {
  flex: 1;
  min-width: 0;
}

.ck-result__undo {
  flex-shrink: 0;
}

/* 等级表 */
.ck-table {
  margin-top: 20rpx;
  padding: 0 12rpx 8rpx;
}

.ck-thead {
  display: flex;
  align-items: center;
  padding: 22rpx 16rpx 12rpx;
  border-bottom: 1rpx solid #383E34;
  font-size: 24rpx;
  color: #969D90;
}

.ck-row {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  border-bottom: 1rpx solid rgba(56, 62, 52, 0.6);
}

.ck-row:last-child {
  border-bottom: none;
}

.ck-th-grade,
.ck-grade {
  flex: 1.2;
  min-width: 0;
}

.ck-th-total,
.ck-total {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #B9BDB0;
  text-align: center;
}

.ck-grade .tag {
  max-width: 100%;
}

.ck-th-check,
.ck-stepper {
  flex: 0 0 220rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.ck-th-check {
  justify-content: center;
}

.ck-stepper {
  justify-content: flex-end;
}

/* 加减热区 88rpx，不压缩等级文字 */
.ck-step {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
  background: #20241F;
  border: 1rpx solid #383E34;
  color: #F3F1E7;
}

.ck-step:active {
  border-color: rgba(210, 239, 114, 0.5);
}

.ck-step--off {
  opacity: 0.35;
}

.ck-delta {
  min-width: 56rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #F3F1E7;
}

.ck-nogym {
  margin-top: 160rpx;
}

.ck-nogym .btn {
  margin-top: 24rpx;
}

/* 弹层主体限高滚动 */
.ck-page .sheet__bd {
  max-height: 60vh;
}
