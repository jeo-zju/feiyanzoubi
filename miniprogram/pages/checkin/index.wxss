.page {
  padding-bottom: 36rpx;
}

.top {
  padding: 22rpx 22rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.top-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.gym-wrap {
  flex: 1;
  min-width: 0;
}

.gym {
  font-size: 38rpx;
  font-weight: 900;
}

.top-desc {
  margin-top: 10rpx;
}

.actions {
  display: flex;
  gap: 12rpx;
}

.top-btn {
  min-width: 128rpx;
}

.top-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.cycle-tag {
  width: fit-content;
}

.date-label {
  font-size: 24rpx;
}

.date-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 0;
}

.date-tag {
  padding: 10rpx 16rpx;
}

.table {
  margin-top: 18rpx;
  padding: 0;
  overflow: hidden;
}

.thead {
  display: flex;
  align-items: center;
  padding: 18rpx 18rpx 14rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.th-grade {
  width: 170rpx;
}

.th-total {
  width: 160rpx;
}

.th-check {
  flex: 1;
  text-align: right;
  padding-right: 8rpx;
}

.tr {
  display: flex;
  align-items: center;
  padding: 14rpx 18rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.tr:last-child {
  border-bottom: none;
}

.td-grade {
  width: 170rpx;
}

.grade-tag {
  width: fit-content;
  padding: 8rpx 14rpx;
}

.td-total {
  width: 160rpx;
  font-weight: 800;
}

.td-check {
  flex: 1;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
}

.step-btn {
  width: 72rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.step-btn--inc {
  background: rgba(242, 193, 78, 0.14);
  color: #f2c14e;
  border-color: rgba(242, 193, 78, 0.25);
}

.step-btn--disabled {
  opacity: 0.35;
}

.delta-text {
  width: 90rpx;
  text-align: center;
  font-weight: 900;
  color: #f2c14e;
}

.submit {
  margin-top: 24rpx;
  height: 88rpx;
  border-radius: 18rpx;
}

