/* 页面特有布局：打卡头部、等级表格、步进器（按钮/标签均用全局类） */
.page {
  padding-bottom: 180rpx;
}

.top {
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.top-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.gym-wrap {
  flex: 1;
  min-width: 0;
}

.gym {
  font-size: 40rpx;
  font-weight: 900;
}

.top-desc {
  margin-top: 10rpx;
}

.actions {
  display: flex;
  gap: 14rpx;
}

.top-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.table {
  margin-top: 18rpx;
  padding: 0;
  overflow: hidden;
}

.thead {
  display: flex;
  align-items: center;
  padding: 18rpx 18rpx 14rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 24rpx;
}

.th-grade {
  width: 170rpx;
}

.th-total {
  width: 160rpx;
}

.th-check {
  flex: 1;
  text-align: right;
  padding-right: 8rpx;
}

.tr {
  display: flex;
  align-items: center;
  padding: 14rpx 18rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.tr:last-child {
  border-bottom: none;
}

.td-grade {
  width: 170rpx;
}

.td-total {
  width: 160rpx;
  font-weight: 800;
}

.td-check {
  flex: 1;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
}

.step-disabled {
  opacity: 0.35;
  pointer-events: none;
}

.delta-text {
  width: 90rpx;
  text-align: center;
  font-weight: 900;
  color: #f2c14e;
}
