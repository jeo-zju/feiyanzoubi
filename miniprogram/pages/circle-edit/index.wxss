/* circle-edit：仅页面特有布局，元素样式全部来自 app.wxss 全局 */

.page--circle-edit {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* scroll-view 作为弹层主体时，高度约束交给 scroll-view 自身滚动 */
.page--circle-edit .sheet__bd {
  overflow: hidden;
  min-height: 0;
}

.form-block { flex-shrink: 0; }

/* 可点击的字段标题（右侧带计数） */
.form-block .field-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.form-kicker__n {
  color: #c5baff;
}

/* 圈标颜色选择 */
.color-row {
  display: flex;
  gap: 20rpx;
  padding: 10rpx 4rpx 0;
}
.color-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  position: relative;
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.04);
}
.color-dot--on { box-shadow: 0 0 0 4rpx rgba(143, 123, 255, 0.66); }
.color-dot__check {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.35);
}

/* 已选岩馆标签 */
.gym-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 4rpx 4rpx 0;
}
