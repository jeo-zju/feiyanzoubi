/* 新建/编辑岩友圈（compact）：颜色小行 + 表单字段 + 底部唯一保存 */
page {
  background: #151714;
}

.ce-page {
  padding: 24rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
}

.ce-field {
  margin-top: 28rpx;
}

.ce-field .field-label {
  margin-bottom: 14rpx;
}

.ce-field__opt {
  color: #969D90;
  font-size: 24rpx;
  font-weight: 400;
}

/* 圈标颜色小行 */
.ce-color-row {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 4rpx 0;
}

.ce-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  position: relative;
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.05);
}

.ce-dot--on {
  box-shadow: 0 0 0 4rpx #D2EF72;
}

.ce-dot__check {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #151714;
  font-size: 28rpx;
  font-weight: 700;
}

/* 弹层主体滚动 */
.ce-page .sheet__bd {
  max-height: 56vh;
}
