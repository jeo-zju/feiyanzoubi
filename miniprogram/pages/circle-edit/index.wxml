<view class="page page--circle-edit">
  <view class="nav-bar">
    <view class="icon-btn" bindtap="goBack">‹</view>
    <view class="nav-title">{{mode==='edit' ? '编辑岩友圈' : '新建岩友圈'}}</view>
    <view class="icon-btn" bindtap="onSave">✓</view>
  </view>

  <view class="form-block">
    <view class="field-label">圈标颜色</view>
    <view class="color-row">
      <block wx:for="{{circleColors}}" wx:key="*this">
        <view class="color-dot {{selectedColorIndex===index?'color-dot--on':''}}"
          style="background:{{item}};"
          data-idx="{{index}}"
          bindtap="onPickColor">
          <view wx:if="{{selectedColorIndex===index}}" class="color-dot__check">✓</view>
        </view>
      </block>
    </view>
  </view>

  <view class="form-block">
    <view class="field-label">圈名 / 城市 / 简介</view>
    <input class="input" placeholder="圈名，≤12字" value="{{name}}" maxlength="12" bindinput="onInputName" placeholder-class="ph" />
    <view class="field-select mt-sm" bindtap="openCitySheet">
      <text class="field-select__value">📍 {{city || '选择城市'}}</text>
      <text class="field-select__arrow">▾</text>
    </view>
    <input class="input mt-sm" placeholder="简介，≤40字（可选）" value="{{description}}" maxlength="40" bindinput="onInputDesc" placeholder-class="ph" />
  </view>

  <view class="form-block">
    <view class="field-label" bindtap="openGymSheet">
      <text>岩馆关联（可多选）</text>
      <text class="form-kicker__n">已选 {{gymIds.length}}</text>
    </view>
    <view class="gym-tags" wx:if="{{gymIds.length>0}}">
      <block wx:for="{{gymIds}}" wx:key="*this">
        <view class="tag tag--on">{{gymMap[item] ? gymMap[item].name : '岩馆'}}</view>
      </block>
    </view>
    <button wx:else class="btn btn-ghost" bindtap="openGymSheet">+ 选择关联岩馆</button>
  </view>

  <view wx:if="{{citySheetVisible}}" class="sheet-mask" bindtap="closeCitySheet" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet__hd">
        <text class="sheet__title">选择城市</text>
        <view class="sheet__close" bindtap="closeCitySheet">✕</view>
      </view>
      <scroll-view class="sheet__bd" scroll-y>
        <view class="sheet-item" wx:for="{{cityOptions}}" wx:key="name"
          data-name="{{item.name}}"
          data-custom="{{item.custom || false}}"
          bindtap="onPickCity">
          <text class="sheet-item__label">{{item.name}}</text>
          <text wx:if="{{city === item.name}}" class="sheet-item__check">✓</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{gymSheetVisible}}" class="sheet-mask" bindtap="closeGymSheet" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet__hd">
        <text class="sheet__title">选择岩馆</text>
        <view class="sheet__close" bindtap="closeGymSheet">✓</view>
      </view>
      <view class="sheet__search">
        <view class="searchbar">
          <text class="searchbar__ic">🔍</text>
          <input class="searchbar__input" placeholder="搜索岩馆名称 / 地址" value="{{gymKeyword}}" confirm-type="search" bindinput="onGymKeywordInput" bindconfirm="onGymKeywordInput" placeholder-class="ph" />
        </view>
      </view>
      <scroll-view class="sheet__bd" scroll-y lower-threshold="80" bindscrolltolower="onGymPickerScrollLower">
        <block wx:if="{{gymOptions.length > 0}}">
          <view class="sheet-item" wx:for="{{gymOptions}}" wx:key="_id"
            data-id="{{item._id}}"
            bindtap="toggleGym">
            <text class="sheet-item__label">{{item.name}}</text>
            <view class="check-box {{item.checked ? 'check-box--on' : ''}}">
              <text wx:if="{{item.checked}}" class="check-box__t">✓</text>
            </view>
          </view>
          <view wx:if="{{_gymPickerState.hasMore}}" class="sheet-more" bindtap="onGymPickerLoadMore">{{_gymPickerState.loading ? "加载中…" : "加载更多"}}</view>
        </block>
        <view wx:else class="sheet-empty">{{_gymPickerState.loading ? "加载中…" : (gymKeyword ? "没有找到匹配的岩馆" : "当前城市暂无岩馆")}}</view>
      </scroll-view>
    </view>
  </view>
</view>
