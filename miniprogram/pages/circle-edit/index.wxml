<view class="page ui-v2 ce-page">
  <!-- 圈标颜色小行 -->
  <view class="ce-color-row">
    <block wx:for="{{circleColors}}" wx:key="*this">
      <view class="ce-dot {{selectedColorIndex===index?'ce-dot--on':''}}"
        style="background:{{item}};"
        data-idx="{{index}}"
        bindtap="onPickColor">
        <view wx:if="{{selectedColorIndex===index}}" class="ce-dot__check">✓</view>
      </view>
    </block>
  </view>

  <!-- 圈名 -->
  <view class="ce-field">
    <view class="field-label">圈名</view>
    <input class="input" placeholder="给圈子起个名字，≤12字" value="{{name}}" maxlength="12" bindinput="onInputName" placeholder-class="ph" />
  </view>

  <!-- 城市（统一选择弹层触发器） -->
  <view class="ce-field">
    <view class="field-label">城市</view>
    <view class="field-select" bindtap="openCitySheet">
      <text class="field-select__value {{city ? '' : 'ph'}}">{{city || '选择城市'}}</text>
      <text class="field-select__arrow">⌄</text>
    </view>
  </view>

  <!-- 简介选填 -->
  <view class="ce-field">
    <view class="field-label">简介<text class="ce-field__opt">（选填）</text></view>
    <input class="input" placeholder="一句话介绍这个圈，≤40字" value="{{description}}" maxlength="40" bindinput="onInputDesc" placeholder-class="ph" />
  </view>

  <!-- 已选岩馆摘要：正文最多两条 + 共N家，点开统一多选弹层 -->
  <view class="ce-field">
    <view class="field-label">关联岩馆<text class="ce-field__opt">（选填）</text></view>
    <view class="gym-sum" bindtap="openGymSheet">
      <view class="gym-sum__ic">馆</view>
      <view class="gym-sum__main">
        <view class="gym-sum__name {{gymIds.length ? '' : 'ph'}}">{{gymSummaryName}}</view>
        <view wx:if="{{gymIds.length}}" class="gym-sum__sub">共 {{gymIds.length}} 家{{gymIds.length > 2 ? '，弹层内可看全部' : ''}}</view>
      </view>
      <text class="gym-sum__arrow">⌄</text>
    </view>
  </view>

  <view class="action-bar">
    <button class="btn btn-primary" loading="{{saving}}" disabled="{{saving}}" bindtap="onSave">{{mode==='edit' ? '保存' : '创建岩友圈'}}</button>
  </view>

  <!-- 城市选择 -->
  <view wx:if="{{citySheetVisible}}" class="sheet-mask" bindtap="closeCitySheet" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet__hd">
        <text class="sheet__title">选择城市</text>
        <view class="sheet__close" bindtap="closeCitySheet">✕</view>
      </view>
      <scroll-view class="sheet__bd" scroll-y>
        <view class="sheet-item" wx:for="{{cityOptions}}" wx:key="name"
          data-name="{{item.name}}"
          data-custom="{{item.custom || false}}"
          bindtap="onPickCity">
          <text class="sheet-item__label">{{item.name}}</text>
          <text wx:if="{{city === item.name}}" class="sheet-item__check">✓</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 岩馆多选：取消（✕）保留已勾选择，保存按钮统一提交 -->
  <view wx:if="{{gymSheetVisible}}" class="sheet-mask" bindtap="closeGymSheet" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet__hd">
        <text class="sheet__title">关联岩馆 · 已选 {{gymIds.length}}</text>
        <view class="sheet__close" bindtap="closeGymSheet">✕</view>
      </view>
      <view class="sheet__search">
        <view class="searchbar">
          <text class="searchbar__ic">🔍</text>
          <input class="searchbar__input" placeholder="搜索岩馆名称 / 地址" value="{{gymKeyword}}" confirm-type="search" bindinput="onGymKeywordInput" bindconfirm="onGymKeywordInput" placeholder-class="ph" />
        </view>
      </view>
      <scroll-view class="sheet__bd" scroll-y lower-threshold="80" bindscrolltolower="onGymPickerScrollLower">
        <block wx:if="{{gymOptions.length > 0}}">
          <view class="sheet-item" wx:for="{{gymOptions}}" wx:key="_id"
            data-id="{{item._id}}"
            bindtap="toggleGym">
            <text class="sheet-item__label">{{item.name}}</text>
            <view class="check-box {{item.checked ? 'check-box--on' : ''}}">
              <text wx:if="{{item.checked}}" class="check-box__t">✓</text>
            </view>
          </view>
          <view wx:if="{{_gymPickerState.hasMore}}" class="sheet-more" bindtap="onGymPickerLoadMore">{{_gymPickerState.loading ? "加载中…" : "加载更多"}}</view>
        </block>
        <view wx:else class="sheet-empty">{{_gymPickerState.loading ? "加载中…" : (gymKeyword ? "没有找到匹配的岩馆" : "当前城市暂无岩馆")}}</view>
      </scroll-view>
      <view class="sheet__ft">
        <button class="btn btn-primary" bindtap="closeGymSheet">完成（已选 {{gymIds.length}}）</button>
      </view>
    </view>
  </view>
</view>
