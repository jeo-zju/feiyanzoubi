<view class="page">
  <view class="card card-hero">
    <view class="card-bd">
      <view class="section-kicker">馆长</view>
      <view class="section-title-lg">我的岩馆</view>
      <view class="section-desc">你管理 {{summary.gymCount}} 家岩馆，下面是当前全部线路概览。</view>
      <view class="stat-grid mt">
        <view class="panel stat-card">
          <view class="stat-number stat-number-warn">{{summary.boulderLines}}</view>
          <view class="stat-label">抱石线路</view>
        </view>
        <view class="panel stat-card">
          <view class="stat-number">{{summary.diffLines}}</view>
          <view class="stat-label">难度线路</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card mt">
    <view class="card-hd row">
      <view>岩馆列表</view>
      <view class="icon-btn" bindtap="onAdd">+</view>
    </view>
    <view class="card-bd">
      <gym-card wx:for="{{gyms}}" wx:key="_id" gym="{{item}}" bind:tap="onTapGym" />
      <view wx:if="{{!gyms.length && !loading}}" class="empty-state">
        <view class="empty-state__title">暂无岩馆</view>
        <view class="empty-state__desc">点击右上角 + 添加你的第一家岩馆</view>
      </view>
      <paginator
        wx:if="{{gyms.length}}"
        page="{{page}}"
        hasNext="{{hasNext}}"
        bind:prev="onPrev"
        bind:next="onNext"
      />
    </view>
  </view>
</view>

