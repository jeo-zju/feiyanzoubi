<view class="page ui-v2 friend-page">
  <!-- 搜索：键盘「搜索」触发，右侧清除图标退出搜索 -->
  <view class="searchbar friend-search">
    <text class="searchbar__ic">🔍</text>
    <input
      class="searchbar__input"
      placeholder="搜索昵称 / 岩友ID"
      placeholder-class="ph"
      value="{{searchKeyword}}"
      bindinput="onKeywordInput"
      confirm-type="search"
      bindconfirm="onSearch"
    />
    <view wx:if="{{searchKeyword}}" class="friend-search__clear" catchtap="onClearKw">✕</view>
  </view>

  <!-- 搜索模式：替换正文列表，不叠加在岩友列表上 -->
  <block wx:if="{{searchMode}}">
    <view wx:if="{{searching}}" class="list-status">正在搜索…</view>
    <view wx:elif="{{!searchResult.length}}" class="empty-state friend-empty">
      <view class="empty-state__title">没有搜索到这位岩友</view>
      <view class="empty-state__desc">换个昵称或岩友ID试试</view>
    </view>
    <view wx:else class="friend-list">
      <view wx:for="{{searchResult}}" wx:key="_openid" class="friend-card" data-id="{{item._openid}}" bindtap="onViewCard">
        <image class="friend-card__avatar" src="{{item.avatarUrl || defaultAvatar}}" mode="aspectFill"></image>
        <view class="friend-card__main">
          <view class="friend-card__name">{{item.nickName || '岩友'}}</view>
          <view wx:if="{{item.skillText}}" class="friend-card__sub">{{item.skillText}}</view>
        </view>
        <view class="friend-card__op">
          <text wx:if="{{item.isFriend}}" class="friend-card__state">已是岩友</text>
          <text wx:elif="{{item.outgoing}}" class="friend-card__state">待确认</text>
          <button wx:elif="{{item.incoming}}" catchtap="onAccept" data-id="{{item._openid}}" class="btn btn-primary mini">接受</button>
          <button wx:else catchtap="onRequest" data-id="{{item._openid}}" class="btn btn-primary mini">加好友</button>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="friend-tabs"><seg-tabs theme="v2" tabs="{{listTabs}}" value="{{listTab}}" bind:change="onTabChange" /></view>

    <!-- 收到申请：接受主动作 + 拒绝次动作 -->
    <view wx:if="{{listTab==='incoming'}}" class="friend-list">
      <view wx:if="{{!loading && !incoming.length}}" class="empty-state friend-empty">
        <view class="empty-state__title">暂无收到的申请</view>
      </view>
      <view wx:for="{{incoming}}" wx:key="id" class="friend-card" data-id="{{item.fromOpenid || item.openid}}" bindtap="onViewCard">
        <image class="friend-card__avatar" src="{{item.avatarUrl || defaultAvatar}}" mode="aspectFill"></image>
        <view class="friend-card__main">
          <view class="friend-card__name">{{item.nickName || '岩友'}}</view>
          <view class="friend-card__sub">{{item.createdAtText ? item.createdAtText + ' 收到申请' : '申请加你为岩友'}}</view>
        </view>
        <view class="friend-card__op friend-card__op--btns">
          <button catchtap="onAccept" data-id="{{item.fromOpenid || item.openid}}" class="btn btn-primary mini">接受</button>
          <button catchtap="onReject" data-id="{{item.fromOpenid || item.openid}}" class="btn btn-ghost mini">拒绝</button>
        </view>
      </view>
      <view wx:if="{{loading && !incoming.length}}" class="list-status">加载中…</view>
    </view>

    <!-- 我的岩友：整行进名片，删除收进行内「更多」 -->
    <view wx:if="{{listTab==='accepted'}}" class="friend-list">
      <view wx:if="{{!loading && !accepted.length}}" class="empty-state friend-empty">
        <view class="empty-state__title">还没有岩友</view>
        <button class="btn-text" bindtap="goHome">去找搭子</button>
      </view>
      <view wx:for="{{accepted}}" wx:key="id" class="friend-card" data-id="{{item.openid || item._openid}}" bindtap="onViewCard">
        <image class="friend-card__avatar" src="{{item.avatarUrl || defaultAvatar}}" mode="aspectFill"></image>
        <view class="friend-card__main">
          <view class="friend-card__name">{{item.nickName || '岩友'}}</view>
          <view wx:if="{{item.skillText}}" class="friend-card__sub">{{item.skillText}}</view>
        </view>
        <view class="friend-card__op">
          <view class="icon-btn icon-btn--sm" catchtap="onMore" data-id="{{item.openid || item._openid}}">⋯</view>
        </view>
      </view>
      <view wx:if="{{loading && !accepted.length}}" class="list-status">加载中…</view>
    </view>

    <!-- 已发申请 -->
    <view wx:if="{{listTab==='outgoing'}}" class="friend-list">
      <view wx:if="{{!loading && !outgoing.length}}" class="empty-state friend-empty">
        <view class="empty-state__title">暂无已发出的申请</view>
      </view>
      <view wx:for="{{outgoing}}" wx:key="id" class="friend-card" data-id="{{item.openid || item._openid}}" bindtap="onViewCard">
        <image class="friend-card__avatar" src="{{item.avatarUrl || defaultAvatar}}" mode="aspectFill"></image>
        <view class="friend-card__main">
          <view class="friend-card__name">{{item.nickName || '岩友'}}</view>
          <view wx:if="{{item.skillText}}" class="friend-card__sub">{{item.skillText}}</view>
        </view>
        <view class="friend-card__op">
          <text class="friend-card__state">待确认</text>
        </view>
      </view>
      <view wx:if="{{loading && !outgoing.length}}" class="list-status">加载中…</view>
    </view>
  </block>
</view>
