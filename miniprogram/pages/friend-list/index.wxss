/* 岩友页（compact）：搜索 → 分段 → 人物行；人物行规格对齐 person-row */
page {
  background: #151714;
}

.friend-page {
  padding: 12rpx 32rpx 48rpx;
}

/* 搜索条：清除图标热区 */
.friend-search {
  position: relative;
}

.friend-search .searchbar__input {
  min-height: 88rpx;
  line-height: 88rpx;
}

.friend-search__clear {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin-right: -8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #B9BDB0;
}

.friend-search__clear:active {
  color: #F3F1E7;
}

.friend-tabs {
  margin-top: 20rpx;
}

/* 人物行：细分隔，不套卡片；长昵称自然换行，操作区不足时另起一行 */
.friend-list {
  margin-top: 8rpx;
}

.friend-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #383E34;
  flex-wrap: wrap;
}

.friend-card:active {
  opacity: 0.85;
}

.friend-card__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #2B3029;
  flex-shrink: 0;
}

.friend-card__main {
  flex: 1 1 220rpx;
  min-width: 0;
}

.friend-card__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #F3F1E7;
  line-height: 1.45;
  overflow-wrap: break-word;
}

.friend-card__sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #969D90;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friend-card__op {
  flex: 0 0 auto;
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.friend-card__op--btns .btn {
  flex-shrink: 0;
}

.friend-card__op--btns .btn::after {
  border: none;
}

.friend-card__state {
  font-size: 24rpx;
  color: #969D90;
  white-space: nowrap;
}

.friend-empty {
  padding-top: 96rpx;
}
