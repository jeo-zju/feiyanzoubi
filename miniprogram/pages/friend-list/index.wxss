/* 岩友列表页：搜索条/按钮/标签/卡片均使用全局体系，本文件只保留列表行布局 */
.page--fl {
  padding-bottom: 80rpx;
}

.friend-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
}

.friend-row__avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(143, 123, 255, 0.24);
  flex-shrink: 0;
}

.friend-row__main {
  flex: 1;
  min-width: 0;
}

.friend-row__name {
  font-size: 28rpx;
  font-weight: 700;
  color: #e7e9f3;
}

.friend-row__meta {
  margin-top: 4rpx;
  font-size: 24rpx;
}

.friend-row__tags {
  margin-top: 8rpx;
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.friend-row__op {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}
