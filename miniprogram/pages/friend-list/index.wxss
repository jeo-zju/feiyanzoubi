.page--fl { padding-bottom: 80rpx; }
.mt-sm { margin-top: 16rpx; }
.muted { color: rgba(231,233,243,0.6); }
.ph { color: rgba(231,233,243,0.42); }

.search-shell {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 80rpx;
  padding: 0 14rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.08);
}
.search-shell__ic { font-size: 30rpx; }
.search-shell__input {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  color: #e7e9f3;
  font-size: 26rpx;
}
.search-shell__op {
  font-size: 22rpx;
  color: rgba(231,233,243,0.5);
  padding: 0 10rpx;
}
.search-shell__btn {
  height: 58rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  gap: 4rpx;
}

.search-state {
  padding: 40rpx 0;
  text-align: center;
  font-size: 22rpx;
}
.empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 22rpx;
}

.friend-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 18rpx;
  margin-top: 10rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.06);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.friend-row:active {
  transform: translateY(1rpx);
  box-shadow: inset 0 0 0 1rpx rgba(143,123,255,0.18);
}
.friend-row__avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
  border: 2rpx solid rgba(143,123,255,0.24);
  flex-shrink: 0;
}
.friend-row__main {
  flex: 1;
  min-width: 0;
}
.friend-row__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #E7E9F3;
  letter-spacing: 0.5rpx;
}
.friend-row__meta {
  margin-top: 4rpx;
  font-size: 20rpx;
}
.friend-row__tags {
  margin-top: 8rpx;
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}
.mini-tag {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #e7e9f3;
  background: rgba(143,123,255,0.16);
  border: 1rpx solid rgba(143,123,255,0.24);
}
.friend-row__op {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.btn-xs {
  height: 52rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  gap: 4rpx;
}
.btn-warn {
  background: rgba(242,193,78,0.12);
  color: #E6C76A;
  border: 1rpx solid rgba(242,193,78,0.3);
}
.btn-danger {
  background: rgba(242,139,148,0.1);
  color: #F28B94;
  border: 1rpx solid rgba(242,139,148,0.24);
}
