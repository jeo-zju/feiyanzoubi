.viewport-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.viewport-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 18rpx;
}

.mt {
  margin-top: 18rpx;
}

.mb {
  margin-bottom: 14rpx;
}

.mt2 {
  margin-top: 14rpx;
}

.flex {
  flex: 1;
}

.rows {
  margin-top: 18rpx;
}

.route-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.route-row:first-child {
  border-top: none;
}

.route-grade {
  font-weight: 800;
}

.route-input {
  width: 180rpx;
  text-align: center;
}

.add-btn {
  width: 170rpx;
  height: 76rpx;
}

.tpl-btn {
  width: 128rpx;
  height: 76rpx;
}

.date-picker {
  display: flex;
  align-items: center;
}

.hist-title {
  margin-top: 14rpx;
  margin-bottom: 10rpx;
  font-weight: 800;
}

.hist-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.hist-item:first-child {
  border-top: none;
}

.hist-name {
  font-weight: 800;
}

.hist-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.field-tip {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.hist-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mini-btn {
  padding: 10rpx 14rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: rgba(231, 233, 243, 0.85);
}

.ph {
  color: rgba(231, 233, 243, 0.4);
}

