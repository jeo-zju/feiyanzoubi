/* 页面特有布局：视口滚动结构、周期/线路列表、合并历史卡片 */
.viewport-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.viewport-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 18rpx;
}

.rows {
  margin-top: 18rpx;
}

.route-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.route-row:first-child {
  border-top: none;
}

.route-grade {
  font-weight: 800;
}

.route-input {
  width: 180rpx;
  text-align: center;
}

.hist-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.hist-item:first-child {
  border-top: none;
}

.hist-name {
  font-weight: 800;
}

.hist-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.hist-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.danger-zone {
  margin-top: 10rpx;
}

.merge-history {
  margin-top: 8rpx;
  margin-bottom: 18rpx;
}

.merge-item {
  margin-top: 10rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.merge-name {
  font-weight: 800;
}
