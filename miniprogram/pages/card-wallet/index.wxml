<view class="page viewport-page">
  <view class="card card-hero">
    <view class="card-bd">
      <view class="section-title-lg">名片夹</view>
      <view class="stat-grid mt2">
        <view class="panel stat-card">
          <view class="stat-number stat-number-warn">{{receivedCount}}</view>
          <view class="stat-label">收到的</view>
        </view>
        <view class="panel stat-card">
          <view class="stat-number stat-number-purple">{{sentCount}}</view>
          <view class="stat-label">送出的</view>
        </view>
        <view class="panel stat-card">
          <view class="stat-number">{{credit.remaining}}</view>
          <view class="stat-label">今日灵感 {{credit.limit}} / 日</view>
        </view>
      </view>

      <view class="wallet-tabs mt2">
        <view
          class="wallet-tab {{activeTab==='received' ? 'wallet-tab--active' : ''}}"
          data-tab="received"
          bindtap="onSwitchTab"
        >
          收到的
        </view>
        <view
          class="wallet-tab {{activeTab==='sent' ? 'wallet-tab--active' : ''}}"
          data-tab="sent"
          bindtap="onSwitchTab"
        >
          送出的
        </view>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="viewport-scroll list-scroll">
    <view class="card">
      <view class="card-bd list list-bd" wx:if="{{activeTab==='received'}}">
        <view wx:if="{{!receivedCards.length}}" class="empty-state">还没有收到名片</view>
        <view wx:for="{{receivedCards}}" wx:key="cardId" class="list-row card-item">
          <view class="item-left">
            <image
              class="avatar"
              mode="aspectFill"
              src="{{(item.avatarMode==='custom'?item.avatarFileId:item.avatarUrl) || defaultAvatar}}"
            ></image>
          </view>
          <view class="item-mid">
            <view class="name">{{item.displayName}}</view>
            <view class="meta">
              <view class="tag tag-purple">{{item.title}}</view>
              <view wx:if="{{item.mbti}}" class="tag tag-warn ml">{{item.mbti}}</view>
            </view>
            <view class="one muted">{{item.oneLiner}}</view>
            <view class="row action-row">
              <view class="btn btn-ghost flex" data-id="{{item.cardId}}" bindtap="onSave">保存图片</view>
              <view class="btn btn-ghost flex ml" data-id="{{item.cardId}}" bindtap="onSetPrimary">设主卡</view>
              <view class="btn btn-ghost flex ml" data-id="{{item.cardId}}" bindtap="onRemove">删除</view>
            </view>
          </view>
        </view>
      </view>
      <view class="card-bd list list-bd" wx:else>
        <view wx:if="{{!sentCards.length}}" class="empty-state">还没有送出记录</view>
        <view wx:for="{{sentCards}}" wx:key="cardId" class="list-row card-item">
          <view class="item-left">
            <image
              class="avatar"
              mode="aspectFill"
              src="{{(item.avatarMode==='custom'?item.avatarFileId:item.avatarUrl) || defaultAvatar}}"
            ></image>
          </view>
          <view class="item-mid">
            <view class="name">{{item.displayName}}</view>
            <view class="meta">
              <view class="tag tag-purple">{{item.title}}</view>
              <view wx:if="{{item.mbti}}" class="tag tag-warn ml">{{item.mbti}}</view>
            </view>
            <view class="one muted">{{item.oneLiner}}</view>
            <view class="row action-row">
              <view class="btn btn-ghost flex" data-id="{{item.cardId}}" bindtap="onSave">保存图片</view>
              <view class="sent-tip ml">已送出</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <canvas
    class="wallet-canvas"
    canvas-id="walletCardCanvas"
    width="{{canvasW}}"
    height="{{canvasH}}"
    style="width: {{canvasCssW}}px; height: {{canvasCssH}}px;"
  ></canvas>
</view>
