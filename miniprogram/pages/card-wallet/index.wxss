.viewport-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.viewport-scroll {
  flex: 1;
  min-height: 0;
}

.row {
  display: flex;
  align-items: center;
}

.flex {
  flex: 1;
}

.ml {
  margin-left: 16rpx;
}

.mt2 {
  margin-top: 24rpx;
}

.list-scroll {
  margin-top: 18rpx;
}

.list-bd {
  padding-bottom: 12rpx;
}

.wallet-tabs {
  display: flex;
  gap: 12rpx;
}

.wallet-tab {
  min-width: 0;
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(231, 233, 243, 0.70);
}

.wallet-tab--active {
  color: #0B0D15;
  background: linear-gradient(135deg, rgba(242, 193, 78, 0.98), rgba(250, 215, 110, 0.92));
  border-color: rgba(242, 193, 78, 0.30);
}

.card-item {
  display: flex;
  gap: 16rpx;
}

.item-left {
  width: 104rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
}

.item-mid {
  flex: 1;
}

.name {
  font-weight: 900;
  font-size: 30rpx;
}

.meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.tag-purple {
  background: rgba(143, 123, 255, 0.22);
  border: 1rpx solid rgba(143, 123, 255, 0.35);
  color: rgba(255, 255, 255, 0.92);
}

.stat-number-purple {
  color: rgba(173, 159, 255, 0.98);
}

.one {
  margin-top: 10rpx;
}

.action-row {
  margin-top: 18rpx;
  flex-wrap: wrap;
}

.sent-tip {
  height: 64rpx;
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(231, 233, 243, 0.54);
}

.wallet-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}
