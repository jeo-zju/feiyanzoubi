.row {
  display: flex;
  align-items: center;
}

.flex {
  flex: 1;
}

.ml {
  margin-left: 16rpx;
}

.mt2 {
  margin-top: 24rpx;
}

.stat-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 900;
  color: #F2C14E;
}

.stat-credit {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(143, 123, 255, 0.95);
}

.empty {
  padding: 16rpx 0;
}

.card-item {
  display: flex;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.item-left {
  width: 104rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
}

.item-mid {
  flex: 1;
}

.name {
  font-weight: 900;
  font-size: 30rpx;
}

.meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.tag-purple {
  background: rgba(143, 123, 255, 0.22);
  border: 1rpx solid rgba(143, 123, 255, 0.35);
  color: rgba(255, 255, 255, 0.92);
}

.one {
  margin-top: 10rpx;
}
