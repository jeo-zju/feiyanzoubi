/* 岩友圈列表（compact）：原生页名 + 一处创建 → 圈行；申请统一进详情 */
page {
  background: #151714;
}

.cl-page {
  padding: 12rpx 32rpx 48rpx;
}

.cl-topbar {
  display: flex;
  justify-content: flex-end;
  min-height: 80rpx;
}

.cl-empty {
  padding-top: 96rpx;
}

/* 圈行：圈标色仅作用于小圆点 */
.cl-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 0;
  border-top: 1rpx solid #383E34;
}

.cl-row:active {
  opacity: 0.85;
}

.cl-row__dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.cl-row__main {
  flex: 1;
  min-width: 0;
}

.cl-row__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #F3F1E7;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cl-row__meta {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #969D90;
  line-height: 1.5;
}

.cl-row__desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #969D90;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  overflow-wrap: break-word;
}

.cl-row__tail {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cl-state {
  font-size: 24rpx;
  color: #969D90;
  white-space: nowrap;
}

.cl-state--on {
  color: #D2EF72;
}

.cl-state--pending {
  color: #E8C58C;
}

.cl-row__arrow {
  font-size: 32rpx;
  color: #969D90;
  line-height: 1;
}
