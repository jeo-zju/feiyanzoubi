<view class="page ui-v2 cl-page">
  <!-- 唯一创建操作：有列表时位于页头；空态时收进空态槽，不重复出现 -->
  <view wx:if="{{list.length || loading}}" class="cl-topbar">
    <view class="icon-btn icon-btn--sm" bindtap="onCreate">＋</view>
  </view>

  <view wx:if="{{loading && !list.length}}" class="list-status">加载中…</view>
  <view wx:elif="{{!list.length}}" class="empty-state cl-empty">
    <block wx:if="{{mode==='mine'}}">
      <view class="empty-state__title">还没有加入岩友圈</view>
      <button class="btn-text" bindtap="onCreate">创建岩友圈</button>
    </block>
    <view wx:else class="empty-state__title">暂无可加入的岩友圈</view>
  </view>

  <view wx:else class="cl-list">
    <view class="cl-row" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="onTapCard">
      <view class="cl-row__dot" style="background:{{item.avatarColor || '#8A8F80'}};"></view>
      <view class="cl-row__main">
        <view class="cl-row__name">{{item.name}}</view>
        <view class="cl-row__meta">{{item.memberCount || 0}} 人<text wx:if="{{item.city}}"> · {{item.city}}</text></view>
        <view wx:if="{{item.description}}" class="cl-row__desc">{{item.description}}</view>
      </view>
      <view class="cl-row__tail">
        <text wx:if="{{membershipMap[item._id] && membershipMap[item._id].status==='accepted'}}" class="cl-state cl-state--on">已加入</text>
        <text wx:elif="{{membershipMap[item._id] && membershipMap[item._id].status==='pending'}}" class="cl-state cl-state--pending">申请中</text>
        <text wx:else class="cl-state">未加入</text>
        <text class="cl-row__arrow">›</text>
      </view>
    </view>
  </view>
</view>
