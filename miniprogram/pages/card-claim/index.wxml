<view class="page">
  <view class="card hero">
    <view class="card-bd">
      <view class="hero-title">有人把名片塞给你了</view>
      <view class="muted hero-sub">领了就是你的：可设为主卡，也可保存成图片</view>
    </view>
  </view>

  <view class="card mt">
    <view class="card-hd">名片预览</view>
    <view class="card-bd">
      <view wx:if="{{card}}" class="preview">
        <view class="name">{{card.front.displayName}}</view>
        <view class="meta">
          <view class="tag tag-purple">{{card.front.title}}</view>
          <view wx:if="{{card.front.mbti}}" class="tag tag-warn ml">{{card.front.mbti}}</view>
        </view>
        <view class="one">{{card.front.oneLiner}}</view>
      </view>
      <view wx:else class="muted">加载中…</view>
    </view>
  </view>

  <view class="btn btn-primary mt2" bindtap="onClaim">领取并保存</view>
</view>
