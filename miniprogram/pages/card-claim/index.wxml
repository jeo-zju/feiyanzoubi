<view class="page page--claim">
  <view class="card card-hero">
    <view class="card-bd">
      <view class="section-title-lg">有人把名片塞给你了</view>
      <view class="section-desc">领了就是你的：可设为主卡，也可保存成图片</view>
    </view>
  </view>

  <view class="card mt">
    <view class="card-hd">名片预览</view>
    <view class="card-bd">
      <view wx:if="{{card}}" class="panel">
        <view class="page-title">{{card.front.displayName}}</view>
        <view class="meta">
          <view class="tag">{{card.front.title}}</view>
          <view wx:if="{{card.front.mbti}}" class="tag tag-warn ml">{{card.front.mbti}}</view>
        </view>
        <view class="one">{{card.front.oneLiner}}</view>
      </view>
      <view wx:else class="empty-state">
        <view class="empty-state__desc">加载中…</view>
      </view>
    </view>
  </view>

  <view class="action-bar">
    <view class="action-bar__row">
      <view class="btn btn-primary" bindtap="onClaim">领取并保存</view>
    </view>
  </view>
</view>
