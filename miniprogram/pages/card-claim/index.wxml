<view class="page ui-v2 cc-page">
  <block wx:if="{{card}}">
    <!-- 名片完整预览：等比显示，不裁卡面 -->
    <view class="cc-stage">
      <canvas
        canvas-id="cardCanvas"
        class="cc-canvas"
        style="width: {{canvasCssW}}px; height: {{canvasCssH}}px;"
        width="{{canvasW}}"
        height="{{canvasH}}"
      ></canvas>
    </view>

    <!-- 简短状态说明 -->
    <view class="cc-status">{{statusText}}</view>

    <view class="action-bar cc-actions">
      <!-- 待领取：领取动作同时把名片收入名片夹（沿用原行为） -->
      <button wx:if="{{stage==='pending'}}" class="btn btn-primary" loading="{{claiming}}" disabled="{{claiming}}" bindtap="onClaim">领取并保存</button>
      <!-- 领取成功：同一操作槽变为查看 -->
      <button wx:elif="{{stage==='claimed'}}" class="btn btn-primary" bindtap="onViewCard">查看名片</button>
      <!-- 已被领取 / 已取消：不可再领 -->
      <block wx:else>
        <button class="btn btn-ghost" bindtap="goMe">去我的名片夹</button>
        <button class="btn" disabled>{{closedText}}</button>
      </block>
    </view>
  </block>

  <view wx:elif="{{loadError}}" class="empty-state">
    <view class="empty-state__desc">{{loadErrorText || '名片加载失败'}}</view>
    <button class="btn btn-ghost" bindtap="onRetry">重试</button>
  </view>
  <view wx:else class="list-status">加载中…</view>
</view>
