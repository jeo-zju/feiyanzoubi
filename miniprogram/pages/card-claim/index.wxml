<view class="page">
  <view class="card card-hero">
    <view class="card-bd">
      <view class="section-title-lg">有人送你一张名片</view>
      <view class="section-desc">领下之后，就会收进你的名片夹。</view>
    </view>
  </view>

  <view class="card mt">
    <view class="card-hd">名片预览</view>
    <view class="card-bd">
      <view wx:if="{{card}}" class="preview">
        <view class="name">{{card.front.displayName}}</view>
        <view class="meta">
          <view class="tag tag-purple">{{card.front.title}}</view>
          <view wx:if="{{card.front.mbti}}" class="tag tag-warn ml">{{card.front.mbti}}</view>
        </view>
        <view class="one">{{card.front.oneLiner}}</view>
      </view>
      <view wx:else class="empty-state">加载中…</view>
    </view>
  </view>

  <view class="btn btn-primary mt2" bindtap="onClaim">领取名片</view>
</view>
