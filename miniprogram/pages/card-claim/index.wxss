/* 领取名片（compact）：等比名片预览 → 状态 → 唯一领取操作槽 */
page {
  background: #151714;
}

.cc-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.cc-stage {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 32rpx 12rpx;
}

.cc-canvas {
  border-radius: 18rpx;
  background: #0B0D15;
  border: 1rpx solid #383E34;
  max-width: 100%;
}

.cc-status {
  padding: 12rpx 48rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.6;
  color: #B9BDB0;
}

.cc-actions {
  display: flex;
  gap: 20rpx;
}

.cc-actions .btn {
  flex: 1;
  min-width: 0;
}

.cc-actions .btn[disabled] {
  flex: 1.2;
  color: #969D90;
}
