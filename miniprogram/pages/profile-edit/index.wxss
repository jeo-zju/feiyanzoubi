/* 编辑资料页：输入框/选择器/按钮均使用全局 .input/.field-select/.btn 体系，本文件只保留表单布局 */

.inline-row {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}

.inline-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.inline-label {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(231, 233, 243, 0.68);
  padding-left: 4rpx;
}

.head-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  flex: none;
}

.compact-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(143, 123, 255, 0.28);
}

.head-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}

.save-btn {
  width: 100%;
}

.slogan-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.slogan-input {
  flex: 1;
  min-width: 0;
}

.contact-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.contact-row .input {
  flex: 1;
  min-width: 0;
}

.contact-switch {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.contact-switch__label {
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.5);
}
