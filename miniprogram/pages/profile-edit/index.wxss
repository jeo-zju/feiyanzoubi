.mt {
  margin-top: 18rpx;
}

.hero {
  background: linear-gradient(135deg, rgba(143, 123, 255, 0.18), rgba(242, 193, 78, 0.12));
  border-color: rgba(242, 193, 78, 0.14);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #f2c14e;
  font-size: 22rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 38rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #fff;
}

.hero-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(231, 233, 243, 0.74);
}

.section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
}

.section-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(231, 233, 243, 0.6);
}

.avatar-picker {
  margin-top: 18rpx;
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
}

.avatar-image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  flex: none;
}

.avatar-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  text-align: left;
}

.avatar-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
}

.avatar-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(231, 233, 243, 0.62);
}

.nickname-input {
  margin-top: 18rpx;
}

.placeholder {
  color: rgba(231, 233, 243, 0.34);
}

.save-note {
  font-size: 22rpx;
  text-align: center;
  color: rgba(231, 233, 243, 0.54);
}

.save-row {
  display: flex;
  align-items: center;
}

.save-btn {
  flex: 1;
}

.save-btn--disabled {
  opacity: 0.48;
}
