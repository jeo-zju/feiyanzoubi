<view class="page">
  <view class="hero card">
    <view class="card-bd">
      <view class="hero-badge">资料</view>
      <view class="hero-title">同步你的昵称和头像</view>
      <view class="hero-desc">使用微信当前推荐的资料填写能力，保存后会同步到“我的”、名片默认信息和评论展示。</view>
    </view>
  </view>

  <view class="card mt">
    <view class="card-bd">
      <view class="section-title">头像</view>
      <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar-image" mode="aspectFill" src="{{avatarUrl || defaultAvatar}}"></image>
        <view class="avatar-copy">
          <view class="avatar-title">点击更换头像</view>
          <view class="avatar-sub">选择后会上传到云存储，避免只在当前设备生效</view>
        </view>
      </button>
    </view>
  </view>

  <view class="card mt">
    <view class="card-bd">
      <view class="section-title">昵称</view>
      <input
        class="input nickname-input"
        type="nickname"
        maxlength="20"
        placeholder="请输入昵称"
        placeholder-class="placeholder"
        value="{{nickName}}"
        bindinput="onNicknameInput"
      />
      <view class="section-tip">建议使用你平时在岩馆里会被叫到的名字。</view>
    </view>
  </view>

  <view class="save-note mt">没有改动时，直接返回即可。</view>

  <view class="save-row mt">
    <view class="btn btn-primary save-btn {{!canSave || saving ? 'save-btn--disabled' : ''}}" bindtap="onSave">
      {{saving ? "保存中..." : "保存资料"}}
    </view>
  </view>
</view>
