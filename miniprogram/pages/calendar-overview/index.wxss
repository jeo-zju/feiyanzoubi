/* 岩馆日历（compact）：日期范围 → 筛选 → 等宽七周日历主体，自然滚动不裁最后一周 */
page {
  background: #151714;
}

.co-page {
  padding: 24rpx 32rpx 48rpx;
}

.co-card {
  padding: 28rpx 24rpx 32rpx;
}

.co-title {
  padding: 0 4rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #F3F1E7;
}

.co-filters {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.co-filter {
  flex: 1;
  min-width: 0;
}

.co-circle-filter {
  margin-top: 16rpx;
}

.co-tabs {
  margin-top: 20rpx;
}

/* 七列等宽 */
.co-weekrow {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  margin-top: 24rpx;
}

.co-weeklabel {
  text-align: center;
  font-size: 22rpx;
  color: #969D90;
}

.co-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 8rpx;
}

.co-cell {
  min-height: 96rpx;
  border-radius: 14rpx;
  border: 1rpx solid transparent;
  background: #20241F;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.co-cell:active {
  border-color: rgba(210, 239, 114, 0.5);
}

.co-cell__md {
  font-size: 28rpx;
  color: #F3F1E7;
  line-height: 1.2;
}

.co-cell__n {
  font-size: 20rpx;
  color: #969D90;
  line-height: 1.2;
}

/* 今天：描边亮色 */
.co-cell.is-today {
  border-color: #D2EF72;
}

.co-cell.is-today .co-cell__md {
  color: #D2EF72;
  font-weight: 700;
}

/* 选中：填充（与今天可叠加） */
.co-cell.is-selected {
  background: rgba(210, 239, 114, 0.18);
}

/* 有活动：场次文字用成功色，不靠深浅辨认 */
.co-cell.has-plan .co-cell__n {
  color: #B0D9A6;
  font-weight: 600;
}

/* 圈筛选弹层小圆点 */
.co-picker-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}
