<view class="page">
  <view class="card">
    <view class="card-hd">日志概览</view>
    <view class="card-bd">
      <view class="stat-grid">
        <view class="panel stat-card">
          <view class="stat-number stat-number-warn">{{total}}</view>
          <view class="stat-label">总条数</view>
        </view>
        <view class="panel stat-card">
          <view class="stat-number stat-number--danger">{{errorCount}}</view>
          <view class="stat-label">错误</view>
        </view>
        <view class="panel stat-card">
          <view class="stat-number">{{cloudCount}}</view>
          <view class="stat-label">云调用</view>
        </view>
      </view>
      <view class="row mt">
        <view class="btn btn-ghost mini flex" bindtap="onRefresh">刷新</view>
        <view class="btn btn-ghost mini flex ml" bindtap="onCopyAll">复制全部</view>
        <view class="btn btn-warn mini flex ml" bindtap="onClear">清空</view>
      </view>
    </view>
  </view>

  <view wx:if="{{logs.length}}" class="list">
    <view wx:for="{{logs}}" wx:key="id" class="card mt">
      <view class="card-bd">
        <view class="row top-row">
          <view class="tag-row">
            <view class="tag {{item.type==='error' ? 'tag--danger' : item.type==='success' ? '' : 'tag--off'}}">{{item.typeText}}</view>
            <view class="tag tag--off ml">{{item.category}}</view>
          </view>
          <view class="hint">{{item.timeText}}</view>
        </view>
        <view class="section-title mt-sm">{{item.title}}</view>
        <view wx:if="{{item.summary}}" class="summary mt-sm">{{item.summary}}</view>
        <view wx:if="{{item.traceId || item.code || item.durationText || item.page}}" class="meta mt-sm">
          <text wx:if="{{item.traceId}}">traceId: {{item.traceId}}</text>
          <text wx:if="{{item.code}}">code: {{item.code}}</text>
          <text wx:if="{{item.durationText}}">duration: {{item.durationText}}</text>
          <text wx:if="{{item.page}}">page: {{item.page}}</text>
        </view>
        <view wx:if="{{item.detail}}" class="panel detail mt-sm">{{item.detail}}</view>
        <view class="row mt-sm">
          <view class="btn btn-ghost mini" bindtap="onCopyItem" data-id="{{item.id}}">复制本条</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="card mt">
    <view class="card-bd">
      <view class="empty-state">
        <view class="empty-state__title">还没有调试日志</view>
        <view class="empty-state__desc">先去操作一下功能再回来查看。</view>
      </view>
    </view>
  </view>
</view>
