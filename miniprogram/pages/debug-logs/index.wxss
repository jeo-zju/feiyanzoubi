/* 页面特有布局；元素样式统一由全局 app.wxss 提供 */

.top-row {
  align-items: flex-start;
}

.tag-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.summary {
  color: rgba(231, 233, 243, 0.82);
  white-space: pre-wrap;
  word-break: break-all;
}

.meta {
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.62);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.detail {
  white-space: pre-wrap;
  word-break: break-all;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(231, 233, 243, 0.82);
}

/* 错误数字/标签：在全局体系基础上追加危险红 */
.stat-number--danger {
  color: #f28b94;
}

.tag--danger {
  background: rgba(242, 139, 148, 0.1);
  border-color: rgba(242, 139, 148, 0.28);
  color: #f28b94;
}
