/* circle-detail：仅页面特有布局，元素样式全部来自 app.wxss 全局 */

.page--circle-detail {
  padding-bottom: 200rpx;
}

/* scroll-view 作为弹层主体时，高度约束交给 scroll-view 自身滚动 */
.page--circle-detail .sheet__bd {
  overflow: hidden;
  min-height: 0;
}

/* 顶部圈子信息面板 */
.hero {
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid #2b3044;
  padding: 28rpx 24rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}
.hero__color {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 8rpx rgba(255, 255, 255, 0.04);
  flex-shrink: 0;
}
.hero__title {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.hero__desc {
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.62);
  line-height: 1.5;
  text-align: center;
  max-width: 100%;
  min-height: 36rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.hero__meta {
  margin-top: 8rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}
.hero__meta-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.hero__meta-num {
  font-size: 32rpx;
  font-weight: 800;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 100%;
}
.hero__meta-label {
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.42);
}
.hero__meta-split {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.08);
  flex-shrink: 0;
}
.hero__gyms {
  width: 100%;
  margin-top: 6rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 10rpx 14rpx;
}

/* 底部操作栏里的“已在圈内”状态 */
.foot-status {
  width: 100%;
  display: flex;
  justify-content: center;
}

/* 成员列表 */
.list--tight { gap: 2rpx; }
.member-row:active { background: rgba(255, 255, 255, 0.04); border-radius: 16rpx; }
.pending-row {
  background: rgba(242, 193, 78, 0.04);
  border-radius: 16rpx;
}
.pending-divider {
  padding: 20rpx 28rpx 8rpx;
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.45);
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
  margin-top: 8rpx;
}
.avatar-s {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.08);
}
.row-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-left: 18rpx;
}
.row-title {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.row-sub {
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
