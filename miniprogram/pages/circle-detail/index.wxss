.page--circle-detail {
  min-height: 100vh;
  background: #0B0D15;
  color: #E7E9F3;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  flex-shrink: 0;
}
.topbar__back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #E7E9F3;
  line-height: 1;
}
.topbar__back:active { background: rgba(143, 123, 255, 0.16); }
.topbar__title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #E7E9F3;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.topbar__gear {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #E7E9F3;
  line-height: 1;
}
.topbar__gear:active { background: rgba(143, 123, 255, 0.16); }

.hero {
  flex-shrink: 0;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  padding: 28rpx 24rpx 22rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}
.hero__color {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 8rpx rgba(255, 255, 255, 0.04);
  flex-shrink: 0;
}
.hero__title {
  font-size: 40rpx;
  font-weight: 600;
  color: #E7E9F3;
  line-height: 1.2;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.hero__desc {
  font-size: 26rpx;
  color: rgba(231, 233, 243, 0.62);
  line-height: 1.5;
  text-align: center;
  max-width: 100%;
  min-height: 40rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.hero__meta {
  margin-top: 8rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}
.hero__meta-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.hero__meta-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #E7E9F3;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 100%;
}
.hero__meta-label {
  font-size: 22rpx;
  color: rgba(231, 233, 243, 0.42);
  font-weight: 500;
}
.hero__meta-split {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.08);
  flex-shrink: 0;
}

.rounds {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  padding: 10rpx 0;
}
.round-btn {
  width: 168rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  position: relative;
}
.round-btn__ic {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  line-height: 1;
}
.round-btn:active .round-btn__ic { background: rgba(143, 123, 255, 0.12); border-color: rgba(143, 123, 255, 0.3); }
.round-btn__badge {
  position: absolute;
  top: -4rpx;
  right: 4rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: #C65A5A;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-sizing: border-box;
}
.round-btn__label {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(231, 233, 243, 0.86);
  line-height: 1;
}

.foot {
  flex-shrink: 0;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-apply {
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  background: #F2C14E;
  color: #1a1408;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
}
.btn-apply:active { opacity: 0.86; }
.tag-in {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(143, 123, 255, 0.92);
  letter-spacing: 2rpx;
  padding: 20rpx 36rpx;
  border-radius: 30rpx;
  background: rgba(143, 123, 255, 0.12);
  border: 1rpx solid rgba(143, 123, 255, 0.28);
}

/* sheet 复用样式（复制自 circle-edit） */
.sheet-mask {
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.56);
  z-index: 900;
  display: flex; align-items: flex-end; justify-content: center;
}
.sheet {
  width: 100%;
  max-height: 68vh;
  background: #121420;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex; flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}
.sheet--sm { max-height: 48vh; }
.sheet__hd {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 28rpx 18rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
}
.sheet__title { font-size: 30rpx; font-weight: 600; color: #e7e9f3; }
.sheet__close {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  display: flex; align-items: center; justify-content: center;
  color: rgba(231, 233, 243, 0.72); font-size: 26rpx;
}
.sheet__bd {
  flex: 1; overflow-y: auto;
  padding: 12rpx 0 20rpx;
  box-sizing: border-box;
}
.sheet-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 26rpx 28rpx; min-height: 84rpx;
  box-sizing: border-box;
}
.sheet-item:active { background: rgba(143, 123, 255, 0.08); }
.sheet-item--row { gap: 18rpx; }
.sheet-item__avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  flex-shrink: 0;
  background: rgba(255,255,255,0.06);
}
.sheet-item__ic {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: rgba(143, 123, 255, 0.14);
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; line-height: 1;
  flex-shrink: 0;
}
.sheet-item__info {
  flex: 1; min-width: 0;
  display: flex; flex-direction: column; gap: 6rpx;
}
.sheet-item__name {
  font-size: 28rpx; font-weight: 600; color: #e7e9f3;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.sheet-item__sub {
  font-size: 22rpx; color: rgba(231, 233, 243, 0.46);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.sheet-item__label {
  flex: 1; font-size: 28rpx; font-weight: 600; color: #e7e9f3;
  line-height: 1.3;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.sheet-item__arrow { color: rgba(231,233,243,0.42); font-size: 30rpx; margin-left: 12rpx; flex-shrink: 0; }
.sheet-item__btn {
  height: 52rpx; padding: 0 20rpx; border-radius: 26rpx;
  font-size: 22rpx; font-weight: 600;
  display: inline-flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.sheet-item__btn--danger {
  background: rgba(198, 90, 90, 0.14);
  color: rgba(255, 200, 200, 0.96);
  border: 1rpx solid rgba(198, 90, 90, 0.3);
}
.sheet-item__btn--danger:active { background: rgba(198, 90, 90, 0.28); }
.sheet-item--danger:active { background: rgba(198, 90, 90, 0.1); }
.sheet-item--danger .sheet-item__label { color: rgba(255, 200, 200, 0.96); }

.sheet-item__actions {
  display: flex; align-items: center; gap: 14rpx;
  flex-shrink: 0;
}
.ic-btn {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700; line-height: 1;
}
.ic-btn--ok {
  background: rgba(92, 184, 120, 0.16);
  border: 1rpx solid rgba(92, 184, 120, 0.4);
  color: #7CC89A;
}
.ic-btn--ok:active { background: rgba(92, 184, 120, 0.3); }
.ic-btn--no {
  background: rgba(198, 90, 90, 0.14);
  border: 1rpx solid rgba(198, 90, 90, 0.3);
  color: rgba(255, 200, 200, 0.96);
}
.ic-btn--no:active { background: rgba(198, 90, 90, 0.28); }

.sheet-divider { height: 1rpx; background: rgba(255, 255, 255, 0.06); margin: 8rpx 28rpx; }
.sheet-empty {
  padding: 60rpx 28rpx; text-align: center; font-size: 26rpx;
  color: rgba(231, 233, 243, 0.46); font-weight: 500;
}
.sheet-link-add {
  margin: 20rpx 28rpx 8rpx;
  height: 84rpx;
  border-radius: 18rpx;
  border: 1rpx dashed rgba(143, 123, 255, 0.38);
  background: rgba(143, 123, 255, 0.06);
  color: rgba(143, 123, 255, 0.96);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 1rpx;
}
.sheet-link-add:active { background: rgba(143, 123, 255, 0.14); }

.check-box {
  width: 40rpx; height: 40rpx; border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  display: flex; align-items: center; justify-content: center;
}
.check-box--on { background: rgba(242, 193, 78, 0.22); border-color: rgba(242, 193, 78, 0.6); }
.check-box__t { color: #F2C14E; font-size: 26rpx; font-weight: 700; }

/* #22: 扁平化样式 */
.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.card-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 0;
}
.card-hd__t {
  font-size: 28rpx;
  font-weight: 700;
  color: #E7E9F3;
}
.card-hd__badge {
  font-size: 22rpx;
  color: #F2C14E;
  background: rgba(242, 193, 78, 0.12);
  border: 1rpx solid rgba(242, 193, 78, 0.3);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.pending-divider {
  padding: 20rpx 28rpx 8rpx;
  font-size: 22rpx;
  color: rgba(231, 233, 243, 0.45);
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
  margin-top: 8rpx;
}
.pending-row {
  background: rgba(242, 193, 78, 0.04);
}
.btn-ghost {
  font-size: 22rpx;
  color: rgba(231, 233, 243, 0.6);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

/* #25: 成员行展示类（#22 扁平化后 wxml 引用但缺失，一并补齐）+ 成员名片弹窗 */
.list--tight { gap: 2rpx; }
.member-row { cursor: pointer; }
.member-row:active { background: rgba(255, 255, 255, 0.04); border-radius: 16rpx; }
.avatar-s {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.08);
}
.row-info {
  flex: 1; min-width: 0;
  display: flex; flex-direction: column; gap: 4rpx;
  margin-left: 18rpx;
}
.row-title {
  font-size: 28rpx; font-weight: 600; color: #E7E9F3;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.row-sub {
  font-size: 22rpx;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.btn-xs {
  height: 52rpx; border-radius: 26rpx;
  font-size: 22rpx; font-weight: 600;
  padding: 0 20rpx; box-sizing: border-box;
  flex-shrink: 0;
}
.btn-ghost-danger {
  background: rgba(198, 90, 90, 0.12);
  color: rgba(255, 200, 200, 0.96);
  border: 1rpx solid rgba(198, 90, 90, 0.28);
}
.btn-ghost-danger:active { background: rgba(198, 90, 90, 0.26); }

.sheet--member { max-height: 62vh; }
.member-card-bd {
  display: flex; justify-content: center;
  padding: 36rpx 28rpx 48rpx;
}
.member-face {
  width: 100%;
  display: flex; flex-direction: column; align-items: center;
  gap: 12rpx;
  padding: 44rpx 28rpx 40rpx;
  border-radius: 28rpx;
  background: linear-gradient(160deg, rgba(143, 123, 255, 0.16), rgba(242, 193, 78, 0.08));
  border: 1rpx solid rgba(242, 193, 78, 0.16);
  box-sizing: border-box;
}
.member-face__avatar {
  width: 168rpx; height: 168rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 4rpx solid rgba(255, 255, 255, 0.14);
  box-sizing: border-box;
}
.member-face__name {
  margin-top: 12rpx;
  font-size: 38rpx; font-weight: 800; color: #fff;
  text-align: center;
  max-width: 100%;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.member-face__title {
  font-size: 26rpx; color: #F2C14E;
  text-align: center;
  max-width: 100%;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.member-face__meta {
  margin-top: 8rpx;
  font-size: 22rpx; color: rgba(231, 233, 243, 0.5);
}
.member-face__role {
  font-size: 22rpx; font-weight: 600; color: #8F7BFF;
  background: rgba(143, 123, 255, 0.14);
  border: 1rpx solid rgba(143, 123, 255, 0.3);
  padding: 6rpx 22rpx; border-radius: 999rpx;
}
