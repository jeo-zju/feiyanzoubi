/* 圈详情（compact）：圈名简介 → 成员/馆/待审批摘要行 → 非成员申请底栏 */
page {
  background: #151714;
}

.cd-page {
  padding: 12rpx 32rpx 48rpx;
}

.cd-page--bar {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.cd-topbar {
  display: flex;
  justify-content: flex-end;
  min-height: 80rpx;
}

/* 圈名 + 简介 */
.cd-head {
  padding: 8rpx 0 12rpx;
}

.cd-head__title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.cd-head__dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.cd-head__name {
  font-size: 36rpx;
  font-weight: 600;
  color: #F3F1E7;
  line-height: 1.35;
  overflow-wrap: break-word;
}

.cd-head__desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #B9BDB0;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  overflow-wrap: break-word;
}

/* 摘要行组 */
.cd-sum-row {
  padding-left: 0;
  padding-right: 0;
}

.cd-sum-row__r {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.cd-sum-row__r .menu-row__sub {
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 头像叠放 */
.cd-avatars {
  display: flex;
  align-items: center;
}

.cd-avatars__img {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #151714;
  background: #2B3029;
  margin-left: -12rpx;
  box-sizing: border-box;
}

.cd-avatars__img:first-child {
  margin-left: 0;
}

/* 待审批数 */
.cd-pending-num {
  font-size: 24rpx;
  color: #969D90;
}

.cd-pending-num.is-on {
  color: #E8C58C;
  font-weight: 600;
}

.cd-role {
  color: #D2EF72;
  font-weight: 400;
  font-size: 26rpx;
}

/* 弹层内操作按钮去默认边框 */
.sheet-item .btn-text::after,
.cd-face-back .btn::after {
  border: none;
}

.sheet-item__actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

/* 名片视图（在成员弹层内替换显示） */
.cd-face-bd {
  padding-bottom: 32rpx;
}

.cd-page .member-face {
  padding: 36rpx 32rpx 16rpx;
}

.cd-page .member-face__avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #2B3029;
  border: 2rpx solid rgba(210, 239, 114, 0.3);
}

.cd-page .member-face__name {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #F3F1E7;
}

.cd-page .member-face__title {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #B9BDB0;
}

.cd-page .member-face__meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #969D90;
}

.cd-page .member-face__tag,
.cd-page .member-face__role {
  margin-top: 14rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #E8C58C;
  background: rgba(232, 197, 140, 0.12);
  border: 1rpx solid rgba(232, 197, 140, 0.3);
}

.cd-face-back {
  padding: 12rpx 32rpx 0;
}

/* 危险操作行沿用 v2 危险色（覆盖全局同特异度的浅粉） */
.cd-page .sheet-item--danger .sheet-item__label {
  color: #F1A19A;
}

.cd-page .sheet-item--danger:active {
  background: rgba(241, 161, 154, 0.1);
}

/* 返回按钮占满一行（复用全局 btn--block，补 v2 页面内边距） */
.cd-face-back .btn {
  width: 100%;
}
