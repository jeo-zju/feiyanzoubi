<view class="page page--circle-detail" wx:if="{{circle}}">
  <view class="topbar">
    <view class="topbar__back" bindtap="goBack">‹</view>
    <view class="topbar__title">岩友圈</view>
    <view class="topbar__gear" bindtap="openSettingSheet">⚙</view>
  </view>

  <view class="hero">
    <view class="hero__color" style="background:{{circle.color}};"></view>
    <view class="hero__title">{{circle.name}}</view>
    <view class="hero__desc">{{circle.description || ' '}}</view>
    <view class="hero__meta">
      <view class="hero__meta-item">
        <text class="hero__meta-num">{{circle.memberCount || 0}}</text>
        <text class="hero__meta-label">成员</text>
      </view>
      <view class="hero__meta-split"></view>
      <view class="hero__meta-item">
        <text class="hero__meta-num">{{gyms.length}}</text>
        <text class="hero__meta-label">岩馆</text>
      </view>
      <view class="hero__meta-split"></view>
      <view class="hero__meta-item">
        <text class="hero__meta-num">{{circle.city || '-'}}</text>
        <text class="hero__meta-label">城市</text>
      </view>
    </view>
    <view wx:if="{{gyms.length}}" class="hero__gyms">
      <view wx:for="{{gyms}}" wx:key="_id" class="hero__gym-chip">📍 {{item.name}}</view>
    </view>
  </view>

  <view class="card mt-sm">
    <view class="card-hd">
      <text class="card-hd__t">成员 · {{members.length}}</text>
      <text wx:if="{{pendingCount>0}}" class="card-hd__badge">{{pendingCount}} 待审批</text>
    </view>
    <view class="card-bd list list--tight">
      <view wx:if="{{members.length===0 && pendings.length===0}}" class="empty-state">暂无成员</view>
      <block wx:else>
        <view class="list-row row member-row" wx:for="{{members}}" wx:key="openid" data-oid="{{item.openid}}" bindtap="onTapMember">
          <image class="avatar-s" src="{{item.avatarUrl || defaultAvatar}}" mode="aspectFill" />
          <view class="row-info">
            <view class="row-title">{{item.displayName || item.nickName || '岩友'}}{{item.role==='admin' ? ' · 管理员' : ''}}</view>
            <view class="muted row-sub">{{item.rockId || '-'}}{{item.title ? ' · ' + item.title : ''}}</view>
          </view>
          <view wx:if="{{isAdmin && item.role!=='admin'}}" class="btn btn-xs btn-ghost-danger" data-oid="{{item.openid}}" catchtap="onRemoveMember">移除</view>
          <view wx:elif="{{item.openid===myOpenid}}" class="btn btn-xs btn-ghost" data-oid="{{item.openid}}" catchtap="onConfirmLeave">退出</view>
        </view>
        <view wx:if="{{pendings.length>0}}" class="pending-divider">待审批申请</view>
        <view class="list-row row pending-row" wx:for="{{pendings}}" wx:key="openid">
          <image class="avatar-s" src="{{item.avatarUrl || defaultAvatar}}" mode="aspectFill" />
          <view class="row-info">
            <view class="row-title">{{item.displayName || item.nickName || '岩友'}}</view>
            <view class="muted row-sub">{{item.rockId || '-'}}{{item.title ? ' · ' + item.title : ''}}</view>
          </view>
          <view wx:if="{{isAdmin}}" class="sheet-item__actions">
            <view class="ic-btn ic-btn--ok" data-oid="{{item.openid}}" bindtap="onApprove">✓</view>
            <view class="ic-btn ic-btn--no" data-oid="{{item.openid}}" bindtap="onReject">✕</view>
          </view>
          <view wx:else class="btn btn-xs btn-ghost">待审批</view>
        </view>
      </block>
    </view>
  </view>

  <view class="foot">
    <view wx:if="{{myStatus!=='accepted' && myStatus!=='admin'}}" class="btn-apply" bindtap="onTapApply">
      <text wx:if="{{myStatus==='pending'}}">申请中</text>
      <text wx:else>申请加入</text>
    </view>
    <view wx:else class="tag-in">
      <text wx:if="{{isAdmin}}">· 管理员 ·</text>
      <text wx:else>· 已在圈内 ·</text>
    </view>
  </view>

  <view wx:if="{{gymSheetVisible}}" class="sheet-mask" bindtap="closeGymSheet" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet__hd">
        <text class="sheet__title">关联岩馆 · {{gyms.length}}</text>
        <view class="sheet__close" bindtap="closeGymSheet">✕</view>
      </view>
      <scroll-view class="sheet__bd" scroll-y>
        <view wx:if="{{gyms.length===0}}" class="sheet-empty">暂未关联岩馆</view>
        <block wx:else>
          <view class="sheet-item sheet-item--row" wx:for="{{gyms}}" wx:key="_id">
            <view class="sheet-item__ic">🏟️</view>
            <view class="sheet-item__info">
              <text class="sheet-item__name">{{item.name}}</text>
              <text class="sheet-item__sub">{{item.address || item.city || ''}}</text>
            </view>
            <view wx:if="{{isAdmin}}" class="sheet-item__btn sheet-item__btn--danger" data-gid="{{item._id}}" bindtap="onUnlinkGym">移除</view>
          </view>
        </block>
        <view wx:if="{{isAdmin}}" class="sheet-link-add" bindtap="openLinkGymSheet">+ 关联岩馆</view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{settingSheetVisible}}" class="sheet-mask" bindtap="closeSettingSheet" catchtouchmove="noop">
    <view class="sheet sheet--sm" catchtap="noop">
      <view class="sheet__hd">
        <text class="sheet__title">设置</text>
        <view class="sheet__close" bindtap="closeSettingSheet">✕</view>
      </view>
      <view class="sheet__bd">
        <block wx:if="{{isAdmin}}">
          <view class="sheet-item" bindtap="goEdit">
            <text class="sheet-item__label">编辑资料</text>
            <text class="sheet-item__arrow">›</text>
          </view>
          <view class="sheet-divider"></view>
          <view class="sheet-item" bindtap="openGymSheet">
            <text class="sheet-item__label">关联岩馆管理</text>
            <text class="sheet-item__arrow">›</text>
          </view>
          <view class="sheet-divider"></view>
          <view class="sheet-item sheet-item--danger" bindtap="onConfirmDisband">
            <text class="sheet-item__label">解散岩友圈</text>
          </view>
        </block>
        <block wx:else>
          <view class="sheet-item sheet-item--danger" bindtap="onConfirmLeave">
            <text class="sheet-item__label">退出岩友圈</text>
          </view>
        </block>
      </view>
    </view>
  </view>

  <view wx:if="{{linkGymSheetVisible}}" class="sheet-mask sheet-mask--gym" bindtap="closeLinkGymSheet" catchtouchmove="noop">
    <view class="sheet sheet--gym" catchtap="noop">
      <view class="sheet__hd">
        <text class="sheet__title">关联岩馆</text>
        <view class="sheet__close" bindtap="saveLinkGyms">✓</view>
      </view>
      <scroll-view class="sheet__bd" scroll-y>
        <view wx:if="{{linkGymOptions.length===0}}" class="sheet-empty">当前城市暂无岩馆</view>
        <block wx:else>
          <view class="sheet-item" wx:for="{{linkGymOptions}}" wx:key="_id"
            data-id="{{item._id}}"
            bindtap="toggleLinkGym">
            <text class="sheet-item__label">{{item.name}}</text>
            <view class="check-box {{item.linked?'check-box--on':''}}">
              <text wx:if="{{item.linked}}" class="check-box__t">✓</text>
            </view>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{memberCardVisible && memberCard}}" class="sheet-mask" bindtap="closeMemberCard" catchtouchmove="noop">
    <view class="sheet sheet--member" catchtap="noop">
      <view class="sheet__hd">
        <text class="sheet__title">岩友名片</text>
        <view class="sheet__close" bindtap="closeMemberCard">✕</view>
      </view>
      <view class="sheet__bd member-card-bd">
        <view class="member-face">
          <image class="member-face__avatar" src="{{memberCard.avatarUrl || defaultAvatar}}" mode="aspectFill" />
          <view class="member-face__name">{{memberCard.displayName || memberCard.nickName || '岩友'}}</view>
          <view wx:if="{{memberCard.title}}" class="member-face__title">{{memberCard.title}}</view>
          <view class="member-face__meta">岩友号 {{memberCard.rockId || '-'}}</view>
          <view wx:if="{{memberCard.role==='admin'}}" class="member-face__role">圈主 · 管理员</view>
        </view>
      </view>
    </view>
  </view>
</view>
