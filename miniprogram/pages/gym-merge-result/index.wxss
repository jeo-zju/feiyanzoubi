.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #0b0d15;
  color: #e7e9f3;
  box-sizing: border-box;
}

.panel {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.success-panel {
  border-color: rgba(242, 193, 78, 0.24);
  background: rgba(242, 193, 78, 0.08);
}

.title {
  font-size: 30rpx;
  font-weight: 600;
}

.success-text,
.summary-text,
.detail-label,
.detail-value {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.summary-text,
.detail-label {
  color: rgba(231, 233, 243, 0.72);
}

.detail-value {
  color: #ffffff;
}

.pre-line {
  white-space: pre-line;
}

.detail-row + .detail-row {
  margin-top: 10rpx;
}

.history-item + .history-item {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.actions .btn + .btn {
  margin-top: 12rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
}

.btn-primary {
  background: #f2c14e;
  color: #181a20;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.btn-ghost {
  background: transparent;
  color: rgba(231, 233, 243, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}
