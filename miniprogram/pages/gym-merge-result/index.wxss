/* 页面特有布局；元素样式统一由全局 app.wxss 提供 */

.page--result {
  padding-bottom: 240rpx;
}

.pre-line {
  white-space: pre-line;
}

.detail-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-weight: 600;
}

.history-item {
  padding: 12rpx 0;
}

.history-item:first-child {
  padding-top: 0;
}

.history-item + .history-item {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.history-name {
  font-weight: 700;
}
