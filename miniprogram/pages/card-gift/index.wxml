<view class="page ui-v2 cg-page">
  <!-- 阶段一：准备草稿 -->
  <view wx:if="{{!giftId}}" class="card cg-card">
    <view class="cg-step">
      <view class="cg-step__t">1. 准备草稿</view>
      <view class="cg-step__d">先在名片编辑器做好要送出的名片草稿。</view>
      <view class="cg-draft-row">
        <text class="tag {{draftCardId ? 'tag--on' : ''}}">{{draftCardId ? '草稿已准备' : '暂无草稿'}}</text>
        <button wx:if="{{draftCardId}}" class="btn-text" bindtap="goSaveDraft">查看草稿图</button>
      </view>
      <button class="btn btn-ghost btn--block" bindtap="goMake">{{draftCardId ? '重新做一张草稿' : '去做草稿'}}</button>
    </view>

    <view class="cg-step">
      <view class="cg-step__t">2. 生成领取信息</view>
      <view class="cg-step__d">生成领取码消耗 1 次灵感；生成后可转发或让朋友扫码领取。</view>
      <button class="btn btn-primary btn--block" loading="{{creating}}" disabled="{{creating || !draftCardId}}" bindtap="onCreateLink">生成领取码</button>
    </view>
  </view>

  <!-- 阶段二：领取码与转发（同屏不再展示已完成步骤/教程） -->
  <block wx:else>
    <view class="card cg-card cg-result">
      <view class="cg-result__t">领取码已生成</view>
      <view class="cg-qr">
        <image wx:if="{{qrFileId}}" class="cg-qr__img" mode="aspectFit" src="{{qrFileId}}"></image>
        <view wx:else class="cg-qr__loading">二维码生成中…</view>
      </view>
      <view class="cg-code-row">
        <text class="cg-code">{{giftId}}</text>
        <button class="btn-text" bindtap="onCopyGiftId">复制</button>
      </view>
    </view>
    <view class="action-bar cg-actions">
      <button class="btn btn-primary" open-type="share">转发给好友领取</button>
    </view>
  </block>
</view>
