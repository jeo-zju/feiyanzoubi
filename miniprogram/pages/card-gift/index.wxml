<view class="page">
  <view class="card card-hero">
    <view class="card-bd">
      <view class="section-title-lg">做张送朋友</view>
      <view class="section-desc">先准备草稿，再选一种送出方式。</view>
      <view class="row mt2">
        <view class="btn btn-primary flex" bindtap="goMake">先做草稿</view>
        <view class="btn btn-ghost flex ml" bindtap="goSaveDraft" wx:if="{{draftCardId}}">保存图片</view>
      </view>
      <view class="section-tip mt2">当前草稿：{{draftCardId || '还没有'}}</view>
    </view>
  </view>

  <view class="card mt">
    <view class="card-hd">选择方式</view>
    <view class="card-bd">
      <view class="split">
        <view class="panel split-left">
          <view class="split-title">链接领取</view>
          <view class="section-tip split-tip">生成后可直接转发，也可以扫码领取。</view>
          <view class="btn btn-warn mt2" bindtap="onCreateLink">生成领取码</view>
          <view class="btn btn-ghost mt2" open-type="share" wx:if="{{giftId}}">转发好友</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card mt" wx:if="{{giftId}}">
    <view class="card-hd">领取码</view>
    <view class="card-bd">
      <view class="row">
        <view class="tag flex">{{giftId}}</view>
        <view class="btn btn-ghost ml" bindtap="onCopyGiftId">复制</view>
      </view>
      <image wx:if="{{qrFileId}}" class="qr" mode="aspectFit" src="{{qrFileId}}"></image>
      <view class="section-tip mt2">扫码即可领取</view>
    </view>
  </view>
</view>
