.qr {
  width: 320rpx;
  height: 320rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
}

.mt2 {
  margin-top: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.flex {
  flex: 1;
}

.ml {
  margin-left: 16rpx;
}

.hero {
  background: linear-gradient(135deg, rgba(143, 123, 255, 0.20), rgba(242, 193, 78, 0.10));
  border: 1rpx solid rgba(143, 123, 255, 0.22);
}

.hero-title {
  font-size: 34rpx;
  font-weight: 900;
}

.hero-sub {
  margin-top: 8rpx;
}

.split {
  display: flex;
  gap: 18rpx;
}

.split-left,
.split-right {
  flex: 1;
  padding: 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
}

.split-title {
  font-weight: 900;
  margin-bottom: 8rpx;
}
