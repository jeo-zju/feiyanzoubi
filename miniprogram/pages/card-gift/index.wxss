/* 赠送名片（compact）：同一操作区随阶段变换，二维码保持完整静区 */
page {
  background: #151714;
}

.cg-page {
  padding: 24rpx 32rpx calc(150rpx + env(safe-area-inset-bottom));
}

.cg-card {
  padding: 8rpx 0;
}

.cg-step {
  padding: 24rpx 0;
}

.cg-step + .cg-step {
  border-top: 1rpx solid #383E34;
}

.cg-step__t {
  font-size: 32rpx;
  font-weight: 600;
  color: #F3F1E7;
}

.cg-step__d {
  margin: 12rpx 0 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #969D90;
}

.cg-draft-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.cg-page .btn::after {
  border: none;
}

/* 结果阶段 */
.cg-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 32rpx 20rpx;
}

.cg-result__t {
  font-size: 32rpx;
  font-weight: 600;
  color: #F3F1E7;
}

/* 白底静区，短屏也不压缩二维码 */
.cg-qr {
  margin-top: 28rpx;
  width: 400rpx;
  height: 400rpx;
  max-width: 72vw;
  max-height: 72vw;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cg-qr__img {
  width: 100%;
  height: 100%;
}

.cg-qr__loading {
  font-size: 24rpx;
  color: #969D90;
}

.cg-code-row {
  margin-top: 24rpx;
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cg-code {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #B9BDB0;
  word-break: break-all;
  line-height: 1.5;
}
