.viewport-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.viewport-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 18rpx;
}

.mt {
  margin-top: 20rpx;
}

.mt-sm {
  margin-top: 12rpx;
}

.ml {
  margin-left: 12rpx;
}

.flex {
  flex: 1;
}

.field-block {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.field-label {
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.72);
}

.textarea {
  min-height: 120rpx;
  width: 100%;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #e7e9f3;
  line-height: 1.6;
}

.picker-field {
  min-height: 84rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #e7e9f3;
  display: flex;
  align-items: center;
}

.dual-grid {
  display: flex;
  gap: 14rpx;
}

.dual-grid .field-block {
  flex: 1;
  min-width: 0;
}

.action-row {
  display: flex;
  align-items: center;
}

.item-title {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}

.item-address {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(231, 233, 243, 0.78);
}

.item-meta {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  font-size: 22rpx;
  color: rgba(231, 233, 243, 0.58);
}
