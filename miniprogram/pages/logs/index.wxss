.ops {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.mini {
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.row-right {
  display: flex;
  gap: 12rpx;
}

.log {
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.log:first-child {
  border-top: none;
}

.log-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.log-mid {
  margin-top: 10rpx;
  font-weight: 900;
}

.log-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  padding: 28rpx 0;
}

