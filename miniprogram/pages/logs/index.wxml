<view class="page">
  <view class="card">
    <view class="card-hd row">
      <view>调试日志</view>
      <view class="row-right">
        <view class="btn btn-ghost mini" bindtap="onRefresh">刷新</view>
      </view>
    </view>
    <view class="card-bd">
      <view class="ops">
        <view class="btn btn-warn mini" bindtap="onClear">清空</view>
        <view class="btn btn-warn mini" bindtap="onCopyAll">复制全部</view>
        <view class="btn btn-ghost mini" bindtap="onProbe">探测数据</view>
      </view>
      <view wx:for="{{logs}}" wx:key="traceId" class="log" bindtap="onCopyItem" data-index="{{index}}">
        <view class="log-hd">
          <view class="tag">{{item.type}}</view>
          <view class="muted">{{item.atText}}</view>
        </view>
        <view class="log-mid">{{item.name}}</view>
        <view class="muted log-sub">traceId: {{item.traceId}} · {{item.ms}}ms</view>
      </view>
      <view wx:if="{{!logs.length}}" class="empty muted">暂无日志</view>
    </view>
  </view>
</view>

