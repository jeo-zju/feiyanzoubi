<view class="page ui-v2 detail-page">
  <view wx:if="{{loading}}" class="empty-state">正在加载约爬…</view>
  <view wx:elif="{{error}}" class="empty-state">
    <view class="empty-state__desc">{{error}}</view>
    <button class="btn btn-ghost" bindtap="load">重试</button>
  </view>
  <block wx:elif="{{plan}}">
    <!-- 时间签：日期左 / 时间右，一行 -->
    <view class="detail-ticket">
      <text class="detail-ticket__date"><text class="ticket__week">{{plan.weekdayText}}</text> · {{plan.mdText}}</text>
      <text class="detail-ticket__time">{{timeText}}</text>
    </view>
    <view class="detail-title {{titleExpanded?'':'detail-title--clamp'}}">{{plan.title}}</view>
    <view wx:if="{{titleLong}}" class="detail-expand" bindtap="toggleTitle">{{titleExpanded?'收起':'展开'}}</view>
    <view class="detail-gym">{{plan.gymSnapshot.name}}</view>
    <view wx:if="{{plan.skillTags.length || plan.atmosphereTags.length}}" class="detail-tags">{{plan.typeText}}{{plan.atmosphereText ? ' · ' + plan.atmosphereText : ''}}</view>
    <view class="detail-rule">{{joinRuleText}}</view>

    <!-- 取消/结束：正文顶部只保留这一条状态 -->
    <view wx:if="{{plan.status==='cancelled'}}" class="state-banner is-danger">
      <text>这场约爬已取消</text>
    </view>
    <view wx:elif="{{ended}}" class="state-banner is-muted">
      <text>这场约爬已结束，期待下次一起爬</text>
    </view>

    <!-- 发起人：唯一完整资料行 -->
    <view class="owner-row">
      <image class="owner-row__avatar" src="{{detail.ownerInfo.avatarUrl || '/images/avatar.png'}}" mode="aspectFill" />
      <view class="owner-row__main">
        <view class="owner-row__name">{{detail.ownerInfo.displayName}}<text class="owner-row__badge">发起人</text></view>
        <view wx:if="{{ownerSkillText}}" class="owner-row__skill">常爬 {{ownerSkillText}}</view>
      </view>
      <view class="owner-row__more" bindtap="openMore">更多</view>
    </view>

    <!-- 活动说明：有才显示，默认三行 -->
    <block wx:if="{{plan.note}}">
      <view class="detail-note {{noteExpanded?'':'detail-note--clamp'}}">{{plan.note}}</view>
      <view wx:if="{{noteLong}}" class="detail-expand" bindtap="toggleNote">{{noteExpanded?'收起':'展开'}}</view>
    </block>

    <!-- 集合与联络：已确认/发起人直接展开（赴约关键信息，不再折叠） -->
    <view wx:if="{{detail.joined}}" class="detail-meet">
      <view class="detail-meet__t">集合与联络</view>
      <view wx:if="{{detail.meetingPoint}}" class="detail-meet__line">{{detail.meetingPoint}}</view>
      <view wx:if="{{detail.contact}}" class="detail-meet__line detail-meet__line--contact">
        <text class="detail-meet__contact">{{detail.contact}}</text>
        <text class="btn-text detail-meet__copy" bindtap="copyContact">复制</text>
      </view>
      <view wx:if="{{!detail.meetingPoint && !detail.contact}}" class="detail-meet__empty">发起人尚未填写，请留意群内通知。</view>
    </view>

    <!-- 成员摘要：人数 + 最多三个真实头像 + 查看 -->
    <view class="member-sum" bindtap="openMembers">
      <text class="member-sum__label">一起爬</text>
      <text class="member-sum__count">{{plan.seatsText}}</text>
      <view class="member-sum__avatars">
        <image wx:for="{{memberAvatars}}" wx:key="openid" class="member-sum__avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
      </view>
      <text class="member-sum__more">查看 ›</text>
    </view>

    <!-- 待确认：发起人的待办突出在摘要下，不藏进菜单 -->
    <view wx:if="{{detail.isOwner && detail.pending.length}}" class="pending-entry" bindtap="openPending">
      <text class="pending-entry__t">待你确认 {{detail.pending.length}} 人</text>
      <text class="pending-entry__arrow">›</text>
    </view>

    <!-- 未确认访客：集合信息一行提示，不用大空面板 -->
    <view wx:if="{{!detail.joined}}" class="meet-locked">
      <text class="meet-locked__t">集合与联络</text>
      <text class="meet-locked__s">确认参加后可查看</text>
    </view>

    <!-- 底栏：按状态分三种主操作 + 紧凑状态条 -->
    <view class="social-bottom">
      <button wx:if="{{ended || plan.status==='cancelled'}}" class="btn btn-primary" bindtap="again">再约一次</button>
      <button wx:elif="{{detail.isOwner}}" class="btn btn-primary" open-type="share">邀请岩友</button>
      <button wx:elif="{{barMode==='join'}}" class="btn btn-primary" bindtap="mainAction" disabled="{{buttonDisabled || busy}}" loading="{{busy}}">{{buttonLabel}}</button>
      <view wx:else class="detail-statusbar">
        <view class="detail-statusbar__main">
          <view class="detail-statusbar__t">{{stateBarTitle}}</view>
          <view wx:if="{{stateBarSub}}" class="detail-statusbar__s">{{stateBarSub}}</view>
        </view>
        <button wx:if="{{showCancel}}" class="btn btn-ghost mini detail-statusbar__btn" bindtap="mainAction">{{detail.myStatus==='pending' ? '取消申请' : '取消报名'}}</button>
      </view>
    </view>
  </block>

  <!-- 完整名单弹层 -->
  <view wx:if="{{membersOpen}}" class="sheet-mask" bindtap="closeMembers" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet__hd">
        <text class="sheet__title">一起爬的岩友 · {{plan.seatsText}}</text>
        <view class="sheet__close" bindtap="closeMembers">✕</view>
      </view>
      <scroll-view scroll-y class="sheet__bd">
        <view class="sheet-item roster-row">
          <image class="roster-row__avatar" src="{{detail.ownerInfo.avatarUrl || '/images/avatar.png'}}" mode="aspectFill" />
          <view class="roster-row__main">
            <view class="sheet-item__name">{{detail.ownerInfo.displayName}}</view>
          </view>
          <text class="tag tag-warn">发起人</text>
        </view>
        <view wx:for="{{detail.joiners}}" wx:key="joinId" class="sheet-item roster-row">
          <image class="roster-row__avatar" src="{{item.avatarUrl || '/images/avatar.png'}}" mode="aspectFill" />
          <view class="roster-row__main">
            <view class="sheet-item__name">{{item.displayName}}</view>
          </view>
          <button wx:if="{{detail.isOwner && !ended && plan.status==='active'}}" class="btn-text btn-text--danger" data-id="{{item.openid}}" bindtap="remove">移除</button>
          <button wx:elif="{{ended && item.canRelate !== false}}" class="btn-text" data-id="{{item.openid}}" bindtap="addFriend">加岩友</button>
        </view>
        <view wx:if="{{ended && !detail.isOwner && detail.ownerInfo.canRelate !== false}}" class="sheet-item roster-row">
          <image class="roster-row__avatar" src="{{detail.ownerInfo.avatarUrl || '/images/avatar.png'}}" mode="aspectFill" />
          <view class="roster-row__main">
            <view class="sheet-item__name">{{detail.ownerInfo.displayName}}</view>
            <view class="sheet-item__sub">发起人</view>
          </view>
          <button class="btn-text" data-id="{{detail.ownerInfo.openid}}" bindtap="addFriend">加岩友</button>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 待确认名单弹层（发起人） -->
  <view wx:if="{{pendingOpen}}" class="sheet-mask" bindtap="closePending" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet__hd">
        <text class="sheet__title">待确认 · {{detail.pending.length}} 人</text>
        <view class="sheet__close" bindtap="closePending">✕</view>
      </view>
      <scroll-view scroll-y class="sheet__bd">
        <view wx:for="{{detail.pending}}" wx:key="joinId" class="sheet-item roster-row">
          <image class="roster-row__avatar" src="{{item.avatarUrl || '/images/avatar.png'}}" mode="aspectFill" />
          <view class="roster-row__main">
            <view class="sheet-item__name">{{item.displayName}}</view>
            <view class="sheet-item__sub">申请加入，等待你确认</view>
          </view>
          <view class="roster-row__btns">
            <button class="btn btn-primary mini" data-id="{{item.openid}}" bindtap="approve" disabled="{{busy}}">接受</button>
            <button class="btn-text btn-text--danger" data-id="{{item.openid}}" bindtap="reject" disabled="{{busy}}">暂不接受</button>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 更多操作弹层：分享用真正 open-type=share，其余依权限展示 -->
  <view wx:if="{{moreOpen}}" class="sheet-mask" bindtap="closeMore" catchtouchmove="noop">
    <view class="sheet sheet--sm" catchtap="noop">
      <view class="sheet__hd">
        <text class="sheet__title">更多</text>
        <view class="sheet__close" bindtap="closeMore">✕</view>
      </view>
      <scroll-view scroll-y class="sheet__bd">
        <button class="sheet-item more-item" open-type="share">
          <text class="sheet-item__label">分享给岩友</text>
          <text class="sheet-item__arrow">›</text>
        </button>
        <view wx:if="{{detail.isOwner && !ended && plan.status==='active'}}" class="sheet-item" bindtap="onEditTap">
          <text class="sheet-item__label">编辑约爬</text>
          <text class="sheet-item__arrow">›</text>
        </view>
        <view wx:if="{{detail.isOwner && !ended && plan.status==='active'}}" class="sheet-item" bindtap="onCancelTap">
          <text class="sheet-item__label more-item--danger">取消约爬</text>
          <text class="sheet-item__arrow">›</text>
        </view>
        <view wx:if="{{!detail.isOwner}}" class="sheet-item" bindtap="onReportTap">
          <text class="sheet-item__label">举报这场约爬</text>
          <text class="sheet-item__arrow">›</text>
        </view>
        <view wx:if="{{!detail.isOwner}}" class="sheet-item" bindtap="onBlockTap">
          <text class="sheet-item__label">屏蔽发起人</text>
          <text class="sheet-item__arrow">›</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
