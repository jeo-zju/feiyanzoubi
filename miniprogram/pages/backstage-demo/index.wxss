.seg {
  display: flex;
  gap: 12rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border: 1rpx solid #d8dce3;
  border-radius: 12rpx;
  color: #5a6070;
  font-size: 26rpx;
  background: #fff;
}

.seg-item-on {
  border-color: #2f7cf6;
  color: #2f7cf6;
  background: #eef4ff;
  font-weight: 600;
}

.preview-row {
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}

.run-panel {
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.progress {
  height: 16rpx;
  border-radius: 999rpx;
  background: #eef0f4;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: #2f7cf6;
  transition: width 0.2s ease;
}

.btn-disabled {
  opacity: 0.55;
  pointer-events: none;
}
