/* 找搭子页：卡片/按钮/选择器/弹层均使用全局体系，本文件只保留页面特有布局 */
.discover-page {
  padding: 28rpx 24rpx 200rpx;
}

/* scroll-view 作为弹层主体时，高度约束交给 scroll-view 自身滚动 */
.discover-page .sheet__bd {
  overflow: hidden;
  min-height: 0;
}

.discover-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.eyebrow {
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.6);
  letter-spacing: 2rpx;
}

.city-arrow {
  color: #c5baff;
  font-size: 32rpx;
  font-weight: 400;
}

.date-tabs {
  margin: 28rpx 0 20rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.filter-field {
  flex: 1;
  min-width: 0;
}

.availability {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.6);
  margin: 18rpx 0;
}

.plan-card {
  margin-bottom: 24rpx;
}

.plan-card__date {
  font-size: 24rpx;
  color: #c5baff;
  font-weight: 600;
}

.plan-title {
  margin-top: 14rpx;
}

.plan-card__gym {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: rgba(231, 233, 243, 0.78);
}

.host-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 0;
}

.host-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
}

.host-name {
  font-size: 28rpx;
  font-weight: 700;
}

.host-level {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.6);
}

.plan-tags {
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.6);
  line-height: 1.7;
}

.plan-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.6);
}

.plan-cta {
  color: #c5baff;
  font-weight: 700;
}

.list-status {
  padding: 28rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.6);
}
