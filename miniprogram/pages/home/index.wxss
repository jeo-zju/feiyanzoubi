.viewport-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.viewport-scroll {
  flex: 1;
  min-height: 0;
}

.search-row {
  display: flex;
  gap: 14rpx;
  align-items: stretch;
  margin-top: 18rpx;
}

.search-row .input {
  flex: 1;
}

.search-btn {
  width: 132rpx;
  height: 76rpx;
}

.mode-row {
  margin-top: 16rpx;
}

.list-scroll {
  margin-top: 18rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 12rpx;
}

.ph {
  color: rgba(231, 233, 243, 0.4);
}

