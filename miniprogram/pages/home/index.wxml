<view class="page viewport-page">
  <view class="card card-hero">
    <view class="card-bd">
      <view class="section-title-lg">今天想去哪家馆？</view>
      <view class="section-desc">按城市或馆名找一找，选好就去打卡。</view>
      <view class="search-row">
        <input class="input" placeholder="城市" placeholder-class="ph" value="{{city}}" bindinput="onCityInput" />
        <input class="input" placeholder="岩馆名" placeholder-class="ph" value="{{keyword}}" bindinput="onKeywordInput" />
        <view class="btn btn-warn search-btn" bindtap="onSearch">搜索</view>
      </view>
      <view class="mode-row">
        <seg-tabs tabs="{{modeTabs}}" value="{{mode}}" bind:change="onModeChange" />
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="viewport-scroll list-scroll">
    <view class="list">
      <gym-card wx:for="{{gyms}}" wx:key="_id" gym="{{item}}" bind:tap="onTapGym" />
      <view wx:if="{{!gyms.length && !loading}}" class="empty-state">还没有找到岩馆</view>
      <paginator
        wx:if="{{gyms.length}}"
        page="{{page}}"
        hasNext="{{hasNext}}"
        bind:prev="onPrev"
        bind:next="onNext"
      />
    </view>
  </scroll-view>
</view>

