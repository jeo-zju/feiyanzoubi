<view class="page discover-page">
  <view class="discover-heading">
    <view>
      <view class="eyebrow">一起爬，认识新岩友</view>
      <view class="page-title" bindtap="openCitySheet">{{city}} <text class="city-arrow">⌄</text></view>
    </view>
    <button class="btn-text" bindtap="notifications">通知</button>
  </view>
  <view class="date-tabs"><seg-tabs tabs="{{dateTabs}}" value="{{dateTab}}" bind:change="pickDate" /></view>
  <view class="filter-row">
    <view class="field-select filter-field" bindtap="openGym">
      <text class="field-select__value">{{gymName}}</text>
      <text class="field-select__arrow">▾</text>
    </view>
    <picker class="filter-field" range="{{typeLabels}}" value="{{typeIndex}}" bindchange="pickType">
      <view class="field-select">
        <text class="field-select__value">{{typeLabels[typeIndex]}}</text>
        <text class="field-select__arrow">▾</text>
      </view>
    </picker>
    <button class="btn-text" bindtap="calendar">日历</button>
  </view>
  <view class="availability"><text>仅看有名额的约爬</text><switch class="switch-sm" checked="{{onlyAvailable}}" bindchange="toggleAvailable" color="#8f7bff" /></view>
  <view class="card card-pad plan-card" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="openPlan">
    <view class="plan-card__date">{{item.date}} · {{item.startTime}}–{{item.endTime}}</view>
    <view class="plan-title">{{item.title}}</view>
    <view class="plan-card__gym">{{item.gymName}}</view>
    <view class="host-row">
      <image class="host-avatar" src="{{item.user.avatarUrl || '/images/avatar.png'}}" mode="aspectFill" />
      <view>
        <view class="host-name">{{item.user.displayName}}</view>
        <view class="host-level">{{item.skillText}}</view>
      </view>
    </view>
    <view class="plan-tags">{{item.typeText}}{{item.atmosphereText?' · '+item.atmosphereText:''}}</view>
    <view class="plan-card__footer"><text>{{item.countText}}</text><text class="plan-cta">{{item.joinable?'查看并加入':'查看约爬'}} ›</text></view>
  </view>
  <view wx:if="{{error}}" class="empty-state">
    <view class="empty-state__desc">{{error}}</view>
    <button class="btn btn-ghost" bindtap="retry">重试</button>
  </view>
  <view wx:elif="{{!list.length && !loading}}" class="empty-state">
    <view class="empty-state__title">还没有合适的约爬</view>
    <view class="empty-state__desc">发起一场，邀请新岩友一起爬。也可以换个时间或岩馆看看。</view>
    <button class="btn btn-primary" bindtap="publish">发起这段时间的约爬</button>
    <button class="btn-text" bindtap="clearFilters">清除筛选</button>
  </view>
  <view wx:if="{{loading}}" class="list-status">正在寻找约爬…</view>
  <view wx:elif="{{list.length && !hasMore}}" class="list-status">近期约爬都在这里了</view>
  <view class="action-bar"><button class="btn btn-primary" bindtap="publish">＋ 发起约爬</button></view>

  <view wx:if="{{citySheetVisible}}" class="sheet-mask" bindtap="closeCitySheet" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet__hd"><text class="sheet__title">选择城市</text><view class="sheet__close" bindtap="closeCitySheet">✕</view></view>
      <scroll-view scroll-y class="sheet__bd">
        <view class="sheet-item" wx:for="{{cityOptions}}" wx:key="name" data-city="{{item.name}}" data-custom="{{item.custom}}" bindtap="onPickCity">
          <text class="sheet-item__label">{{item.name}}</text>
          <text wx:if="{{city === item.name}}" class="sheet-item__check">✓</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{gymPicker}}" class="sheet-mask" bindtap="closeGym" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet__hd"><text class="sheet__title">选择岩馆</text><view class="sheet__close" bindtap="closeGym">✕</view></view>
      <view class="sheet__search">
        <view class="searchbar"><text class="searchbar__ic">🔍</text><input class="searchbar__input" placeholder="搜索岩馆名称或地址" placeholder-class="ph" value="{{gymKeyword}}" bindinput="searchGym" /></view>
      </view>
      <scroll-view scroll-y class="sheet__bd" bindscrolltolower="moreGyms">
        <view class="sheet-item" data-id="" data-name="全部岩馆" bindtap="pickGym">
          <text class="sheet-item__label">全部岩馆</text>
          <text wx:if="{{!gymId}}" class="sheet-item__check">✓</text>
        </view>
        <view wx:for="{{gyms}}" wx:key="_id" class="sheet-item" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="pickGym">
          <text class="sheet-item__label">{{item.name}}</text>
          <text wx:if="{{gymId === item._id}}" class="sheet-item__check">✓</text>
        </view>
        <view wx:if="{{gymLoading}}" class="sheet-empty">加载中…</view>
        <view wx:elif="{{!gyms.length && !gymLoading}}" class="sheet-empty">没有找到匹配的岩馆</view>
        <view wx:elif="{{gymHasMore}}" class="sheet-more" bindtap="moreGyms">加载更多</view>
      </scroll-view>
    </view>
  </view>
</view>
