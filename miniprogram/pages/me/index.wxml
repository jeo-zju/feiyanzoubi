<view class="page">
  <view class="profile-shell" bindtap="goProfileEdit">
    <image class="profile-avatar" mode="aspectFill" src="{{user.avatarUrl || defaultAvatar}}"></image>
    <view class="profile-main">
      <view class="profile-name">{{user.nickName || "岩友"}}</view>
      <view class="profile-sub">{{user.projectName || "Project"}}</view>
      <view class="profile-tip">点击编辑资料</view>
    </view>
    <view class="profile-arrow">›</view>
  </view>

  <view class="card card-soft mt">
    <view class="card-hd">我的名片</view>
    <view class="card-bd">
      <view wx:if="{{myPrimaryCard}}">
        <view class="mycard" bindtap="goEditMyCard">
          <view class="mycard-top">
            <view class="mycard-name">{{myPrimaryCard.displayName}}</view>
            <view class="mycard-badge">编辑</view>
          </view>
          <view class="mycard-meta">{{myPrimaryCard.title}}<text wx:if="{{myPrimaryCard.mbti}}"> · {{myPrimaryCard.mbti}}</text></view>
          <view class="mycard-one">{{myPrimaryCard.oneLiner}}</view>
        </view>
        <view class="action-pills">
          <view class="action-pill action-pill--warn" bindtap="goGift">送人</view>
          <view class="action-pill" bindtap="goSaveMyCard">保存</view>
        </view>
      </view>
      <view wx:else>
        <view class="mycard mycard--empty" style="width: {{myCardCssW}}px; height: {{myCardCssH}}px;" bindtap="goEditMyCard">
          <view class="mycard-ph">
            <view class="mycard-ph-bar"></view>
            <view class="mycard-ph-body">
              <view class="mycard-ph-top">
                <view class="mycard-ph-avatar"></view>
                <view class="mycard-ph-right">
                  <view class="mycard-ph-name">岩点测试员</view>
                  <view class="mycard-ph-meta">长臂猿 · ENTP</view>
                  <view class="mycard-ph-gym">浪迹天涯</view>
                </view>
                <view class="mycard-ph-badge">创建</view>
              </view>
              <view class="mycard-ph-one">用脚点谈判，用手点签字。</view>
              <view class="mycard-ph-ft">飞岩走壁 · 攀岩名片</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="glance-grid mt">
    <view class="card glance-card" bindtap="goWallet">
      <view class="card-bd glance-bd">
        <view class="glance-top">
          <view class="glance-title">名片夹</view>
          <view class="glance-value">{{receivedCount}}</view>
        </view>
        <view class="glance-sub">收到的卡片</view>
        <view class="thumbs thumbs--compact">
          <image
            wx:for="{{receivedThumbs}}"
            wx:key="cardId"
            class="thumb thumb--compact"
            mode="aspectFill"
            src="{{item.avatarMode==='custom'?item.avatarFileId:item.avatarUrl || defaultAvatar}}"
          ></image>
          <view wx:if="{{!receivedThumbs.length}}" class="thumb thumb--ghost"></view>
          <view wx:if="{{!receivedThumbs.length}}" class="thumb thumb--ghost"></view>
          <view wx:if="{{!receivedThumbs.length}}" class="thumb thumb--ghost"></view>
        </view>
      </view>
    </view>

    <view class="card glance-card glance-card--credit">
      <view class="card-bd glance-bd">
        <view class="glance-top">
          <view class="glance-title">灵感</view>
          <view class="glance-value">{{credit.remaining}}</view>
        </view>
        <view class="glance-sub">{{credit.limit}} / 日，0 点刷新</view>
        <view class="credit-bar">
          <view class="credit-bar-fill" style="width: {{creditPercent}}%;"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="card mt card-soft">
    <view class="card-bd">
      <view class="quick-grid quick-grid--compact">
        <view class="quick-item" bindtap="goOwner">
          <view class="quick-mark">馆</view>
          <view class="quick-label">馆长</view>
        </view>
        <view class="quick-item" bindtap="goDebugLogs">
          <view class="quick-mark">志</view>
          <view class="quick-label">日志</view>
        </view>
      </view>
    </view>
  </view>
</view>

