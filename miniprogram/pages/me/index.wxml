<view class="page">
  <view class="card card-soft card--card">
    <view class="card-bd">
      <view class="card-block">
        <view class="mycard mycard-render-box" style="width: {{myCardCssW}}px; height: {{myCardCssH}}px;">
          <image wx:if="{{myCardPreviewImage}}" class="mycard-render" src="{{myCardPreviewImage}}" mode="aspectFit" binderror="onCardPreviewImgError"></image>
          <view wx:elif="{{noCard && !cardSyncing}}" class="mycard-skeleton mycard-empty" bindtap="goProfileEdit">
            <view class="sk-empty">
              <view class="sk-empty__ic">🧗</view>
              <view class="sk-empty__t">还没有你的攀岩名片</view>
              <view class="sk-empty__d">点击编辑资料，填写信息后自动生成</view>
              <view class="sk-empty__btn">去创建</view>
            </view>
          </view>
          <view wx:else class="mycard-skeleton">
            <view class="sk-bar"></view>
            <view class="sk-row sk-row--1">
              <view class="sk-avatar"></view>
              <view class="sk-right">
                <view class="sk-line sk-line--w1"></view>
                <view class="sk-line sk-line--w2"></view>
                <view class="sk-line sk-line--w3"></view>
              </view>
            </view>
            <view class="sk-row sk-row--2">
              <view class="sk-chip"></view>
              <view class="sk-chip sk-chip--m"></view>
              <view class="sk-chip sk-chip--s"></view>
              <view class="sk-chip sk-chip--ok"></view>
            </view>
            <view class="sk-row sk-row--3">
              <view class="sk-meta"></view>
              <view class="sk-meta sk-meta--m"></view>
              <view class="sk-meta sk-meta--push"></view>
            </view>
            <view class="sk-row sk-row--4">
              <view class="sk-line sk-line--full"></view>
              <view class="sk-line sk-line--med"></view>
            </view>
            <view class="sk-ft">飞岩走壁 · 攀岩名片</view>
          </view>
        </view>
        <view class="mycard-foot-actions mycard-foot-actions--{{canSeeToolbox ? '3' : '2'}}">
          <view class="action-pill" catchtap="goSaveMyCard">保存</view>
          <view class="action-pill" catchtap="goProfileEdit">编辑资料</view>
          <view wx:if="{{canSeeToolbox}}" class="action-pill action-pill--gear" catchtap="onOpenDrawer">⚙</view>
        </view>
      </view>
    </view>
  </view>

  <view class="glance-grid mt-card">
    <view class="card glance-card glance-card--btn" bindtap="goFriendList">
      <view class="card-bd glance-bd">
        <view class="glance-top">
          <view class="glance-title">岩友</view>
          <view class="glance-mark glance-mark--friends">👥</view>
        </view>
        <view class="glance-cta mt-md">去列表 ›</view>
      </view>
    </view>
    <view class="card glance-card glance-card--btn" bindtap="goCircleList">
      <view class="card-bd glance-bd">
        <view class="glance-top">
          <view class="glance-title">岩友圈</view>
          <view class="glance-mark glance-mark--circles">🪢</view>
        </view>
        <view class="glance-cta mt-md">去列表 ›</view>
      </view>
    </view>
  </view>

  <view class="page-footpad"></view>

  <view class="drawer-mask {{drawerOpen?'drawer-mask--on':''}}" bindtap="onCloseDrawer"></view>
  <view class="drawer-panel {{drawerOpen?'drawer-panel--on':''}}" catchtap="noop">
    <view class="drawer-hd">
      <view class="drawer-hd__t">更多</view>
      <view class="drawer-hd__c" bindtap="onCloseDrawer">关闭</view>
    </view>
    <scroll-view scroll-y class="drawer-bd">
      <view class="drawer-grp">
        <view class="drawer-grp__t">岩馆相关</view>
        <view class="drawer-row" bindtap="goOwner">
          <text class="drawer-row__ic">🏔</text>
          <text class="drawer-row__t">馆长后台</text>
          <text class="drawer-row__arrow">›</text>
        </view>
        <view class="drawer-row" bindtap="goGymMerge">
          <text class="drawer-row__ic">🔗</text>
          <text class="drawer-row__t">岩馆合并</text>
          <text class="drawer-row__arrow">›</text>
        </view>
      </view>
      <view class="drawer-grp">
        <view class="drawer-grp__t">开发 & 管理</view>
        <view wx:if="{{canSeeToolbox}}" class="drawer-row" bindtap="goBackstage">
          <text class="drawer-row__ic">🛠</text>
          <text class="drawer-row__t">工具箱（管理员后台）</text>
          <text class="drawer-row__arrow">›</text>
        </view>
      </view>
      <view class="drawer-version">v{{version}}</view>
      <view class="drawer-bottom-spacer"></view>
    </scroll-view>
  </view>

  <view class="offscreen-canvas">
    <canvas canvas-id="myCardPreviewCanvas" class="offscreen-canvas__inner" width="960" height="606"></canvas>
  </view>
</view>
