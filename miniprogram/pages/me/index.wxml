<view class="page ui-v2 me-page">
  <!-- 身份区：头像 / 昵称 / 城市·岩友号 / 编辑 -->
  <view class="me-head">
    <image class="me-head__avatar" src="{{user.avatarUrl || defaultAvatar}}" mode="aspectFill" />
    <view class="me-head__main">
      <view class="me-head__name">{{user.nickName || '岩友'}}</view>
      <view class="me-head__meta">{{me.city ? me.city : '浪迹天涯'}}<text wx:if="{{me.rockId}}"> · 岩友号 {{me.rockId}}</text></view>
    </view>
    <button class="btn btn-ghost mini me-head__btn" bindtap="goProfileEdit">编辑</button>
  </view>

  <!-- 攀岩名片入口条：完整名片、分享与保存在 card-view 完成 -->
  <view class="card-entry" bindtap="goCardView">
    <view class="card-entry__thumb">
      <image wx:if="{{myCardPreviewImage}}" class="card-entry__img" src="{{myCardPreviewImage}}" mode="aspectFill" binderror="onCardPreviewImgError"></image>
      <text wx:else class="card-entry__thumb-ph">名片</text>
    </view>
    <view class="card-entry__main">
      <view class="card-entry__title">{{noCard ? '创建我的攀岩名片' : '我的攀岩名片'}}</view>
      <view class="card-entry__sub">{{cardSyncing ? '名片生成中…' : noCard ? '填写资料后自动生成' : '查看、分享与保存'}}</view>
    </view>
    <view class="card-entry__arrow">›</view>
  </view>

  <!-- 岩友 / 岩友圈：扁平双入口条 -->
  <view class="dual-row">
    <view class="dual-row__cell" bindtap="goFriendList">
      <text class="dual-row__t">我的岩友</text>
    </view>
    <view class="dual-row__divider"></view>
    <view class="dual-row__cell" bindtap="goCircleList">
      <text class="dual-row__t">岩友圈</text>
    </view>
  </view>

  <!-- 功能菜单：合并为一组，入口名自解释 -->
  <view class="menu-group">
    <view class="menu-row" bindtap="goRecords">
      <text class="menu-row__t">攀爬记录</text>
      <text class="menu-row__arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goNotifications">
      <text class="menu-row__t">约爬通知</text>
      <text class="menu-row__arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goSafety">
      <text class="menu-row__t">屏蔽与安全</text>
      <text class="menu-row__arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goOwner">
      <text class="menu-row__t">我管理的岩馆</text>
      <text class="menu-row__arrow">›</text>
    </view>
    <view wx:if="{{canSeeToolbox}}" class="menu-row" bindtap="onOpenDrawer">
      <text class="menu-row__t">管理工具</text>
      <text class="menu-row__sub">后台入口</text>
      <text class="menu-row__arrow">›</text>
    </view>
  </view>

  <view class="page-version">v{{version}}</view>
  <view class="page-footpad"></view>

  <!-- 馆长/管理员抽屉：岩馆合并等管理入口保留在此，结构与 handler 不变 -->
  <view class="drawer-mask {{drawerOpen?'drawer-mask--on':''}}" bindtap="onCloseDrawer"></view>
  <view class="drawer-panel {{drawerOpen?'drawer-panel--on':''}}" catchtap="noop">
    <view class="drawer-hd">
      <view class="drawer-hd__t">更多</view>
      <view class="btn-text" bindtap="onCloseDrawer">关闭</view>
    </view>
    <scroll-view scroll-y class="drawer-bd">
      <view class="drawer-grp">
        <view class="drawer-grp__t">岩馆相关</view>
        <view class="drawer-row" bindtap="goOwner">
          <text class="drawer-row__ic">🏔</text>
          <text class="drawer-row__t">馆长后台</text>
          <text class="drawer-row__arrow">›</text>
        </view>
        <view class="drawer-row" bindtap="goGymMerge">
          <text class="drawer-row__ic">🔗</text>
          <text class="drawer-row__t">岩馆合并</text>
          <text class="drawer-row__arrow">›</text>
        </view>
      </view>
      <view class="drawer-grp">
        <view class="drawer-grp__t">开发 & 管理</view>
        <view wx:if="{{canSeeToolbox}}" class="drawer-row" bindtap="goBackstage">
          <text class="drawer-row__ic">🛠</text>
          <text class="drawer-row__t">工具箱（管理员后台）</text>
          <text class="drawer-row__arrow">›</text>
        </view>
      </view>
      <view class="drawer-version">v{{version}}</view>
      <view class="drawer-bottom-spacer"></view>
    </scroll-view>
  </view>

  <!-- 离屏画布：960×606 固定尺寸，禁止改定位方式（名片导出/分享图依赖） -->
  <view class="offscreen-canvas">
    <canvas canvas-id="myCardPreviewCanvas" class="offscreen-canvas__inner" width="960" height="606"></canvas>
  </view>
</view>
