<import src="../../templates/profile-card.wxml" />

<view class="page">
  <view class="mycard-module">
    <view class="mycard-render-box" style="width: {{shareCanvasCssW}}px; height: {{shareCanvasCssH}}px; margin: 0 auto;" bindtap="goEditMyCard">
      <template
        is="profileCard"
        data="{{name: myCardView.displayName, title: myCardView.title, mbti: myCardView.mbti, gym: myCardView.gymLabel, one: myCardView.oneLiner, avatarSrc: (myCardView.avatarMode==='custom' ? myCardView.avatarFileId : myCardView.avatarUrl), brandText: '飞岩走壁 · 攀岩名片', showEditIcon: true}}"
      />
    </view>
    <view class="mycard-actions">
      <view class="mycard-action mycard-action--warn" catchtap="goGift">送出</view>
      <view class="mycard-action" catchtap="openShareActions">分享</view>
    </view>
  </view>

  <view class="glance-grid mt">
    <view class="card glance-card" bindtap="goWallet">
      <view class="card-bd glance-bd">
        <view class="glance-title">名片夹</view>
        <view class="glance-main">
          <view class="glance-value">{{receivedCount}}<text class="glance-unit">张</text></view>
        </view>
      </view>
    </view>

    <view class="card glance-card glance-card--credit">
      <view class="card-bd glance-bd">
        <view class="glance-title">灵感</view>
        <view class="glance-main">
          <view class="glance-value">{{credit.remaining}}<text class="glance-unit">/{{credit.limit}}</text></view>
        </view>
        <view class="credit-bar">
          <view class="credit-bar-fill" style="width: {{creditPercent}}%;"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="quick-grid quick-grid--compact mt">
    <view class="quick-item" bindtap="goOwner">
      <view class="quick-label">岩馆管理</view>
    </view>
    <view class="quick-item" bindtap="goBackstage">
      <view class="quick-label">开发工具</view>
    </view>
  </view>

  <canvas
    class="share-canvas"
    canvas-id="myCardCanvas"
    width="{{shareCanvasW}}"
    height="{{shareCanvasH}}"
    style="width: {{shareCanvasCssW}}px; height: {{shareCanvasCssH}}px;"
  ></canvas>

  <canvas
    class="share-canvas"
    canvas-id="shareCanvas"
    width="{{shareCanvasW}}"
    height="{{shareCanvasH}}"
    style="width: {{shareCanvasCssW}}px; height: {{shareCanvasCssH}}px;"
  ></canvas>

  <view wx:if="{{sharePickerVisible}}" class="mask" catchtouchmove="noop" bindtap="closeSharePicker">
    <view class="sheet" bindtap="noop">
      <view class="sheet-hd">
        <view class="sheet-title">分享名片</view>
        <view class="action-pill action-pill--ghost mini-pill" bindtap="closeSharePicker">关闭</view>
      </view>
      <view class="sheet-bd">
        <view class="action-pill action-pill--block" bindtap="onSavePreviewImage">保存图片</view>
        <button class="share-btn mt2" open-type="share">分享给好友</button>
      </view>
    </view>
  </view>
</view>

