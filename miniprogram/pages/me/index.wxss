.me {
  padding: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.me-name {
  font-size: 34rpx;
  font-weight: 900;
}

.me-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.mt {
  margin-top: 18rpx;
}

.mb {
  margin-bottom: 14rpx;
}

.row {
  display: flex;
  align-items: center;
}

.flex {
  flex: 1;
}

.ml {
  margin-left: 16rpx;
}

.mt2 {
  margin-top: 24rpx;
}

.mycard {
  border-radius: 18rpx;
  padding: 18rpx;
  background: rgba(143, 123, 255, 0.12);
  border: 1rpx solid rgba(143, 123, 255, 0.25);
}

.mycard-name {
  font-size: 38rpx;
  font-weight: 900;
}

.mycard-photo {
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
}

.thumbs {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  margin-right: 10rpx;
  margin-top: 10rpx;
  background: rgba(255, 255, 255, 0.06);
}

