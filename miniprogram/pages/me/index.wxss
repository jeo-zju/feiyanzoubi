/* 我的页：卡片/按钮/列表均使用全局体系，本文件只保留名片预览与侧边抽屉特有样式 */

.page {
  padding-top: calc(env(safe-area-inset-top) + 12rpx);
}

.page-footpad {
  height: calc(200rpx + env(safe-area-inset-bottom));
}

/* ---------- 攀岩名片预览 ---------- */
.card--card .card-bd {
  padding-top: 14rpx;
}

.card-block {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.mycard-render-box {
  background: #0f1223;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.45);
  position: relative;
  overflow: hidden;
  margin: 0 auto;
}

.mycard-render {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 24rpx;
}

.mycard-skeleton {
  width: 100%;
  height: 100%;
  padding: 26rpx 26rpx 22rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  position: relative;
  background: linear-gradient(145deg, #13162a, #0f1223);
}

.sk-bar {
  position: absolute;
  left: 26rpx;
  top: 26rpx;
  right: 26rpx;
  height: 12rpx;
  background: linear-gradient(90deg, #8f7bff, #f2c14e);
  border-radius: 14rpx;
  opacity: 0.7;
}

.sk-row {
  width: 100%;
  display: flex;
  align-items: center;
}

.sk-row--1 {
  margin-top: 30rpx;
  gap: 16rpx;
}

.sk-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(143, 123, 255, 0.22);
  border: 2rpx solid rgba(143, 123, 255, 0.35);
  flex-shrink: 0;
}

.sk-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.sk-line {
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
}

.sk-line--w1 {
  width: 46%;
}

.sk-line--w2 {
  width: 62%;
  background: rgba(255, 255, 255, 0.05);
}

.sk-line--w3 {
  width: 38%;
  background: rgba(242, 193, 78, 0.22);
}

.sk-row--2 {
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.sk-chip {
  height: 28rpx;
  border-radius: 999rpx;
  padding: 0 14rpx;
  min-width: 100rpx;
  background: rgba(143, 123, 255, 0.12);
  border: 1rpx solid rgba(143, 123, 255, 0.22);
}

.sk-chip--m {
  min-width: 100rpx;
}

.sk-chip--s {
  min-width: 90rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx dashed rgba(255, 255, 255, 0.1);
}

.sk-chip--ok {
  min-width: 60rpx;
  background: rgba(143, 200, 111, 0.12);
  border-color: rgba(143, 200, 111, 0.3);
}

.sk-row--3 {
  gap: 16rpx;
  margin-top: 10rpx;
}

.sk-meta {
  height: 18rpx;
  min-width: 120rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
}

.sk-meta--m {
  min-width: 112rpx;
}

.sk-meta--push {
  margin-left: auto;
  min-width: 160rpx;
  background: rgba(255, 255, 255, 0.05);
}

.sk-row--4 {
  margin: 10rpx 0 8rpx;
  flex-direction: column;
  align-items: flex-start;
  gap: 7rpx;
}

.sk-line--full {
  width: 96%;
  height: 22rpx;
  background: rgba(255, 255, 255, 0.08);
}

.sk-line--med {
  width: 74%;
  height: 22rpx;
  background: rgba(255, 255, 255, 0.07);
}

.sk-ft {
  margin-top: auto;
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.45);
  letter-spacing: 2rpx;
}

.mycard-foot-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.mycard-foot-actions .btn {
  flex: 1;
  min-width: 0;
}

/* 无名片空态 */
.mycard-empty {
  cursor: pointer;
}

.sk-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  gap: 10rpx;
  padding: 0 40rpx;
  text-align: center;
}

.sk-empty__ic {
  font-size: 72rpx;
  line-height: 1;
}

.sk-empty__t {
  font-size: 28rpx;
  font-weight: 700;
  color: #e7e9f3;
}

.sk-empty__d {
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.45);
}

.sk-empty__btn {
  margin-top: 12rpx;
}

/* ---------- 快捷入口卡片 ---------- */
.glance-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.glance-card--btn {
  position: relative;
  transition: transform 0.15s ease;
}

.glance-card--btn:active {
  transform: scale(0.97);
}

.glance-bd {
  padding: 20rpx 22rpx 22rpx;
}

.glance-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.glance-title {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(231, 233, 243, 0.78);
}

.glance-cta {
  font-size: 24rpx;
  font-weight: 600;
  color: #c5baff;
}

.glance-mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.glance-mark--friends {
  background: rgba(143, 123, 255, 0.18);
  border: 1rpx solid rgba(143, 123, 255, 0.32);
}

.glance-mark--circles {
  background: rgba(242, 193, 78, 0.16);
  border: 1rpx solid rgba(242, 193, 78, 0.32);
}

/* ---------- 侧边抽屉（工具箱） ---------- */
.drawer-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  z-index: 90;
}

.drawer-mask--on {
  opacity: 1;
  pointer-events: auto;
}

.drawer-panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 72%;
  max-width: 560rpx;
  background: #171b28;
  border-left: 1rpx solid #2b3044;
  transform: translateX(100%);
  transition: transform 0.22s ease;
  z-index: 95;
  display: flex;
  flex-direction: column;
}

.drawer-panel--on {
  transform: translateX(0);
}

.drawer-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 20rpx) 28rpx 18rpx;
  border-bottom: 1rpx solid #2b3044;
}

.drawer-hd__t {
  font-size: 32rpx;
  font-weight: 800;
  color: #e7e9f3;
}

.drawer-bd {
  flex: 1;
  min-height: 0;
  padding: 12rpx 20rpx 24rpx;
}

.drawer-bottom-spacer {
  height: calc(env(safe-area-inset-bottom) + 40rpx);
}

.drawer-version {
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.35);
  text-align: center;
  padding: 16rpx 0 4rpx;
  letter-spacing: 1rpx;
}

.drawer-grp {
  padding: 14rpx 6rpx 10rpx;
  margin-top: 10rpx;
}

.drawer-grp__t {
  font-size: 24rpx;
  color: #c5baff;
  letter-spacing: 2rpx;
  font-weight: 700;
  padding: 0 8rpx 10rpx;
}

.drawer-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 16rpx;
  border-radius: 16rpx;
  margin-bottom: 6rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.drawer-row:active {
  background: rgba(143, 123, 255, 0.1);
  border-color: rgba(143, 123, 255, 0.28);
}

.drawer-row__ic {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: rgba(143, 123, 255, 0.12);
  font-size: 28rpx;
  flex-shrink: 0;
}

.drawer-row__t {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(231, 233, 243, 0.9);
}

.drawer-row__arrow {
  flex-shrink: 0;
  font-size: 32rpx;
  color: rgba(231, 233, 243, 0.42);
}

.offscreen-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 960px;
  height: 606px;
}

.offscreen-canvas__inner {
  position: absolute;
  left: 0;
  top: 0;
  width: 960px;
  height: 606px;
  display: block;
}
