@import "../../styles/profile-card.wxss";

.mt {
  margin-top: 18rpx;
}

.mb {
  margin-bottom: 14rpx;
}

.row {
  display: flex;
  align-items: center;
}

.flex {
  flex: 1;
}

.ml {
  margin-left: 16rpx;
}

.mt2 {
  margin-top: 24rpx;
}

.mycard {
  border-radius: 22rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(143, 123, 255, 0.22), rgba(242, 193, 78, 0.10));
  border: 1rpx solid rgba(242, 193, 78, 0.18);
}

.mycard-render-box {
  position: relative;
  border-radius: 22rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
}

.mycard-module {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mycard-render {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 22rpx;
}

.mycard-render-ph {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(143, 123, 255, 0.22), rgba(242, 193, 78, 0.10));
}

.mycard-bar-title {
  position: absolute;
  left: 50%;
  top: 22rpx;
  transform: translateX(-50%);
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(11, 13, 21, 0.48);
  letter-spacing: 1rpx;
  white-space: nowrap;
  z-index: 2;
  pointer-events: none;
}

.card-img-box {
  margin: 0 auto;
  border-radius: 22rpx;
  overflow: hidden;
  position: relative;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
}

.card-ph {
  width: 100%;
  height: 100%;
  background: #0B0D15;
  display: flex;
  flex-direction: column;
}

.card-ph-bar {
  height: 18%;
  background: linear-gradient(90deg, rgba(143, 123, 255, 0.95), rgba(242, 193, 78, 0.95));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.card-ph-bar-side {
  width: 48rpx;
  height: 48rpx;
  flex: none;
}

.card-ph-bar-title {
  flex: 1;
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(11, 13, 21, 0.48);
  letter-spacing: 1rpx;
  text-align: center;
  white-space: nowrap;
}

.card-ph-body {
  flex: 1;
  padding: 26rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-ph-top {
  display: flex;
  align-items: center;
}

.card-ph-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 6rpx solid rgba(242, 193, 78, 0.85);
  box-sizing: border-box;
  flex: none;
}

.card-ph-right {
  flex: 1;
  margin-left: 20rpx;
}

.card-ph-name {
  font-size: 40rpx;
  font-weight: 900;
  color: #fff;
}

.card-ph-meta {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.92);
}

.card-ph-gym {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(242, 193, 78, 0.95);
}

.card-ph-one {
  margin-top: 16rpx;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.95);
}

.card-ph-edit {
  width: 48rpx;
  height: 48rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 900;
  color: rgba(11, 13, 21, 0.84);
  background: transparent;
  border: 0;
  box-shadow: none;
  transform: rotate(-18deg);
  transform-origin: center;
  opacity: 0.8;
}

.mycard--empty {
  padding: 0;
  background: #0B0D15;
  border: 1rpx solid rgba(242, 193, 78, 0.18);
  box-sizing: border-box;
  overflow: hidden;
}

.mycard-empty {
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(242, 193, 78, 0.95);
}

.mycard-ph {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.mycard-ph-bar {
  height: 18%;
  background: linear-gradient(90deg, rgba(143, 123, 255, 0.95), rgba(242, 193, 78, 0.95));
}

.mycard-ph-body {
  flex: 1;
  padding: 22rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: #0B0D15;
}

.mycard-ph-top {
  display: flex;
  align-items: center;
}

.mycard-ph-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 6rpx solid rgba(242, 193, 78, 0.85);
  box-sizing: border-box;
  flex: none;
}

.mycard-ph-right {
  flex: 1;
  margin-left: 18rpx;
}

.mycard-ph-name {
  font-size: 36rpx;
  font-weight: 900;
  color: #fff;
}

.mycard-ph-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

.mycard-ph-gym {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(242, 193, 78, 0.95);
}

.mycard-ph-badge {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #0B0D15;
  background: rgba(242, 193, 78, 0.95);
  flex: none;
}

.mycard-ph-one {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.95);
}

.mycard-name {
  font-size: 38rpx;
  font-weight: 900;
}

.mycard-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.mycard-head {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.mycard-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  flex: none;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.mycard-head-main {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.mycard-badge {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
  color: rgba(11, 13, 21, 0.84);
  background: transparent;
  position: absolute;
  right: 16rpx;
  top: 14rpx;
  z-index: 2;
  transform: rotate(-18deg);
}

.mycard-meta {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.82);
}

.mycard-one {
  margin-top: 14rpx;
  font-size: 30rpx;
  line-height: 1.35;
  color: rgba(255, 255, 255, 0.92);
}

.mycard-tip {
  margin-top: 10rpx;
}

.mycard-story {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.92);
}

.mycard-photo {
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
}

.mycard-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 18rpx;
}

.mycard-action,
.action-pill {
  min-width: 124rpx;
  height: 58rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(231, 233, 243, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(11, 13, 21, 0.36);
}

.mycard-action--warn {
  color: #f2c14e;
  border-color: rgba(242, 193, 78, 0.3);
  background: rgba(242, 193, 78, 0.16);
}

.action-pill--ghost {
  color: rgba(231, 233, 243, 0.82);
}

.action-pill--block {
  width: 100%;
}

.glance-grid {
  display: flex;
  gap: 14rpx;
}

.glance-card {
  flex: 1;
  min-width: 0;
}

.card-soft {
  background: rgba(255, 255, 255, 0.04);
}

.glance-card--credit {
  background: linear-gradient(135deg, rgba(143, 123, 255, 0.12), rgba(143, 123, 255, 0.05));
}

.glance-bd {
  padding-top: 14rpx;
}

.glance-main {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 8rpx;
}

.glance-title {
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.72);
}

.glance-value {
  font-size: 38rpx;
  line-height: 1;
  font-weight: 900;
  color: #fff;
}

.glance-unit {
  font-size: 22rpx;
  color: rgba(231, 233, 243, 0.62);
}

.credit-bar {
  margin-top: 14rpx;
  height: 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.08);
}

.credit-bar-fill {
  height: 100%;
  min-width: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(143, 123, 255, 0.95), rgba(242, 193, 78, 0.9));
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.quick-grid--compact {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.quick-item {
  min-width: 0;
  height: 76rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-item--warn {
  background: rgba(242, 193, 78, 0.09);
  border-color: rgba(242, 193, 78, 0.18);
}

.quick-label {
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(231, 233, 243, 0.88);
}

.share-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
  z-index: 2000;
}

.sheet {
  width: 100%;
  border-top-left-radius: 22rpx;
  border-top-right-radius: 22rpx;
  background: #0B0D15;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  padding: 18rpx;
  box-sizing: border-box;
}

.sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 900;
}

.sheet-bd {
  padding-bottom: 12rpx;
}

.mini-pill {
  min-width: 0;
  padding: 0 16rpx;
}

.share-btn {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  color: #0B0D15;
  background: linear-gradient(135deg, rgba(242, 193, 78, 0.98), rgba(250, 215, 110, 0.92));
  border: 0;
}

.share-btn::after {
  border: 0;
}

@media (max-width: 360px) {
  .quick-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

