.profile-shell {
  padding: 20rpx 22rpx;
  display: flex;
  align-items: center;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(143, 123, 255, 0.08));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.profile-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.profile-main {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 900;
  color: #fff;
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(231, 233, 243, 0.6);
}

.profile-tip {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: rgba(231, 233, 243, 0.42);
}

.profile-arrow {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  font-size: 30rpx;
  line-height: 1;
  color: rgba(231, 233, 243, 0.56);
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.mt {
  margin-top: 18rpx;
}

.mb {
  margin-bottom: 14rpx;
}

.row {
  display: flex;
  align-items: center;
}

.flex {
  flex: 1;
}

.ml {
  margin-left: 16rpx;
}

.mt2 {
  margin-top: 24rpx;
}

.mycard {
  border-radius: 22rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(143, 123, 255, 0.22), rgba(242, 193, 78, 0.10));
  border: 1rpx solid rgba(242, 193, 78, 0.18);
}

.mycard--empty {
  padding: 0;
  background: #0B0D15;
  border: 1rpx solid rgba(242, 193, 78, 0.18);
  box-sizing: border-box;
  overflow: hidden;
}

.mycard-empty {
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(242, 193, 78, 0.95);
}

.mycard-ph {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.mycard-ph-bar {
  height: 18%;
  background: linear-gradient(90deg, rgba(143, 123, 255, 0.95), rgba(242, 193, 78, 0.95));
}

.mycard-ph-body {
  flex: 1;
  padding: 22rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: #0B0D15;
}

.mycard-ph-top {
  display: flex;
  align-items: center;
}

.mycard-ph-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 6rpx solid rgba(242, 193, 78, 0.85);
  box-sizing: border-box;
  flex: none;
}

.mycard-ph-right {
  flex: 1;
  margin-left: 18rpx;
}

.mycard-ph-name {
  font-size: 36rpx;
  font-weight: 900;
  color: #fff;
}

.mycard-ph-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

.mycard-ph-gym {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(242, 193, 78, 0.95);
}

.mycard-ph-badge {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #0B0D15;
  background: rgba(242, 193, 78, 0.95);
  flex: none;
}

.mycard-ph-one {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.95);
}

.mycard-ph-ft {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
}

.mycard-name {
  font-size: 38rpx;
  font-weight: 900;
}

.mycard-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mycard-badge {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #0B0D15;
  background: rgba(242, 193, 78, 0.95);
}

.mycard-meta {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.82);
}

.mycard-one {
  margin-top: 14rpx;
  font-size: 30rpx;
  line-height: 1.35;
  color: rgba(255, 255, 255, 0.92);
}

.mycard-tip {
  margin-top: 10rpx;
}

.mycard-story {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.92);
}

.mycard-photo {
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
}

.action-pills {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.action-pill {
  min-width: 112rpx;
  height: 60rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(231, 233, 243, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.05);
}

.action-pill--warn {
  color: #f2c14e;
  border-color: rgba(242, 193, 78, 0.25);
  background: rgba(242, 193, 78, 0.12);
}

.thumbs {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  margin-right: 10rpx;
  margin-top: 10rpx;
  background: rgba(255, 255, 255, 0.06);
}

.thumbs--compact {
  margin-top: 16rpx;
  flex-wrap: nowrap;
}

.thumb--compact {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  margin-right: -10rpx;
  margin-top: 0;
  border: 4rpx solid #121624;
  box-sizing: border-box;
}

.thumb--ghost {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  margin-right: -10rpx;
  margin-top: 0;
  border: 4rpx solid #121624;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.05);
}

.glance-grid {
  display: flex;
  gap: 14rpx;
}

.glance-card {
  flex: 1;
  min-width: 0;
}

.card-soft {
  background: rgba(255, 255, 255, 0.04);
}

.glance-card--credit {
  background: linear-gradient(135deg, rgba(143, 123, 255, 0.12), rgba(143, 123, 255, 0.05));
}

.glance-bd {
  padding-top: 18rpx;
}

.glance-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.glance-title {
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.72);
}

.glance-value {
  font-size: 38rpx;
  line-height: 1;
  font-weight: 900;
  color: #fff;
}

.glance-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(231, 233, 243, 0.62);
}

.credit-bar {
  margin-top: 18rpx;
  height: 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.08);
}

.credit-bar-fill {
  height: 100%;
  min-width: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(143, 123, 255, 0.95), rgba(242, 193, 78, 0.9));
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  padding-top: 18rpx;
}

.quick-grid--compact {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.quick-item {
  min-width: 0;
  padding: 18rpx 10rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.quick-item--warn {
  background: rgba(242, 193, 78, 0.09);
  border-color: rgba(242, 193, 78, 0.18);
}

.quick-mark {
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(143, 123, 255, 0.16);
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
}

.quick-item--warn .quick-mark {
  background: rgba(242, 193, 78, 0.22);
  color: #f2c14e;
}

.quick-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(231, 233, 243, 0.8);
}

@media (max-width: 360px) {
  .quick-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

