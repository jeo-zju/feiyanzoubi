/* 我的页（v2 岩场邀请函）：身份页。主题版式见 styles/user-theme.wxss */
page {
  background: #151714;
}

/* 原生导航栏已处理状态栏安全区，页内不重复补偿（与首页 discover-page 对齐） */
.me-page {
  padding: 16rpx 32rpx 0;
}

.page-footpad {
  height: calc(80rpx + env(safe-area-inset-bottom));
}

/* ---------- 侧边抽屉（馆长/管理入口）：v2 配色 ---------- */
.drawer-mask {
  position: fixed;
  inset: 0;
  background: rgba(10, 12, 9, 0.66);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  z-index: 90;
}

.drawer-mask--on {
  opacity: 1;
  pointer-events: auto;
}

.drawer-panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 72%;
  max-width: 560rpx;
  background: #2B3029;
  border-left: 1rpx solid #383E34;
  transform: translateX(100%);
  transition: transform 0.22s ease;
  z-index: 95;
  display: flex;
  flex-direction: column;
}

.drawer-panel--on {
  transform: translateX(0);
}

.drawer-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 20rpx) 28rpx 18rpx;
  border-bottom: 1rpx solid #383E34;
}

.drawer-hd__t {
  font-size: 32rpx;
  font-weight: 700;
  color: #F3F1E7;
}

.drawer-bd {
  flex: 1;
  min-height: 0;
  padding: 12rpx 20rpx 24rpx;
}

.drawer-bottom-spacer {
  height: calc(env(safe-area-inset-bottom) + 40rpx);
}

.drawer-version {
  font-size: 24rpx;
  color: rgba(243, 241, 231, 0.35);
  text-align: center;
  padding: 16rpx 0 4rpx;
  letter-spacing: 1rpx;
}

.drawer-grp {
  padding: 14rpx 6rpx 10rpx;
  margin-top: 10rpx;
}

.drawer-grp__t {
  font-size: 24rpx;
  color: #D2EF72;
  letter-spacing: 2rpx;
  font-weight: 600;
  padding: 0 8rpx 10rpx;
}

.drawer-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 16rpx;
  border-radius: 16rpx;
  margin-bottom: 6rpx;
  background: #20241F;
  border: 1rpx solid #383E34;
}

.drawer-row:active {
  background: rgba(210, 239, 114, 0.1);
  border-color: rgba(210, 239, 114, 0.3);
}

.drawer-row__ic {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: rgba(210, 239, 114, 0.12);
  font-size: 28rpx;
  flex-shrink: 0;
}

.drawer-row__t {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #F3F1E7;
}

.drawer-row__arrow {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #969D90;
}

/* ---------- 离屏画布：960×606 固定尺寸，禁止改定位方式（名片导出依赖） ---------- */
.offscreen-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 960px;
  height: 606px;
}

.offscreen-canvas__inner {
  position: absolute;
  left: 0;
  top: 0;
  width: 960px;
  height: 606px;
  display: block;
}
