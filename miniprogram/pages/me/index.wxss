.me {
  padding: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.me-name {
  font-size: 34rpx;
  font-weight: 900;
}

.me-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.mt {
  margin-top: 18rpx;
}

.mb {
  margin-bottom: 14rpx;
}

.row {
  display: flex;
  align-items: center;
}

.flex {
  flex: 1;
}

.ml {
  margin-left: 16rpx;
}

.mt2 {
  margin-top: 24rpx;
}

.mycard {
  border-radius: 22rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(143, 123, 255, 0.22), rgba(242, 193, 78, 0.10));
  border: 1rpx solid rgba(242, 193, 78, 0.18);
}

.mycard--empty {
  padding: 0;
  background: #0B0D15;
  border: 1rpx solid rgba(242, 193, 78, 0.18);
  box-sizing: border-box;
  overflow: hidden;
}

.mycard-empty {
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(242, 193, 78, 0.95);
}

.mycard-ph {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.mycard-ph-bar {
  height: 18%;
  background: linear-gradient(90deg, rgba(143, 123, 255, 0.95), rgba(242, 193, 78, 0.95));
}

.mycard-ph-body {
  flex: 1;
  padding: 22rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: #0B0D15;
}

.mycard-ph-top {
  display: flex;
  align-items: center;
}

.mycard-ph-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 6rpx solid rgba(242, 193, 78, 0.85);
  box-sizing: border-box;
  flex: none;
}

.mycard-ph-right {
  flex: 1;
  margin-left: 18rpx;
}

.mycard-ph-name {
  font-size: 36rpx;
  font-weight: 900;
  color: #fff;
}

.mycard-ph-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
}

.mycard-ph-gym {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(242, 193, 78, 0.95);
}

.mycard-ph-badge {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #0B0D15;
  background: rgba(242, 193, 78, 0.95);
  flex: none;
}

.mycard-ph-one {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.95);
}

.mycard-ph-ft {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
}

.mycard-name {
  font-size: 38rpx;
  font-weight: 900;
}

.mycard-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mycard-badge {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #0B0D15;
  background: rgba(242, 193, 78, 0.95);
}

.mycard-badge--back {
  background: rgba(143, 123, 255, 0.95);
  color: #fff;
}

.mycard-meta {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.82);
}

.mycard-one {
  margin-top: 14rpx;
  font-size: 30rpx;
  line-height: 1.35;
  color: rgba(255, 255, 255, 0.92);
}

.mycard-tip {
  margin-top: 10rpx;
}

.mycard-story {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.92);
}

.mycard-photo {
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
}

.thumbs {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  margin-right: 10rpx;
  margin-top: 10rpx;
  background: rgba(255, 255, 255, 0.06);
}

.wallet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wallet-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.wallet-num {
  font-size: 40rpx;
  font-weight: 900;
  color: #F2C14E;
}

.wallet-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.wallet-credit {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(143, 123, 255, 0.95);
}

