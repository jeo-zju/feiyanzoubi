@import "../../app.wxss";

.page { padding-top: calc(env(safe-area-inset-top) + 12rpx); }

.muted { color: rgba(231,233,243,0.5); }
.mt-sm { margin-top: 10rpx; }
.page-footpad { height: calc(200rpx + env(safe-area-inset-bottom)); }

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 24rpx 6rpx;
}
.header-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}
.avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
  border: 2rpx solid rgba(255,255,255,0.08);
  flex-shrink: 0;
}
.header-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.header-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #E7E9F3;
  letter-spacing: 0.5rpx;
}
.header-sub {
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
}
.header-right {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.07);
}
.header-icon {
  font-size: 32rpx;
  color: rgba(231,233,243,0.82);
}

.card--card .card-bd { padding-top: 14rpx; }
.mycard-foot-actions { display: flex; gap: 16rpx; margin-top: 16rpx; justify-content: center; }
.mycard-foot-actions .action-pill { flex: 1; max-width: 240rpx; }
.mycard-foot-actions--3 .action-pill { max-width: none; }
.action-pill--gear { padding: 14rpx 10rpx; font-size: 26rpx; }

.card-bd--pb { padding-bottom: 26rpx; }
.section-kicker { font-size: 22rpx; letter-spacing: 2rpx; color: #8f7bff; text-transform: uppercase; font-weight: 700; }
.section-title { font-size: 32rpx; font-weight: 800; color: #E7E9F3; margin-top: 8rpx; }

.card-block { display: flex; flex-direction: column; align-items: stretch; }
.mycards { border-radius: 24rpx; box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.45); background: linear-gradient(145deg, #13162A, #0F1223); position: relative; overflow: hidden; margin: 0 auto; }
.mycard-render-box { background: #0F1223; border-radius: 24rpx; box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.45); background: linear-gradient(145deg, #13162A, #0F1223); position: relative; overflow: hidden; margin: 0 auto; }
.mycard-render { width: 100%; height: 100%; display: block; border-radius: 24rpx; }

.mycard-skeleton {
  width: 100%; height: 100%;
  padding: 26rpx 26rpx 22rpx; box-sizing: border-box;
  display: flex; flex-direction: column; position: relative;
  background: linear-gradient(145deg, #13162A, #0F1223);
}
.sk-bar {
  position: absolute; left: 26rpx; top: 26rpx; right: 26rpx;
  height: 12rpx; background: linear-gradient(90deg, #8F7BFF, #F2C14E);
  border-radius: 14rpx; opacity: 0.7;
}
.sk-row { width: 100%; display: flex; align-items: center; }
.sk-row--1 { margin-top: 30rpx; gap: 16rpx; }
.sk-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: rgba(143,123,255,0.22); border: 2rpx solid rgba(143,123,255,0.35); flex-shrink: 0; }
.sk-right { flex: 1; display: flex; flex-direction: column; gap: 5rpx; }
.sk-line { height: 14rpx; border-radius: 999rpx; background: rgba(255,255,255,0.06); }
.sk-line--w1 { width: 46%; }
.sk-line--w2 { width: 62%; background: rgba(255,255,255,0.05); }
.sk-line--w3 { width: 38%; background: rgba(242,193,78,0.22); }
.sk-row--2 { flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.sk-chip { height: 28rpx; border-radius: 999rpx; padding: 0 14rpx; min-width: 100rpx; background: rgba(143,123,255,0.12); border: 1rpx solid rgba(143,123,255,0.22); }
.sk-chip--m { min-width: 100rpx; }
.sk-chip--s { min-width: 90rpx; background: rgba(255,255,255,0.04); border: 1rpx dashed rgba(255,255,255,0.1); }
.sk-chip--ok { min-width: 60rpx; background: rgba(143,200,111,0.12); border-color: rgba(143,200,111,0.3); }
.sk-row--3 { gap: 16rpx; margin-top: 10rpx; }
.sk-meta { height: 18rpx; min-width: 120rpx; border-radius: 999rpx; background: rgba(255,255,255,0.06); }
.sk-meta--m { min-width: 112rpx; }
.sk-meta--push { margin-left: auto; min-width: 160rpx; background: rgba(255,255,255,0.05); }
.sk-row--4 { margin: 10rpx 0 8rpx; flex-direction: column; align-items: flex-start; gap: 7rpx; }
.sk-line--full { width: 96%; height: 22rpx; background: rgba(255,255,255,0.08); }
.sk-line--med { width: 74%; height: 22rpx; background: rgba(255,255,255,0.07); }
.sk-ft { margin-top: auto; font-size: 16rpx; color: rgba(231,233,243,0.45); letter-spacing: 2rpx; }

.mycard-foot-actions { display: flex; gap: 16rpx; margin-top: 16rpx; justify-content: center; }
.mycard-foot-actions .action-pill { flex: 1; max-width: 240rpx; }

.action-pill { padding: 14rpx 20rpx; border-radius: 999rpx; border: 1rpx solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03); color: rgba(231,233,243,0.8); font-size: 22rpx; text-align: center; transition: transform 0.15s ease, background 0.15s ease; }
.action-pill:active { transform: scale(0.97); background: rgba(255,255,255,0.06); }
.action-pill--warn { border-color: rgba(242,193,78,0.3); color: #E6C76A; }

.offscreen-canvas { position: absolute; left: 0; top: 0; width: 0; height: 0; overflow: hidden; }
.offscreen-canvas__inner { position: absolute; left: 0; top: 0; width: 960px; height: 606px; display: block; }

.glance-grid { margin-top: 16rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.slogan-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 30rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(242,193,78,0.14), rgba(242,193,78,0.05));
  border: 1rpx solid rgba(242,193,78,0.28);
}
.slogan-banner__text {
  font-size: 28rpx;
  color: #F2C14E;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.glance-grid--single { grid-template-columns: 1fr; }
.glance-card--btn {
  position: relative;
  transition: transform 0.15s ease;
}
.glance-card--btn:active { transform: scale(0.97); }
.glance-card--btn::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(180deg, rgba(143,123,255,0.08), transparent);
  pointer-events: none;
}
.glance-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.glance-title {
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(231,233,243,0.78);
  letter-spacing: 0.5rpx;
}
.glance-value {
  font-size: 38rpx;
  font-weight: 900;
  color: #E7E9F3;
}
.glance-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
}
.credit-bar {
  margin-top: 14rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.05);
  overflow: hidden;
}
.credit-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #F2C14E, #8F7BFF);
}
.glance-bd {
  padding: 20rpx 22rpx 22rpx;
}
.glance-cta {
  margin-top: 12rpx;
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(143,123,255,0.12);
  border: 1rpx solid rgba(143,123,255,0.3);
  color: #BDB6FF;
  font-size: 20rpx;
  font-weight: 600;
}
.glance-card--credit .glance-cta {
  background: rgba(242,193,78,0.12);
  border-color: rgba(242,193,78,0.32);
  color: #E6C76A;
}
.mt-card { margin-top: 16rpx; }
.mt-md { margin-top: 16rpx; }

.glance-mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.glance-mark--friends { background: rgba(143,123,255,0.18); border: 1rpx solid rgba(143,123,255,0.32); }
.glance-mark--circles { background: rgba(242,193,78,0.16); border: 1rpx solid rgba(242,193,78,0.32); }

.page-footpad { height: calc(200rpx + env(safe-area-inset-bottom)); }

.tool-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}
.tool-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 10rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(255,255,255,0.05);
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}
.tool-btn:active {
  transform: scale(0.96);
  background: rgba(143,123,255,0.1);
  border-color: rgba(143,123,255,0.32);
}
.tool-btn__mark {
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(143,123,255,0.35), rgba(143,123,255,0.15));
  border: 1rpx solid rgba(143,123,255,0.4);
  color: #E7E9F3;
  font-size: 26rpx;
  font-weight: 700;
}
.tool-btn__t { font-size: 22rpx; color: rgba(231,233,243,0.82); }

.heat-grid {
  display: grid;
  grid-template-columns: repeat(14, 1fr);
  gap: 6rpx;
  padding: 12rpx 0;
}
.heat-cell {
  width: 100%;
  aspect-ratio: 1/1;
  border-radius: 6rpx;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.05);
}
.heat--0 { background: rgba(255,255,255,0.04); }
.heat--1 { background: rgba(143,123,255,0.25); border-color: rgba(143,123,255,0.4); }
.heat--2 { background: rgba(143,123,255,0.45); border-color: rgba(143,123,255,0.6); }
.heat--3 { background: rgba(242,193,78,0.55); border-color: rgba(242,193,78,0.7); }

.foot-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}
.foot-cell {
  padding: 14rpx 14rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(255,255,255,0.05);
  text-align: center;
}
.foot-cell__num {
  font-size: 30rpx;
  font-weight: 800;
  color: #E7E9F3;
}
.foot-cell__k {
  margin-top: 4rpx;
  font-size: 20rpx;
  letter-spacing: 0.5rpx;
}

.drawer-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  z-index: 90;
}
.drawer-mask--on {
  opacity: 1;
  pointer-events: auto;
}
.drawer-panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 72%;
  max-width: 560rpx;
  background: #0F1223;
  border-left: 1rpx solid rgba(255,255,255,0.06);
  transform: translateX(100%);
  transition: transform 0.22s ease;
  z-index: 95;
  display: flex;
  flex-direction: column;
}
.drawer-panel--on {
  transform: translateX(0);
}
.drawer-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 20rpx) 28rpx 18rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}
.drawer-hd__t {
  font-size: 30rpx;
  font-weight: 800;
  color: #E7E9F3;
}
.drawer-hd__c {
  font-size: 22rpx;
  color: rgba(231,233,243,0.6);
}
.drawer-bd {
  flex: 1;
  min-height: 0;
  padding: 12rpx 20rpx 24rpx;
}
.drawer-bottom-spacer {
  height: calc(env(safe-area-inset-bottom) + 40rpx);
}
.drawer-version {
  font-size: 20rpx;
  color: rgba(231,233,243,0.35);
  text-align: center;
  padding: 16rpx 0 4rpx;
  letter-spacing: 1rpx;
}
.drawer-grp {
  padding: 14rpx 6rpx 10rpx;
  margin-top: 10rpx;
}
.drawer-grp__t {
  font-size: 22rpx;
  color: rgba(143,123,255,0.95);
  letter-spacing: 2rpx;
  text-transform: uppercase;
  font-weight: 700;
  padding: 0 8rpx 10rpx;
}
.drawer-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 16rpx;
  border-radius: 16rpx;
  margin-bottom: 6rpx;
  background: rgba(255,255,255,0.025);
  border: 1rpx solid rgba(255,255,255,0.05);
}
.drawer-row:active {
  background: rgba(143,123,255,0.1);
  border-color: rgba(143,123,255,0.28);
}
.drawer-row__ic {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: rgba(143,123,255,0.12);
  border: 1rpx solid rgba(143,123,255,0.28);
  font-size: 24rpx;
  flex-shrink: 0;
}
.drawer-row__t {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(231,233,243,0.9);
}
.drawer-row__arrow {
  flex-shrink: 0;
  font-size: 30rpx;
  color: rgba(231,233,243,0.35);
  font-weight: 500;
}
