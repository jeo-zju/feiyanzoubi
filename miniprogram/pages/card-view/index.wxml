<view class="page">
  <view class="card card-hero">
    <view class="card-bd">
      <view class="hero-hd">
        <view class="hero-title">把这张嘴硬存下来</view>
        <view class="hero-sub muted">所见即所得，直接保存这张名片。</view>
      </view>

      <canvas
        canvas-id="cardCanvas"
        class="canvas"
        style="width: {{canvasCssW}}px; height: {{canvasCssH}}px;"
        width="{{canvasW}}"
        height="{{canvasH}}"
      ></canvas>

      <view class="row mt2">
        <view class="btn btn-primary flex" bindtap="onSaveCard">保存名片</view>
      </view>
    </view>
  </view>
</view>
