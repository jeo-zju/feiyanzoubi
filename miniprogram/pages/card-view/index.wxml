<view class="page">
  <view class="card card-hero card--canvas">
    <view wx:if="{{isMine}}" class="icon-btn hero-menu" bindtap="onOpenMenu">⋯</view>
    <view class="card-bd">
      <view class="section-title-lg">把这张嘴硬存下来</view>
      <view class="section-desc">保存到相册</view>

      <canvas
        canvas-id="cardCanvas"
        class="canvas mt"
        style="width: {{canvasCssW}}px; height: {{canvasCssH}}px;"
        width="{{canvasW}}"
        height="{{canvasH}}"
      ></canvas>

      <view class="btn btn-primary btn--block mt" bindtap="onSave">保存到相册</view>
    </view>
  </view>
</view>
