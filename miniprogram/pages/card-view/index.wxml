<view class="page">
  <view class="card card-hero">
    <view wx:if="{{isMine}}" class="hero-menu" bindtap="onOpenMenu">⋯</view>
    <view class="card-bd">
      <view class="hero-hd">
        <view class="hero-title">把这张嘴硬存下来</view>
        <view class="hero-sub muted">保存到相册</view>
      </view>

      <canvas
        canvas-id="cardCanvas"
        class="canvas"
        style="width: {{canvasCssW}}px; height: {{canvasCssH}}px;"
        width="{{canvasW}}"
        height="{{canvasH}}"
      ></canvas>

      <view class="btn btn-primary flex mt2" bindtap="onSave">保存到相册</view>
    </view>
  </view>
</view>

