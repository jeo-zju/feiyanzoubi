/* 名片完整预览（compact）：等比卡面 → 分享/保存一组操作 */
page {
  background: #151714;
}

.cv-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.cv-topbar {
  display: flex;
  justify-content: flex-end;
  padding: 12rpx 24rpx 0;
  min-height: 72rpx;
}

.cv-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 32rpx 24rpx;
}

.cv-canvas {
  border-radius: 18rpx;
  background: #0B0D15;
  border: 1rpx solid #383E34;
  max-width: 100%;
}

.cv-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #969D90;
}

/* 底栏：分享（次） + 保存（主） */
.cv-actions {
  display: flex;
  gap: 20rpx;
}

.cv-actions .btn {
  flex: 1;
  min-width: 0;
}
