@import "../../styles/profile-card.wxss";

.textarea {
  width: 100%;
  min-height: 160rpx;
  border-radius: 16rpx;
  padding: 18rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.06);
  color: #fff;
}

.row {
  display: flex;
  align-items: center;
}

.flex {
  flex: 1;
}

.ml {
  margin-left: 16rpx;
}

.mt2 {
  margin-top: 24rpx;
}

.mt {
  margin-top: 16rpx;
}

.photo-tip {
  line-height: 1.5;
}

.card-hero {
  background: linear-gradient(135deg, rgba(143, 123, 255, 0.18), rgba(242, 193, 78, 0.08));
  border: 1rpx solid rgba(143, 123, 255, 0.22);
}

.field {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.label {
  width: 120rpx;
  flex: none;
}

.select {
  display: flex;
  align-items: center;
  color: rgba(255, 255, 255, 0.9);
}

.tag-hero {
  background: rgba(242, 193, 78, 0.14);
  border-color: rgba(242, 193, 78, 0.22);
  color: #f2c14e;
}

.pv {
  display: flex;
  align-items: flex-start;
}

.pv-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  flex: none;
}

.pv-main {
  flex: 1;
  margin-left: 16rpx;
}

.pv-name {
  font-size: 34rpx;
  font-weight: 900;
}

.pv-meta {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.pv-pill {
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: rgba(231, 233, 243, 0.92);
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
}

.pv-pill--y {
  background: rgba(242, 193, 78, 0.16);
  border-color: rgba(242, 193, 78, 0.28);
  color: rgba(242, 193, 78, 0.95);
}

.pv-pill--p {
  background: rgba(143, 123, 255, 0.16);
  border-color: rgba(143, 123, 255, 0.28);
}

.pv-one {
  margin-top: 12rpx;
  color: rgba(231, 233, 243, 0.92);
  font-size: 26rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.pv-back {
  flex-direction: column;
}

.pv-back-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pv-back-title {
  font-size: 30rpx;
  font-weight: 900;
}

.pv-back-st {
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.65);
}

.pv-back-story {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(231, 233, 243, 0.92);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 5;
  -webkit-box-orient: vertical;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
  z-index: 2000;
}

.sheet {
  width: 100%;
  border-top-left-radius: 22rpx;
  border-top-right-radius: 22rpx;
  background: #0B0D15;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  padding: 18rpx;
  box-sizing: border-box;
}

.sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 900;
}

.sheet-bd {
  padding-bottom: 12rpx;
}

.list {
  max-height: 520rpx;
  margin-top: 16rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.item {
  padding: 12rpx 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
}

.item--on {
  background: rgba(242, 193, 78, 0.18);
  border: 1rpx solid rgba(242, 193, 78, 0.35);
}

.item--ghost {
  background: rgba(143, 123, 255, 0.14);
  border: 1rpx solid rgba(143, 123, 255, 0.28);
}

.card-img-box {
  margin: 0 auto;
  border-radius: 22rpx;
  overflow: hidden;
  position: relative;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
}

.card-img {
  width: 100%;
  height: 100%;
  display: block;
}

.card-hit {
  position: absolute;
  z-index: 2;
}

.card-hit--avatar {
  left: 22rpx;
  top: 96rpx;
  width: 126rpx;
  height: 126rpx;
  border-radius: 66rpx;
}

.card-hit--name {
  left: 164rpx;
  top: 104rpx;
  right: 64rpx;
  height: 40rpx;
}

.card-hit--title {
  left: 164rpx;
  top: 150rpx;
  right: 72rpx;
  height: 34rpx;
}

.card-hit--mbti {
  left: 164rpx;
  top: 206rpx;
  width: 102rpx;
  height: 40rpx;
}

.card-hit--gym {
  left: 266rpx;
  top: 206rpx;
  right: 72rpx;
  height: 40rpx;
}

.card-hit--one {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 268rpx;
  bottom: 24rpx;
  z-index: 2;
}

.canvas-hidden {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  pointer-events: none;
}

.avatar-sheet-btn {
  width: 100%;
  box-sizing: border-box;
}
