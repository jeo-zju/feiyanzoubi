.textarea {
  width: 100%;
  min-height: 160rpx;
  border-radius: 16rpx;
  padding: 18rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.06);
  color: #fff;
}

.row {
  display: flex;
  align-items: center;
}

.flex {
  flex: 1;
}

.ml {
  margin-left: 16rpx;
}

.mt2 {
  margin-top: 24rpx;
}

.mt {
  margin-top: 16rpx;
}

.card-hero {
  background: linear-gradient(135deg, rgba(143, 123, 255, 0.18), rgba(242, 193, 78, 0.08));
  border: 1rpx solid rgba(143, 123, 255, 0.22);
}

.field {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.label {
  width: 120rpx;
  flex: none;
}

.select {
  display: flex;
  align-items: center;
  color: rgba(255, 255, 255, 0.9);
}

.tag-hero {
  background: rgba(242, 193, 78, 0.14);
  border-color: rgba(242, 193, 78, 0.22);
  color: #f2c14e;
}

.pv {
  display: flex;
  align-items: flex-start;
}

.pv-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  flex: none;
}

.pv-main {
  flex: 1;
  margin-left: 16rpx;
}

.pv-name {
  font-size: 34rpx;
  font-weight: 900;
}

.pv-meta {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.pv-pill {
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: rgba(231, 233, 243, 0.92);
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
}

.pv-pill--y {
  background: rgba(242, 193, 78, 0.16);
  border-color: rgba(242, 193, 78, 0.28);
  color: rgba(242, 193, 78, 0.95);
}

.pv-pill--p {
  background: rgba(143, 123, 255, 0.16);
  border-color: rgba(143, 123, 255, 0.28);
}

.pv-one {
  margin-top: 12rpx;
  color: rgba(231, 233, 243, 0.92);
  font-size: 26rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.pv-back {
  flex-direction: column;
}

.pv-back-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pv-back-title {
  font-size: 30rpx;
  font-weight: 900;
}

.pv-back-st {
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.65);
}

.pv-back-story {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(231, 233, 243, 0.92);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 5;
  -webkit-box-orient: vertical;
}

.gear-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  flex: none;
}

.gear-icon {
  font-size: 36rpx;
  font-weight: 900;
  color: rgba(242, 193, 78, 0.95);
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
  z-index: 2000;
}

.sheet {
  width: 100%;
  border-top-left-radius: 22rpx;
  border-top-right-radius: 22rpx;
  background: #0B0D15;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  padding: 18rpx;
  box-sizing: border-box;
}

.sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 900;
}

.sheet-bd {
  padding-bottom: 12rpx;
}

.list {
  max-height: 520rpx;
  margin-top: 16rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.item {
  padding: 12rpx 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
}

.item--on {
  background: rgba(242, 193, 78, 0.18);
  border: 1rpx solid rgba(242, 193, 78, 0.35);
}

.item--ghost {
  background: rgba(143, 123, 255, 0.14);
  border: 1rpx solid rgba(143, 123, 255, 0.28);
}

.card-img-box {
  margin: 0 auto;
  border-radius: 22rpx;
  overflow: hidden;
  position: relative;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
}

.card-img {
  width: 100%;
  height: 100%;
  display: block;
}

.canvas-hidden {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  pointer-events: none;
}

.card-ph {
  width: 100%;
  height: 100%;
  background: #0B0D15;
  display: flex;
  flex-direction: column;
}

.card-ph-bar {
  height: 18%;
  background: linear-gradient(90deg, rgba(143, 123, 255, 0.95), rgba(242, 193, 78, 0.95));
}

.card-ph-body {
  flex: 1;
  padding: 26rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-ph-top {
  display: flex;
  align-items: center;
}

.card-ph-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 6rpx solid rgba(242, 193, 78, 0.85);
  box-sizing: border-box;
  flex: none;
}

.card-ph-right {
  flex: 1;
  margin-left: 20rpx;
}

.card-ph-name {
  font-size: 40rpx;
  font-weight: 900;
  color: #fff;
}

.card-ph-meta {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.92);
}

.card-ph-gym {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(242, 193, 78, 0.95);
}

.card-ph-one {
  margin-top: 18rpx;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.95);
}

.card-ph-ft {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
}
