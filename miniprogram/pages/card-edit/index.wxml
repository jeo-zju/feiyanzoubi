<view class="page">
  <view class="card card-hero">
    <view class="card-hd">
      <view class="row">
        <view class="flex">我的名片</view>
        <view class="tag tag-hero">{{previewSide==='front'?'正面':'反面'}}</view>
      </view>
    </view>
    <view class="card-bd">
      <view class="card-img-box" style="width: {{cardCssW}}px; height: {{cardCssH}}px;" bindtap="togglePreviewSide">
        <image wx:if="{{!showPlaceholder && previewImage}}" class="card-img" src="{{previewImage}}" mode="aspectFit" show-menu-by-longpress="{{true}}" />
        <view wx:else class="card-ph">
          <view class="card-ph-bar"></view>
          <view class="card-ph-body">
            <view class="card-ph-top">
              <view class="card-ph-avatar"></view>
              <view class="card-ph-right">
                <view class="card-ph-name">岩点测试员</view>
                <view class="card-ph-meta">长臂猿 · ENTP</view>
                <view class="card-ph-gym">浪迹天涯</view>
              </view>
            </view>
            <view class="card-ph-one">用脚点谈判，用手点签字。</view>
            <view class="card-ph-ft">飞岩走壁 · 攀岩名片</view>
          </view>
        </view>
        <canvas
          class="canvas-hidden"
          canvas-id="previewCanvas"
          width="{{cardPxW}}"
          height="{{cardPxH}}"
          style="width: {{cardCssW}}px; height: {{cardCssH}}px;"
        ></canvas>
      </view>
    </view>
  </view>

  <view class="card mt">
    <view class="card-hd">{{storyTitle}}</view>
    <view class="card-bd">
      <textarea class="textarea" placeholder="{{storyPlaceholder}}" placeholder-class="ph" value="{{back.story}}" bindinput="onStory" />
      <view class="row mt2">
        <view class="btn btn-ghost flex" bindtap="pickPhoto">选照片</view>
        <view class="btn btn-warn flex ml" bindtap="onGenerate">生成一句</view>
      </view>
      <view wx:if="{{front.oneLiner}}" class="muted mt2">预览：{{front.oneLiner}}</view>
    </view>
  </view>

  <view class="card mt" wx:if="{{moreOpen}}">
    <view class="card-hd">更多设置</view>
    <view class="card-bd">
      <view class="field">
        <view class="label muted">名字</view>
        <input class="input flex" placeholder="微信名或自定义" placeholder-class="ph" value="{{front.displayName}}" bindinput="onName" />
      </view>

      <view class="field mt2">
        <view class="label muted">头衔</view>
        <view class="input flex select" bindtap="openTitlePicker">{{front.title || '点击选择'}}</view>
      </view>

      <view class="field mt2">
        <view class="label muted">MBTI</view>
        <view class="input flex select" bindtap="openMbtiPicker">{{front.mbti || '点击选择（可不填）'}}</view>
      </view>

      <view class="field mt2">
        <view class="label muted">常去岩馆</view>
        <view class="row flex">
          <switch checked="{{front.wanderer}}" bindchange="onWanderer" />
          <view class="muted ml">浪迹天涯</view>
        </view>
      </view>
      <input
        class="input"
        placeholder="最多3家，用逗号分隔"
        placeholder-class="ph"
        value="{{gymsText}}"
        bindinput="onGymsText"
        disabled="{{front.wanderer}}"
      />

      <view class="field mt2">
        <view class="label muted">头像</view>
        <view class="row flex">
          <view class="btn btn-ghost" bindtap="setAvatarWechat">用微信</view>
          <view class="btn btn-ghost ml" bindtap="pickAvatar">自定义</view>
          <view wx:if="{{front.avatarMode==='custom' && front.avatarFileId}}" class="muted ml">已设置</view>
        </view>
      </view>

      <view class="mt2">
        <seg-tabs tabs="{{styleTabs}}" value="{{oneLinerStyle}}" bind:change="onStyleChange" />
        <textarea class="textarea mt2" placeholder="一句话介绍（可选，保存会消耗一次 credit）" placeholder-class="ph" value="{{front.oneLiner}}" bindinput="onOneLiner" />
      </view>
    </view>
  </view>

  <view class="row mt2">
    <view class="btn btn-ghost gear-btn" bindtap="toggleMore">
      <view class="gear-icon">⚙</view>
    </view>
    <view class="btn btn-primary flex ml" bindtap="onSave">保存名片（消耗1次灵感）</view>
  </view>

  <view wx:if="{{pickerVisible}}" class="mask" catchtouchmove="noop" bindtap="closePicker">
    <view class="sheet" bindtap="noop">
      <view class="sheet-hd">
        <view class="sheet-title">{{pickerType==='title'?'选择头衔':'选择 MBTI'}}</view>
        <view class="btn btn-ghost mini" bindtap="closePicker">关闭</view>
      </view>

      <view class="sheet-bd" wx:if="{{pickerType==='title'}}">
        <input class="input" placeholder="也可自定义输入" placeholder-class="ph" value="{{front.title}}" bindinput="onTitle" />
        <scroll-view scroll-y class="list">
          <view class="grid">
            <view class="item item--ghost" bindtap="pickRandomTitle">随机一个</view>
            <view wx:for="{{filteredTitles}}" wx:key="t" class="item {{front.title===item?'item--on':''}}" data-v="{{item}}" bindtap="selectTitle">
              {{item}}
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="sheet-bd" wx:if="{{pickerType==='mbti'}}">
        <view class="grid">
          <view wx:for="{{mbtiOptions}}" wx:key="m" class="item {{front.mbti===item?'item--on':''}}" data-v="{{item}}" bindtap="selectMbti">
            {{item}}
          </view>
        </view>
        <view class="row mt2">
          <view class="btn btn-ghost flex" bindtap="onClearMbti">清空</view>
        </view>
      </view>
    </view>
  </view>
</view>
