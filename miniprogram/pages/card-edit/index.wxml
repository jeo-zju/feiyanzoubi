<import src="../../templates/profile-card.wxml" />

<view class="page">
  <view class="card card-hero">
    <view class="card-hd">
      <view class="row">
        <view class="flex">我的名片</view>
      </view>
    </view>
    <view class="card-bd">
      <view class="card-img-box" style="width: {{cardCssW}}px; height: {{cardCssH}}px;">
        <template
          is="profileCard"
          data="{{name: (front.displayName || defaultPreview.displayName), title: (front.title || defaultPreview.title), mbti: front.mbti, gym: (previewGymsLabel || defaultPreview.gymLabel), one: (front.oneLiner || defaultPreview.oneLiner), avatarSrc: (front.avatarMode==='custom' ? front.avatarFileId : (front.avatarUrl || userAvatarUrl)), brandText: '飞岩走壁 · 攀岩名片', showEditIcon: false, showInlineEditors: true}}"
        />
        <view class="card-hit card-hit--avatar" bindtap="openAvatarEditor"></view>
        <view class="card-hit card-hit--one" bindtap="openStoryEditor"></view>
        <canvas
          class="canvas-hidden"
          canvas-id="previewCanvas"
          width="{{cardPxW}}"
          height="{{cardPxH}}"
          style="width: {{cardCssW}}px; height: {{cardCssH}}px;"
        ></canvas>
      </view>
    </view>
  </view>

  <view class="row mt2">
    <view class="btn btn-primary flex" bindtap="onSave">保存名片</view>
  </view>

  <view wx:if="{{pickerVisible}}" class="mask" catchtouchmove="noop" bindtap="closePicker">
    <view class="sheet" catchtap="noop">
      <view class="sheet-hd">
        <view class="sheet-title">
          {{pickerType==='title'?'选择头衔':pickerType==='mbti'?'选择 MBTI':pickerType==='name'?'修改名字':pickerType==='story'?'编辑素材':pickerType==='gyms'?'编辑岩馆':'修改头像'}}
        </view>
        <view class="btn btn-ghost mini" bindtap="closePicker">关闭</view>
      </view>

      <view class="sheet-bd" wx:if="{{pickerType==='title'}}">
        <input class="input" placeholder="也可自定义输入" placeholder-class="ph" value="{{front.title}}" bindinput="onTitle" />
        <scroll-view scroll-y class="list">
          <view class="grid">
            <view class="item item--ghost" bindtap="pickRandomTitle">随机一个</view>
            <view wx:for="{{filteredTitles}}" wx:key="t" class="item {{front.title===item?'item--on':''}}" data-v="{{item}}" bindtap="selectTitle">
              {{item}}
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="sheet-bd" wx:if="{{pickerType==='mbti'}}">
        <view class="grid">
          <view wx:for="{{mbtiOptions}}" wx:key="m" class="item {{front.mbti===item?'item--on':''}}" data-v="{{item}}" bindtap="selectMbti">
            {{item}}
          </view>
        </view>
        <view class="row mt2">
          <view class="btn btn-ghost flex" bindtap="onClearMbti">清空</view>
        </view>
      </view>

      <view class="sheet-bd" wx:if="{{pickerType==='name'}}">
        <input
          class="input"
          type="text"
          placeholder="输入自定义昵称"
          placeholder-class="ph"
          value="{{front.displayName}}"
          bindinput="onName"
        />
        <view class="muted mt">可以直接自定义，也可以一键带入当前微信昵称。</view>
        <view class="row mt2">
          <view class="btn btn-ghost flex" bindtap="useWechatNickName">使用微信昵称</view>
        </view>
      </view>

      <view class="sheet-bd" wx:if="{{pickerType==='story'}}">
        <seg-tabs tabs="{{styleTabs}}" value="{{oneLinerStyle}}" bind:change="onStyleChange" />
        <textarea class="textarea mt2" placeholder="一句话介绍（可手动改）" placeholder-class="ph" value="{{front.oneLiner}}" bindinput="onOneLiner" />
        <textarea class="textarea" placeholder="{{storyPlaceholder}}" placeholder-class="ph" value="{{back.story}}" bindinput="onStory" />
        <view class="muted mt photo-tip">照片会作为同一张名片的氛围背景使用。</view>
        <view class="row mt2">
          <view class="btn btn-ghost flex" bindtap="pickPhoto">照片</view>
          <view class="btn btn-warn flex ml" bindtap="onGenerate">生成一句</view>
        </view>
      </view>

      <view class="sheet-bd" wx:if="{{pickerType==='gyms'}}">
        <view class="field">
          <view class="label muted">常去岩馆</view>
          <view class="row flex">
            <switch checked="{{front.wanderer}}" bindchange="onWanderer" />
            <view class="muted ml">浪迹天涯</view>
          </view>
        </view>
        <input
          class="input"
          placeholder="最多3家，用逗号分隔"
          placeholder-class="ph"
          value="{{gymsText}}"
          bindinput="onGymsText"
          disabled="{{front.wanderer}}"
        />
      </view>

      <view class="sheet-bd" wx:if="{{pickerType==='avatar'}}">
        <button class="btn btn-ghost avatar-sheet-btn" open-type="chooseAvatar" bindchooseavatar="onChooseWechatAvatar">同步微信头像</button>
        <view class="btn btn-ghost mt2 avatar-sheet-btn" bindtap="pickAvatar">自定义头像</view>
      </view>
    </view>
  </view>
</view>
