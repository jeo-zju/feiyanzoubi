.viewport-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.viewport-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 18rpx;
}

.mt {
  margin-top: 20rpx;
}

.ml {
  margin-left: 12rpx;
}

.flex {
  flex: 1;
}

.action-row {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
}

.break-all {
  word-break: break-all;
}

.gym-item {
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.gym-item:first-child {
  border-top: none;
}

.item-title {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}

.meta-stack {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(231, 233, 243, 0.62);
  word-break: break-all;
}

.json-block {
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 22rpx;
  line-height: 1.55;
  color: rgba(231, 233, 243, 0.82);
  white-space: pre-wrap;
  word-break: break-all;
}

.empty {
  color: rgba(231, 233, 243, 0.58);
}
