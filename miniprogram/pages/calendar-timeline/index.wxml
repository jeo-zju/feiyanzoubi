<view class="page ui-v2 tl-page">
  <!-- 日期 / 星期一行（发起约爬统一在首页，这里不放发布按钮） -->
  <view class="tl-title">
    <text class="tl-title__date">{{dateLabel}}</text>
    <text class="tl-title__week">{{weekLabel}}</text>
  </view>

  <!-- 城市 / 岩馆筛选 -->
  <view class="tl-filters">
    <view class="field-select tl-filter" bindtap="onTapCity">
      <text class="field-select__value {{city ? '' : 'ph'}}">{{city || '选择城市'}}</text>
      <text class="field-select__arrow">⌄</text>
    </view>
    <view class="field-select tl-filter" bindtap="onTapGymFilter">
      <text class="field-select__value">{{gymLabel}}</text>
      <text class="field-select__arrow">⌄</text>
    </view>
  </view>
  <seg-tabs class="tl-tabs" theme="v2" tabs="{{visibilityTabs}}" value="{{visibility}}" bind:change="onVisibilityChange" />

  <!-- 当天时间轴：列头与轴体在同一个横向滚动里，纵向随页面自然滚动 -->
  <view class="card tl-card">
    <block wx:if="{{colList.length > 0}}">
      <view class="tl-count">{{userCount}} 位岩友当天有安排</view>
      <scroll-view scroll-x class="tl-scroll" enhanced show-scrollbar="{{false}}">
        <view class="tl-inner" style="width: {{92 + colsWidth}}rpx;">
          <!-- 头像列头 -->
          <view class="tl-head">
            <view class="tl-corner"></view>
            <view class="tl-headcols" style="width: {{colsWidth}}rpx;">
              <view wx:for="{{colList}}" wx:key="uid" class="tl-headcol" style="width: {{colWidth}}rpx;" data-uid="{{item.uid}}" bindtap="onTapAvatar">
                <image class="tl-headcol__img" src="{{item.avatarUrl || defaultAvatar}}" mode="aspectFill"></image>
                <text class="tl-headcol__name">{{item.displayName || item.nickName || '岩友'}}</text>
              </view>
            </view>
          </view>
          <!-- 时间刻度 + 计划列 -->
          <view class="tl-axis">
            <view class="tl-timecol">
              <view wx:for="{{hourTicks}}" wx:key="h" class="tl-tick">{{item.label}}</view>
              <view class="tl-tick tl-tick--ghost"></view>
            </view>
            <view class="tl-cols" style="width: {{colsWidth}}rpx;">
              <view wx:for="{{colList}}" wx:for-index="colIdx" wx:key="uid" class="tl-col" style="width: {{colWidth}}rpx;">
                <view wx:for="{{item.bars}}" wx:key="id" class="tl-bar" style="top:{{item.topPx}}rpx;height:{{item.hPx}}rpx;" data-id="{{item.id}}" catchtap="onTapBar">
                  <view class="tl-bar__time">{{item.rangeText}}</view>
                  <view wx:if="{{item.showGym}}" class="tl-bar__gym">{{item.gymName || '攀岩'}}</view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </block>
    <view wx:else class="empty-state tl-empty">
      <view class="empty-state__title">当天还没有约爬</view>
      <view class="empty-state__desc">换个城市、岩馆或可见范围看看</view>
    </view>
  </view>

  <!-- 城市选择 -->
  <view wx:if="{{cityPickerVisible}}" class="sheet-mask" bindtap="onCloseCityPicker" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet__hd">
        <text class="sheet__title">选择城市</text>
        <view class="sheet__close" bindtap="onCloseCityPicker">✕</view>
      </view>
      <scroll-view class="sheet__bd" scroll-y>
        <view class="sheet-item" wx:for="{{cityOptions}}" wx:key="name"
          data-city="{{item.name}}"
          data-custom="{{item.custom || false}}"
          bindtap="onPickCity">
          <text class="sheet-item__label">{{item.name}}</text>
          <text wx:if="{{city === item.name}}" class="sheet-item__check">✓</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 岩馆选择 -->
  <view wx:if="{{gymPickerVisible}}" class="sheet-mask" bindtap="onCloseGymPicker" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet__hd">
        <text class="sheet__title">选择岩馆</text>
        <view class="sheet__close" bindtap="onCloseGymPicker">✕</view>
      </view>
      <view class="sheet__search">
        <view class="searchbar">
          <text class="searchbar__ic">🔍</text>
          <input class="searchbar__input" placeholder="搜索岩馆名称 / 地址" value="{{gymKeyword}}" confirm-type="search" bindinput="onGymKeywordInput" bindconfirm="onGymKeywordInput" placeholder-class="ph" />
        </view>
      </view>
      <scroll-view class="sheet__bd" scroll-y lower-threshold="80" bindscrolltolower="onGymPickerScrollLower">
        <view class="sheet-item" data-id="" data-name="全部岩馆" bindtap="onPickGym">
          <text class="sheet-item__label">全部岩馆</text>
          <text wx:if="{{!gymId}}" class="sheet-item__check">✓</text>
        </view>
        <view class="sheet-divider"></view>
        <block wx:if="{{gymOptions.length > 0}}">
          <view class="sheet-item" wx:for="{{gymOptions}}" wx:key="_id"
            data-id="{{item._id}}"
            data-name="{{item.name}}"
            bindtap="onPickGym">
            <text class="sheet-item__label">{{item.name}}</text>
            <text wx:if="{{gymId === item._id}}" class="sheet-item__check">✓</text>
          </view>
          <view wx:if="{{_gymPickerState.hasMore}}" class="sheet-more" bindtap="onGymPickerScrollLower">{{_gymPickerState.loading ? '加载中…' : '加载更多'}}</view>
        </block>
        <view wx:else class="sheet-empty">{{_gymPickerState.loading ? '加载中…' : (gymKeyword ? '没有找到匹配的岩馆' : '当前城市暂无岩馆')}}</view>
      </scroll-view>
    </view>
  </view>

  <!-- 时间块识别摘要：报名/退出/移除等操作统一进 plan-detail -->
  <view wx:if="{{selectedPlan}}" class="sheet-mask" bindtap="onClosePlan" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet__hd">
        <text class="sheet__title">约爬摘要</text>
        <view class="sheet__close" bindtap="onClosePlan">✕</view>
      </view>
      <view class="sheet__bd">
        <view class="tl-sheet-head">
          <image class="tl-sheet__avatar" src="{{selectedPlan.avatarUrl || defaultAvatar}}" mode="aspectFill"></image>
          <view class="tl-sheet__info">
            <view class="tl-sheet__name-row">
              <text class="tl-sheet__name">{{selectedPlan.displayName || selectedPlan.nickName || '岩友'}}</text>
              <text wx:if="{{selectedPlan.isMe}}" class="tag tag--on">我</text>
              <text wx:elif="{{selectedPlan.isFriend}}" class="tag">岩友</text>
              <text wx:if="{{selectedPlan.needPartner}}" class="tag tl-tag-partner">求搭子</text>
            </view>
            <text wx:if="{{selectedPlan.title}}" class="tl-sheet__sub">{{selectedPlan.title}}</text>
          </view>
        </view>
        <view class="tl-sheet-row">
          <text class="tl-sheet__k">时间</text>
          <text class="tl-sheet__v">{{selectedPlan.date}} {{selectedPlan.rangeText}}</text>
        </view>
        <view class="tl-sheet-row">
          <text class="tl-sheet__k">岩馆</text>
          <text class="tl-sheet__v">{{selectedPlan.gymName || selectedPlan.outdoorName || '攀岩'}}</text>
        </view>
        <view wx:if="{{selectedPlan.note}}" class="tl-sheet-row">
          <text class="tl-sheet__k">备注</text>
          <text class="tl-sheet__v">{{selectedPlan.note}}</text>
        </view>
        <view wx:if="{{selectedPlan.needPartner && selectedPlan.skillText}}" class="tl-sheet-row">
          <text class="tl-sheet__k">希望</text>
          <text class="tl-sheet__v">{{selectedPlan.skillText}} 一起爬</text>
        </view>
      </view>
      <view class="sheet__ft">
        <view class="btn btn-primary" bindtap="onViewPlan">查看约爬 ›</view>
      </view>
    </view>
  </view>
</view>
