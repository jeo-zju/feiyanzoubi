/* calendar-timeline：仅页面特有布局，元素样式全部来自 app.wxss 全局 */

.page--tl {
  padding-bottom: 60rpx;
}

/* 顶部日期 + 发布按钮 */
.tl-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 2rpx 12rpx;
}
.tl-header__title {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}
.tl-header__date {
  font-size: 40rpx;
  font-weight: 800;
}
.tl-header__week {
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.72);
  font-weight: 600;
}

/* 筛选行：城市标签 + 岩馆下拉 */
.filter-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}
.filter-row__select {
  flex: 1;
  min-width: 0;
}

.card-bd--pt0 { padding-top: 0; }

/* 岩友头像横滑 */
.avatar-row {
  white-space: nowrap;
  padding-top: 10rpx;
}
.avatar-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  margin-right: 22rpx;
}
.avatar-item__img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
  border: 2rpx solid rgba(143,123,255,0.22);
}
.avatar-item__name {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.76);
  max-width: 120rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 时间轴网格 */
.tl-card-bd {
  padding-left: 12rpx;
  padding-right: 12rpx;
}
.tl-wrap {
  display: flex;
  align-items: stretch;
  margin-left: -6rpx;
}
.tl-timecol {
  width: 92rpx;
  flex: 0 0 92rpx;
  padding-right: 8rpx;
  border-right: 1rpx solid rgba(255,255,255,0.06);
  box-sizing: border-box;
}
.tl-tick {
  height: 120rpx;
  line-height: 120rpx;
  text-align: right;
  padding-right: 12rpx;
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.48);
  font-weight: 700;
  box-sizing: border-box;
}
.tl-tick--ghost {
  height: 60rpx;
  line-height: 60rpx;
}
.tl-cols-scroll {
  flex: 1;
  min-width: 0;
}
.tl-cols {
  position: relative;
  display: flex;
}
.tl-col {
  position: relative;
  box-sizing: border-box;
  border-right: 1rpx dashed rgba(255, 255, 255, 0.05);
  height: 1500rpx;
}
.tl-bar {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  border-radius: 14rpx;
  padding: 10rpx 12rpx;
  background: #7c6ee6;
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 4rpx 14rpx rgba(124, 110, 230, 0.2);
}
.tl-bar__time {
  font-size: 24rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.2;
}
.tl-bar__gym {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.tl-bar--c1 { background: #e6c76a; color: #1b1405; }
.tl-bar--c1 .tl-bar__time { color: #1b1405; }
.tl-bar--c1 .tl-bar__gym { color: rgba(27,20,5,0.85); }
.tl-bar--c2 { background: #5b8def; }
.tl-bar--c3 { background: #f28b94; }
.tl-bar--c4 { background: #59c3a7; }
.tl-bar--c5 { background: #c58bf0; }
.tl-bar--c6 { background: #f7a35d; }
.tl-bar--c7 { background: #8fc86f; }

/* 计划详情弹层（沿用全局 sheet 形态，头部为头像+信息） */
.plan-modal {
  max-height: 80vh;
}
.plan-modal-mask { z-index: 110; }
.member-card-mask { z-index: 120; }
.plan-modal__hd {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #2b3044;
  flex-shrink: 0;
}
.plan-modal__avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
}
.plan-modal__info { flex: 1; min-width: 0; }
.plan-modal__name {
  font-size: 32rpx;
  font-weight: 800;
}
.plan-modal__meta {
  margin-top: 4rpx;
  font-size: 24rpx;
}
.plan-modal__bd {
  padding: 18rpx 28rpx 10rpx;
}
.plan-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  gap: 18rpx;
  border-top: 1rpx dashed rgba(255,255,255,0.06);
}
.plan-row:first-child { border-top: none; }
.plan-row__k {
  width: 120rpx;
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.56);
  flex-shrink: 0;
}
.plan-row__v {
  flex: 1;
  font-size: 28rpx;
  color: #e7e9f3;
}
.plan-row--warn .plan-row__v { color: #f2c14e; font-weight: 700; }
.plan-modal__ft {
  display: flex;
  gap: 14rpx;
  padding: 16rpx 28rpx 4rpx;
  flex-shrink: 0;
}
.plan-modal__btn {
  flex: 1;
}

/* 报名列表 */
.plan-section { margin-top: 8rpx; }
.join-list {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.join-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
}
.join-row__img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.08);
}
.join-row__bd {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.join-row__name {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.join-row__sub {
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.plan-modal__avatar--tap:active,
.join-row__img--tap:active {
  opacity: 0.82;
}
