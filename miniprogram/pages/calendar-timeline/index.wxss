/* 当天时间轴（compact）：日期 → 筛选 → 头像列头/二维轴体；坐标刻度沿用旧计算 */
page {
  background: #151714;
}

.tl-page {
  padding: 24rpx 32rpx 48rpx;
}

/* 日期星期行 */
.tl-title {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  padding: 0 4rpx;
}
.tl-title__date {
  font-size: 40rpx;
  font-weight: 700;
  color: #F3F1E7;
}
.tl-title__week {
  font-size: 24rpx;
  color: #969D90;
}

/* 筛选行 */
.tl-filters {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.tl-filter {
  flex: 1;
  min-width: 0;
}
.tl-tabs {
  margin-top: 20rpx;
}

/* 时间轴卡片 */
.tl-card {
  margin-top: 20rpx;
  padding: 24rpx 12rpx 28rpx;
}
.tl-count {
  padding: 0 12rpx 16rpx;
  font-size: 24rpx;
  color: #969D90;
}
.tl-scroll {
  width: 100%;
}
.tl-inner {
  box-sizing: border-box;
}

/* 头像列头（与轴体同一横向滚动，天然同位） */
.tl-head {
  display: flex;
  align-items: stretch;
}
.tl-corner {
  width: 92rpx;
  flex: 0 0 92rpx;
  box-sizing: border-box;
}
.tl-headcols {
  display: flex;
}
.tl-headcol {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 8rpx;
  box-sizing: border-box;
}
.tl-headcol:active .tl-headcol__img {
  border-color: rgba(210, 239, 114, 0.6);
}
.tl-headcol__img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #20241F;
  border: 2rpx solid #383E34;
  box-sizing: border-box;
}
.tl-headcol__name {
  margin-top: 8rpx;
  max-width: 184rpx;
  font-size: 24rpx;
  color: #B9BDB0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 轴体：左固定刻度 + 右计划列；纵向随页面滚动，刻度与内容同步 */
.tl-axis {
  display: flex;
  align-items: stretch;
  margin-top: 8rpx;
}
.tl-timecol {
  width: 92rpx;
  flex: 0 0 92rpx;
  padding-right: 8rpx;
  border-right: 1rpx solid #383E34;
  box-sizing: border-box;
}
.tl-tick {
  height: 120rpx;
  line-height: 120rpx;
  text-align: right;
  padding-right: 12rpx;
  font-size: 24rpx;
  color: #969D90;
  box-sizing: border-box;
}
.tl-tick--ghost {
  height: 60rpx;
  line-height: 60rpx;
}
.tl-cols {
  position: relative;
  display: flex;
}
.tl-col {
  position: relative;
  box-sizing: border-box;
  border-right: 1rpx dashed #383E34;
  height: 1500rpx;
}
.tl-bar {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  border-radius: 12rpx;
  padding: 8rpx 12rpx;
  background: #D2EF72;
  box-sizing: border-box;
}
.tl-bar:active {
  opacity: 0.82;
}
.tl-bar__time {
  font-size: 24rpx;
  font-weight: 700;
  color: #151714;
  line-height: 1.2;
}
.tl-bar__gym {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: rgba(21, 23, 20, 0.72);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tl-empty {
  padding: 56rpx 32rpx;
}

/* 摘要 sheet */
.tl-sheet-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 12rpx;
}
.tl-sheet__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #20241F;
  flex-shrink: 0;
}
.tl-sheet__info {
  flex: 1;
  min-width: 0;
}
.tl-sheet__name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.tl-sheet__name {
  font-size: 32rpx;
  font-weight: 600;
  color: #F3F1E7;
  max-width: 320rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.tl-tag-partner {
  color: #E8C58C;
  border-color: rgba(232, 197, 140, 0.4);
}
.tl-sheet__sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #969D90;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.tl-sheet-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #383E34;
}
.tl-sheet__k {
  width: 96rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #969D90;
}
.tl-sheet__v {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #F3F1E7;
  line-height: 1.5;
  word-break: break-all;
}
