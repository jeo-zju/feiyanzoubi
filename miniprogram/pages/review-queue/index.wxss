.viewport-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.viewport-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 18rpx;
}

.item-title {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}

.item-address {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(231, 233, 243, 0.78);
}

.item-meta {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.58);
}

.reason-list {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
