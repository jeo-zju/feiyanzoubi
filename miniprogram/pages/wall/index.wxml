<view class="page viewport-page">
  <view class="card card-hero">
    <view class="card-bd">
      <view class="section-title-lg">{{gym.name || '攀岩墙'}}</view>
      <view class="section-desc">容量 {{capacity}}，当前 {{total}}。墙满后会自动替换最早展示的名片。</view>
      <view class="btn btn-warn mt2" bindtap="onHang">放上我的名片</view>
    </view>
  </view>

  <scroll-view scroll-y class="viewport-scroll mt2">
    <view class="card">
      <view class="card-hd">墙上名片</view>
      <view class="card-bd">
        <view wx:if="{{!cards.length}}" class="empty-state">墙上还空着</view>
        <view class="grid">
          <view wx:for="{{cards}}" wx:key="_id" class="panel cell">
            <image
              class="avatar"
              mode="aspectFill"
              src="{{(item.snapshot.avatarMode==='custom'?item.snapshot.avatarFileId:item.snapshot.avatarUrl) || defaultAvatar}}"
            ></image>
            <view class="name">{{item.snapshot.displayName}}</view>
            <view class="muted small">{{item.snapshot.title}}</view>
            <view class="muted tiny">{{item.snapshot.oneLiner}}</view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
