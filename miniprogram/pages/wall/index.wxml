<view class="page">
  <view class="card card-hero">
    <view class="card-bd">
      <view class="section-kicker">攀岩墙</view>
      <view class="section-title-lg">{{gym.name || '攀岩墙'}}</view>
      <view class="section-desc">容量 {{capacity}}，当前 {{total}}。满了会请最早那位先下去透气。</view>
      <view class="btn btn-warn mt" bindtap="onHang">我要上墙</view>
    </view>
  </view>

  <view class="card mt">
    <view class="card-hd">墙上名片</view>
    <view class="card-bd">
      <view wx:if="{{!cards.length}}" class="empty-state">空墙一面，等你开张</view>
      <view class="grid">
        <view wx:for="{{cards}}" wx:key="_id" class="panel cell">
          <image
            class="avatar"
            mode="aspectFill"
            src="{{(item.snapshot.avatarMode==='custom'?item.snapshot.avatarFileId:item.snapshot.avatarUrl) || defaultAvatar}}"
          ></image>
          <view class="name">{{item.snapshot.displayName}}</view>
          <view class="muted cell-sub">{{item.snapshot.title}}</view>
          <view class="muted cell-desc">{{item.snapshot.oneLiner}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
