<view class="page ui-v2 wl-page">
  <!-- 馆名 + 张数；容量替换规则只在此（上墙决策前）出现一次 -->
  <view class="wl-head card">
    <view class="wl-head__row">
      <text class="wl-head__name">{{gym.name || '岩馆名片墙'}}</text>
      <text class="wl-head__count">{{total}}/{{capacity}}</text>
    </view>
    <view class="wl-head__rule">墙上满 {{capacity}} 张时，新名片会替换最早挂上去的那张。</view>
    <button class="btn btn-primary btn--block" bindtap="onHang">我要上墙</button>
  </view>

  <!-- 名片两列缩略：只补姓名，头衔/一句话不重复，点击进完整名片 -->
  <view wx:if="{{cards.length}}" class="wl-grid">
    <view wx:for="{{cards}}" wx:key="_id" class="wl-cell" data-id="{{item.cardId}}" bindtap="onViewCard">
      <image
        class="wl-cell__avatar"
        mode="aspectFill"
        lazy-load
        src="{{(item.snapshot.avatarMode==='custom'?item.snapshot.avatarFileId:item.snapshot.avatarUrl) || defaultAvatar}}"
      ></image>
      <view class="wl-cell__name">{{item.snapshot.displayName || '岩友'}}</view>
    </view>
  </view>
  <view wx:else class="empty-state wl-empty">
    <view class="empty-state__desc">墙上还没有名片，挂第一张吧</view>
  </view>
</view>
