/* 岩馆名片墙（compact）：馆名张数 → 两列名片缩略 → 唯一上墙入口 */
page {
  background: #151714;
}

.wl-page {
  padding: 24rpx 32rpx 48rpx;
}

.wl-page .btn::after {
  border: none;
}

/* 头部 */
.wl-head {
  padding: 28rpx;
}

.wl-head__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.wl-head__name {
  font-size: 36rpx;
  font-weight: 600;
  color: #F3F1E7;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wl-head__count {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #969D90;
}

.wl-head__rule {
  margin: 14rpx 0 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #969D90;
}

/* 两列缩略；条目少时不强撑高度，无数据不造占位 */
.wl-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.wl-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  background: #20241F;
  border: 1rpx solid #383E34;
  border-radius: 20rpx;
}

.wl-cell:active {
  border-color: rgba(210, 239, 114, 0.4);
}

.wl-cell__avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #2B3029;
  border: 1rpx solid #383E34;
}

.wl-cell__name {
  margin-top: 14rpx;
  max-width: 100%;
  font-size: 26rpx;
  font-weight: 500;
  color: #F3F1E7;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wl-empty {
  margin-top: 120rpx;
}

/* 窄屏（约 320px 档）单列，保证名字可识别 */
@media (max-width: 360px) {
  .wl-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
