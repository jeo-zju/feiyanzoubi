.viewport-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.viewport-scroll {
  flex: 1;
  min-height: 0;
}

.mt2 {
  margin-top: 24rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 6rpx;
}

.cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  text-align: center;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
}

.name {
  margin-top: 12rpx;
  font-weight: 900;
  font-size: 28rpx;
}

.small {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.tiny {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  opacity: 0.85;
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

@media (max-width: 360px) {
  .grid {
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }
}
