.mt2 {
  margin-top: 24rpx;
}

.hero {
  background: linear-gradient(135deg, rgba(143, 123, 255, 0.20), rgba(242, 193, 78, 0.10));
  border: 1rpx solid rgba(143, 123, 255, 0.22);
}

.hero-title {
  font-size: 34rpx;
  font-weight: 900;
}

.hero-sub {
  margin-top: 8rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  width: 33.33%;
  padding: 12rpx 6rpx;
  box-sizing: border-box;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
}

.name {
  margin-top: 8rpx;
  font-weight: 900;
  font-size: 26rpx;
}

.small {
  font-size: 22rpx;
}

.tiny {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.25;
  opacity: 0.85;
}
