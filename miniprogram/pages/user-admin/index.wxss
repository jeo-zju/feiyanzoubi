.viewport-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.viewport-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 18rpx;
}

.item-title {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}

.summary-row {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meta-stack {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(231, 233, 243, 0.62);
  word-break: break-all;
}

.preset-row {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.save-btn {
  min-width: 220rpx;
}
