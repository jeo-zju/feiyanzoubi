<view class="page page--mine">
  <view class="card-hero hero-cal">
    <view class="hero-hd">
      <view class="hero-title">嗨，{{userName}}</view>
      <view class="hero-sub">近30天概览</view>
    </view>

    <view class="hero-grid">
      <view class="hg-cell">
        <view class="hg-num">{{summary.thisMonthPlans || 0}}</view>
        <view class="hg-k">本月计划</view>
      </view>
      <view class="hg-cell">
        <view class="hg-num">{{stats.recent.length || 0}}</view>
        <view class="hg-k">打卡次数</view>
      </view>
      <view class="hg-cell">
        <view class="hg-num">{{summary.thisMonthCheckinRate || 0}}%</view>
        <view class="hg-k">完成率</view>
      </view>
      <view class="hg-cell">
        <view class="hg-num">{{summary.totalPartners || 0}}</view>
        <view class="hg-k">搭子</view>
      </view>
    </view>

    <view class="hero-foot muted" wx:if="{{summary.topGymName}}">最常去 · {{summary.topGymName}}</view>
  </view>

  <view class="card mt-lg">
    <view class="card-hd">
      <view class="card-title">活动记录</view>
      <view class="muted card-sub" wx:if="{{activityTotal}}">共 {{activityTotal}} 条 · 第 {{activityPage}}/{{activityPageCount}} 页</view>
    </view>
    <view class="card-bd list">
      <view wx:for="{{activityList}}" wx:key="key" class="list-row rec">
        <view class="rec-left">
          <view class="rec-title">
            <text class="badge badge--{{item.badgeType}}">{{item.badgeText}}</text>
            <text class="rec-gym">{{item.gymName}}</text>
          </view>
          <view class="muted rec-sub">{{item.date}} · {{item.subText}}</view>
        </view>
        <view class="rec-right muted">{{item.rightText}}</view>
      </view>
      <view wx:if="{{!activityList.length && !stats.loading}}" class="empty-state">暂无活动，去发布一个吧～</view>
      <view wx:if="{{activityPageCount > 1}}" class="paginator">
        <view class="pg-btn {{activityPage<=1?'pg-btn--off':''}}" bindtap="onActivityPrev">上一页</view>
        <view class="pg-info">{{activityPage}} / {{activityPageCount}}</view>
        <view class="pg-btn {{activityPage>=activityPageCount?'pg-btn--off':''}}" bindtap="onActivityNext">下一页</view>
      </view>
    </view>
  </view>
</view>
