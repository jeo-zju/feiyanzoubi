.page--mine {
  min-height: 100vh;
  max-height: 100vh;
  height: 100vh;
  overflow: hidden;
  padding-bottom: 36rpx;
  box-sizing: border-box;
}
.mt-lg { margin-top: 20rpx; }
.mt { margin-top: 18rpx; }
.muted { color: rgba(231,233,243,0.6); }

.hero-cal {
  position: relative;
  overflow: hidden;
  padding: 24rpx 28rpx 22rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(120% 80% at 90% -10%, rgba(242,193,78,0.18), transparent 60%),
    radial-gradient(120% 80% at 0% 110%, rgba(124,110,230,0.22), transparent 60%),
    rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.06);
}

.hero-hd {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}
.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #E7E9F3;
}
.hero-sub {
  font-size: 22rpx;
  color: rgba(231,233,243,0.5);
  letter-spacing: 2rpx;
}

.hero-grid {
  display: flex;
  gap: 12rpx;
}
.hg-cell {
  flex: 1;
  padding: 16rpx 6rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.035);
  border: 1rpx solid rgba(255,255,255,0.06);
  text-align: center;
}
.hg-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #E7E9F3;
  line-height: 1.1;
}
.hg-k {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: rgba(231,233,243,0.52);
}

.hero-foot {
  margin-top: 16rpx;
  font-size: 22rpx;
  text-align: center;
}

.card-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 22rpx 0;
}
.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #E7E9F3;
}
.card-sub {
  font-size: 22rpx;
}

.rec-left {
  flex: 1;
  min-width: 0;
}
.rec {
  gap: 16rpx;
}
.rec-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-weight: 700;
  min-width: 0;
}
.rec-gym {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rec-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
}
.rec-right {
  font-weight: 700;
  font-size: 24rpx;
}

.badge {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.5;
}
.badge--checkin {
  color: #f2d483;
  background: rgba(242,193,78,0.14);
  border: 1rpx solid rgba(242,193,78,0.30);
}
.badge--plan-ongoing {
  color: #c8bbff;
  background: rgba(143,123,255,0.14);
  border: 1rpx solid rgba(143,123,255,0.30);
}
.badge--plan-done {
  color: rgba(231,233,243,0.55);
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.08);
}
.badge--plan-cancel {
  color: rgba(231,233,243,0.4);
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(255,255,255,0.06);
  text-decoration: line-through;
}
.badge--joined {
  color: #8fd3ff;
  background: rgba(77,167,255,0.14);
  border: 1rpx solid rgba(77,167,255,0.30);
}

.empty-state {
  padding: 50rpx 0 30rpx;
  text-align: center;
  color: rgba(231,233,243,0.4);
  font-size: 24rpx;
}
.list-row {
  display: flex;
  align-items: center;
  padding: 20rpx 22rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}
.list-row:last-child { border-bottom: none; }

.paginator {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 24rpx 0 16rpx;
}
.pg-btn {
  padding: 12rpx 36rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #E7E9F3;
  background: rgba(124,110,230,0.22);
  border: 1rpx solid rgba(124,110,230,0.40);
  border-radius: 32rpx;
  line-height: 1;
}
.pg-btn--off {
  color: rgba(231,233,243,0.35);
  background: rgba(255,255,255,0.04);
  border-color: rgba(255,255,255,0.08);
}
.pg-info {
  font-size: 22rpx;
  color: rgba(231,233,243,0.5);
}
