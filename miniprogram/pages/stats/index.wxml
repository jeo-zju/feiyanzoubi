<view class="page viewport-page">
  <view class="card card-hero">
    <view class="card-bd">
      <view class="section-title-lg">攀爬统计</view>
      <view class="section-desc">{{summaryText}}</view>
      <view class="chart-wrap">
        <line-chart points="{{chartPoints}}" />
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="viewport-scroll mt">
    <view class="card">
      <view class="card-hd">最近记录</view>
      <view class="card-bd list">
        <view wx:for="{{recent}}" wx:key="id" class="list-row rec">
          <view class="rec-left">
            <view class="rec-title">{{item.gymName}}</view>
            <view class="muted rec-sub">{{item.date}} · {{item.modeText}}</view>
          </view>
          <view class="rec-right">+{{item.delta}}</view>
        </view>
        <view wx:if="{{!recent.length && !loading}}" class="empty-state">还没有记录</view>
        <paginator
          wx:if="{{recent.length}}"
          page="{{page}}"
          hasNext="{{hasNext}}"
          bind:prev="onPrev"
          bind:next="onNext"
        />
      </view>
    </view>
  </scroll-view>
</view>

