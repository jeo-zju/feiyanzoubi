/* 发起约爬页：卡片、按钮、输入和标签均使用全局体系，本文件只保留页面特有布局 */
.page--pub {
  padding-bottom: 220rpx;
}

.gym-pick__list {
  margin-top: 16rpx;
  max-height: 480rpx;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.cal-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 104rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 28rpx;
  font-weight: 600;
}

.cal-cell--selected {
  background: #8f7bff;
  border-color: #8f7bff;
}

.cal-cell--selected view {
  color: #0b0d15;
}

.cal-time-row {
  margin-top: 20rpx;
}

.cal-time {
  flex: 1;
  min-width: 0;
}

.capacity-input {
  width: 160rpx;
  flex-shrink: 0;
}
