.page--pub { padding-bottom: 220rpx; }

.mt { margin-top: 18rpx; }
.mt-sm { margin-top: 12rpx; }
.muted { color: rgba(231,233,243,0.6); }
.ph { color: rgba(231,233,243,0.42); }

.search-shell {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.08);
  padding: 0 20rpx;
}
.search-shell__ic { font-size: 28rpx; }
.search-shell__input {
  flex: 1;
  color: #e7e9f3;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}

.gym-list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  max-height: 320rpx;
  overflow: auto;
}
.gym-row {
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.08);
}
.gym-row--active {
  background: rgba(143,123,255,0.16);
  border-color: rgba(143,123,255,0.36);
}
.gym-row__name {
  font-size: 27rpx;
  font-weight: 600;
  color: #E7E9F3;
}
.gym-row .muted {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.empty {
  padding: 20rpx 0;
  text-align: center;
  font-size: 24rpx;
}

.panel-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
}
.panel-row__k { color: rgba(231,233,243,0.6); }
.panel-row__v { flex: 1; color: #E7E9F3; font-weight: 600; }
.panel-row__op {
  color: #8F7BFF;
  font-size: 22rpx;
  font-weight: 600;
}

.date-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.date-head__label {
  font-size: 27rpx;
  font-weight: 600;
  color: #E7E9F3;
}
.date-head__range { font-size: 22rpx; }

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}
.cal-cell {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 104rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.06);
}
.cal-cell--today {
  border-color: rgba(242, 193, 78, 0.7);
}
.cal-cell--selected {
  background: rgba(242, 193, 78, 0.12);
  border: 2rpx solid rgba(242,193,78,0.85);
  box-shadow: 0 0 0 6rpx rgba(242,193,78,0.08);
}
.cal-cell__check {
  position: absolute;
  top: 8rpx;
  right: 10rpx;
  width: 32rpx;
  height: 32rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 50%;
  background: #f2c14e;
  color: #0b0d15;
  font-size: 22rpx;
  font-weight: 900;
}
.cal-cell__md {
  font-size: 28rpx;
  font-weight: 600;
  color: #E7E9F3;
  line-height: 1;
}
.cal-cell--selected .cal-cell__md { color: #E6C76A; }
.cal-cell__wd {
  position: absolute;
  bottom: 10rpx;
  font-size: 18rpx;
  line-height: 1;
}
.cal-cell__tag {
  position: absolute;
  bottom: 10rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: #E6C76A;
  line-height: 1;
}

.card-hd--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
}

.time-shell {
  padding: 20rpx 10rpx;
  position: relative;
  background: rgba(255,255,255,0.03);
  border-radius: 20rpx;
}
.time-fade {
  display: flex;
  justify-content: space-around;
  padding: 6rpx 4rpx;
}
.time-fade__item {
  font-size: 24rpx;
  color: rgba(231,233,243,0.3);
  font-weight: 700;
}
.time-range {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
  margin: 20rpx 20rpx;
  height: 104rpx;
  border-radius: 18rpx;
  background: rgba(143, 123, 255, 0.16);
  border: 1rpx solid rgba(143,123,255,0.3);
}
.time-range__start, .time-range__end {
  font-size: 44rpx;
  font-weight: 600;
  color: #E7E9F3;
  letter-spacing: 2rpx;
  min-width: 180rpx;
  text-align: center;
}
.time-range__dash {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(231,233,243,0.55);
}

.card-bd--py18 { padding-top: 18rpx; padding-bottom: 18rpx; }

.accordion {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}
.accordion__label {
  font-size: 27rpx;
  font-weight: 600;
  color: #E7E9F3;
}
.accordion__arrow {
  color: rgba(231,233,243,0.5);
  font-size: 34rpx;
  transform: rotate(0deg);
}

.advanced {
  margin-top: 16rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed rgba(255,255,255,0.08);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.advanced-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.advanced-row--switch {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.advanced-row__label {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(231,233,243,0.78);
}
.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag--off {
  background: rgba(255,255,255,0.04);
  color: rgba(231,233,243,0.5);
  border-color: rgba(255,255,255,0.08);
}

.pub-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(110rpx + env(safe-area-inset-bottom));
  padding: 16rpx 24rpx;
  background: linear-gradient(180deg, rgba(11,13,21,0) 0%, #0b0d15 30%);
}
.pub-bottom__btn {
  height: 96rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #8F7BFF, #7C6EE6);
  color: #fff;
}
