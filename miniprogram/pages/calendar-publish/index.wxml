<view class="page page--pub">
  <view class="social-title">{{planId?'编辑约爬':'发起一次约爬'}}</view>
  <view class="social-sub">说清去哪、何时、怎么爬，让新岩友放心加入。</view>
  <view wx:if="{{formLoading}}" class="empty-state">准备中…</view>

  <view class="social-panel">
    <view class="social-label">01 · 去哪家馆</view>
    <view wx:if="{{selectedGymId}}" class="field-select" bindtap="onTapChangeGym">
      <text class="field-select__value">{{selectedGymName}}</text>
      <text class="field-select__arrow">▾</text>
    </view>
    <block wx:else>
      <view class="searchbar">
        <text class="searchbar__ic">🔍</text>
        <input class="searchbar__input" placeholder="搜索岩馆名称或地址" placeholder-class="ph" value="{{gymKeyword}}" bindinput="onGymKeywordInput" />
      </view>
      <scroll-view scroll-y class="gym-pick__list" bindscrolltolower="onGymPickerScrollLower">
        <view wx:for="{{gymOptions}}" wx:key="_id" class="sheet-item" data-gymid="{{item._id}}" data-gymname="{{item.name}}" bindtap="onPickGym">
          <view class="sheet-item__info">
            <view class="sheet-item__name">{{item.name}}</view>
            <view class="sheet-item__sub">{{item.city}} · {{item.address}}</view>
          </view>
        </view>
        <view wx:if="{{_gymPickerState.loading}}" class="sheet-empty">加载中…</view>
        <view wx:elif="{{!gymOptions.length}}" class="sheet-empty">没有找到岩馆，试试其他关键词</view>
      </scroll-view>
    </block>
  </view>

  <view class="social-panel">
    <view class="social-label">02 · 什么时候</view>
    <view class="social-small">{{dateRangeLabel}}</view>
    <view class="cal-grid mt-sm">
      <view wx:for="{{dateCells}}" wx:key="date" class="cal-cell {{item.selected?'cal-cell--selected':''}}" data-date="{{item.date}}" bindtap="onSelectDate">
        <view>{{item.label}}</view>
        <view class="social-small">{{item.weekdayShort}}</view>
      </view>
    </view>
    <view class="social-row cal-time-row">
      <picker class="cal-time" mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
        <view class="field-select">开始 {{startTime}}<text class="field-select__arrow">▾</text></view>
      </picker>
      <text>至</text>
      <picker class="cal-time" mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
        <view class="field-select">结束 {{endTime}}<text class="field-select__arrow">▾</text></view>
      </picker>
    </view>
  </view>

  <view class="social-panel">
    <view class="social-label">03 · 怎么一起爬</view>
    <view class="social-small">攀爬类型，可多选</view>
    <view class="tag-grid mt-sm">
      <view wx:for="{{skillTags}}" wx:key="key" class="tag {{item.on?'tag--on':'tag--off'}}" data-key="{{item.key}}" bindtap="onToggleSkillTag">{{item.label}}</view>
    </view>
    <view class="social-small mt">活动氛围，可选</view>
    <view class="tag-grid mt-sm">
      <view wx:for="{{atmosphereOptions}}" wx:key="*this" class="tag {{(atmosphereTags[0]===item || atmosphereTags[1]===item || atmosphereTags[2]===item) ? 'tag--on' : 'tag--off'}}" data-value="{{item}}" bindtap="onAtmosphere">{{item}}</view>
    </view>
    <input class="input mt" maxlength="40" placeholder="一句话邀请，例如：周三晚休闲抱石" placeholder-class="ph" value="{{title}}" data-key="title" bindinput="onField" />
    <input class="input mt" maxlength="200" placeholder="补充说明（可选）" placeholder-class="ph" value="{{note}}" bindinput="onNoteInput" />
  </view>

  <view class="social-panel">
    <view class="social-label">04 · 留几个名额</view>
    <view class="social-row">
      <text>总人数（含自己）</text>
      <input class="input capacity-input" type="number" value="{{capacity}}" data-key="capacity" bindinput="onField" />
    </view>
    <view class="social-row">
      <view class="social-person">
        <view>加入前需要我确认</view>
        <view class="social-small">关闭后，有名额即可加入；活动开始时截止报名。</view>
      </view>
      <switch color="#8f7bff" checked="{{joinMode==='approval'}}" bindchange="onApproval" />
    </view>
  </view>

  <view class="social-panel">
    <view class="social-row" bindtap="toggleMore">
      <text>集合信息与可见范围</text>
      <text class="btn-text">{{moreOpen?'收起':'展开'}} ⌄</text>
    </view>
    <block wx:if="{{moreOpen}}">
      <view class="social-small">下面两项仅自己和已确认成员可见，不会出现在公开列表中。</view>
      <input class="input mt" maxlength="100" placeholder="集合位置，例如：前台旁边（可选）" placeholder-class="ph" data-key="meetingPoint" value="{{meetingPoint}}" bindinput="onField" />
      <input class="input mt" maxlength="100" placeholder="愿意提供的联络方式（可选）" placeholder-class="ph" data-key="contact" value="{{contact}}" bindinput="onField" />
      <view class="mt"><seg-tabs tabs="{{visibilityTabs}}" value="{{visibility}}" bind:change="onVisibilityChange" /></view>
      <view class="social-small mt-sm">{{visibilityHint}}</view>
    </block>
  </view>

  <view class="social-bottom">
    <button class="btn btn-primary" disabled="{{submitting || formLoading || formError}}" loading="{{submitting}}" bindtap="onPublish">{{planId?'保存修改并通知岩友':'发起约爬'}}</button>
  </view>
</view>
