<view class="page viewport-page">
  <view class="card card-hero">
    <view class="card-bd">
      <view class="section-title-lg">名片归属</view>
      <view class="section-desc">按名片 ID 联查归属、创建者和状态，并支持直接修正 owner、状态与主卡标记。</view>
      <view class="field-block mt">
        <view class="field-label">名片 ID</view>
        <input
          class="input"
          placeholder="输入 RockCards._id"
          placeholder-class="ph"
          value="{{query}}"
          bindinput="onQueryInput"
        />
      </view>
      <view class="action-row">
        <view class="btn btn-primary flex" bindtap="onSearch">{{loading ? '查询中' : '开始联查'}}</view>
        <view class="btn btn-ghost mini ml" bindtap="onCopyRaw">复制原始数据</view>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="viewport-scroll">
    <view wx:if="{{error}}" class="card mt">
      <view class="card-bd">
        <view class="tag tag-warn">{{error}}</view>
      </view>
    </view>

    <view wx:if="{{searched}}" class="card mt">
      <view class="card-hd">查询结果</view>
      <view class="card-bd">
        <view class="row">
          <view class="section-title">{{resultTitle}}</view>
          <view class="tag {{found ? '' : 'tag-warn'}}">{{found ? '已找到' : '未找到'}}</view>
        </view>
        <view wx:if="{{found && card}}" class="meta-stack">
          <text>名片 ID: {{card._id}}</text>
          <text>ownerOpenid: {{card.ownerOpenid || '-'}}</text>
          <text>createdByOpenid: {{card.createdByOpenid || '-'}}</text>
          <text>status: {{card.status || '-'}}</text>
          <text>isPrimary: {{card.isPrimary ? 'true' : 'false'}}</text>
        </view>
        <view wx:else class="section-tip mt">没有查到这张名片。</view>
      </view>
    </view>

    <view wx:if="{{found && card}}" class="card mt">
      <view class="card-hd">关联用户</view>
      <view class="card-bd">
        <view class="field-block">
          <view class="field-label">当前归属用户</view>
          <view class="meta-stack">
            <text>昵称: {{ownerUser.nickName || '-'}}</text>
            <text>openid: {{ownerUser.openid || card.ownerOpenid || '-'}}</text>
            <text>role: {{ownerUser.role || '-'}}</text>
          </view>
        </view>
        <view class="field-block mt">
          <view class="field-label">创建者</view>
          <view class="meta-stack">
            <text>昵称: {{creatorUser.nickName || '-'}}</text>
            <text>openid: {{creatorUser.openid || card.createdByOpenid || '-'}}</text>
            <text>role: {{creatorUser.role || '-'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{found && card}}" class="card mt">
      <view class="card-hd">修正归属</view>
      <view class="card-bd">
        <view class="field-block">
          <view class="field-label">ownerOpenid</view>
          <input class="input" placeholder="留空表示未归属" placeholder-class="ph" value="{{draft.ownerOpenid}}" data-key="ownerOpenid" bindinput="onDraftInput" />
        </view>
        <view class="field-block mt">
          <view class="field-label">status</view>
          <seg-tabs tabs="{{statusTabs}}" value="{{draft.status}}" bind:change="onStatusChange" />
        </view>
        <view class="action-row">
          <view class="tag {{draft.isPrimary ? 'tag-warn' : ''}}" bindtap="onTogglePrimary">
            {{draft.isPrimary ? '主卡: 开' : '主卡: 关'}}
          </view>
          <view class="btn btn-primary save-btn" bindtap="onSave">{{saving ? '保存中' : '保存修正'}}</view>
        </view>
        <view class="section-tip mt">当 `status` 不是 `active` 或未设置 `ownerOpenid` 时，主卡会自动关闭。</view>
      </view>
    </view>

    <view wx:if="{{found && card}}" class="card mt">
      <view class="card-hd">原始文档</view>
      <view class="card-bd">
        <view class="json-block">{{rawCardText || 'null'}}</view>
      </view>
    </view>
  </scroll-view>
</view>
