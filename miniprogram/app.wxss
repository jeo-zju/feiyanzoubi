page {
  background: #0b0d15;
  color: #e7e9f3;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 36rpx;
  box-sizing: border-box;
}

.card {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  overflow: hidden;
}

.card-hd {
  padding: 22rpx 22rpx 12rpx;
  font-weight: 700;
  font-size: 32rpx;
}

.card-bd {
  padding: 0 22rpx 22rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: rgba(231, 233, 243, 0.68);
}

.btn {
  height: 76rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.btn-primary {
  background: #8f7bff;
  color: #0b0d15;
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.06);
  color: #e7e9f3;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.btn-warn {
  background: rgba(242, 193, 78, 0.14);
  color: #f2c14e;
  border: 1rpx solid rgba(242, 193, 78, 0.25);
}

.input {
  height: 76rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #e7e9f3;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.tag {
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.9);
  background: rgba(143, 123, 255, 0.14);
  border: 1rpx solid rgba(143, 123, 255, 0.22);
}

.tag-warn {
  background: rgba(242, 193, 78, 0.14);
  border-color: rgba(242, 193, 78, 0.22);
  color: #f2c14e;
}

.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.08);
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
}

button::after {
  border: none;
}
