page {
  background: #0b0d15;
  color: #e7e9f3;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 36rpx;
  box-sizing: border-box;
}

.card {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  overflow: hidden;
}

.card-hero {
  background: linear-gradient(135deg, rgba(143, 123, 255, 0.18), rgba(242, 193, 78, 0.10));
  border-color: rgba(242, 193, 78, 0.16);
}

.card-hd {
  padding: 22rpx 22rpx 12rpx;
  font-weight: 700;
  font-size: 32rpx;
}

.card-bd {
  padding: 0 22rpx 22rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: rgba(231, 233, 243, 0.68);
}

.section-kicker {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #f2c14e;
  background: rgba(255, 255, 255, 0.08);
}

.section-title-lg {
  margin-top: 18rpx;
  font-size: 36rpx;
  line-height: 1.28;
  font-weight: 900;
  color: #fff;
}

.section-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(231, 233, 243, 0.72);
}

.section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
}

.section-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(231, 233, 243, 0.6);
}

.panel {
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.panel-soft {
  background: rgba(255, 255, 255, 0.03);
}

.stat-grid {
  display: flex;
  gap: 14rpx;
}

.stat-card {
  flex: 1;
  min-width: 0;
}

.stat-number {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 900;
  color: #fff;
}

.stat-number-warn {
  color: #f2c14e;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(231, 233, 243, 0.62);
}

.list {
  display: flex;
  flex-direction: column;
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.list-row:first-child {
  border-top: none;
}

.empty-state {
  padding: 30rpx 0;
  text-align: center;
  color: rgba(231, 233, 243, 0.58);
}

.btn {
  height: 76rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.btn.mini {
  height: 56rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.btn-primary {
  background: #8f7bff;
  color: #0b0d15;
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.06);
  color: #e7e9f3;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.btn-warn {
  background: rgba(242, 193, 78, 0.14);
  color: #f2c14e;
  border: 1rpx solid rgba(242, 193, 78, 0.25);
}

.input {
  height: 76rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #e7e9f3;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.tag {
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.9);
  background: rgba(143, 123, 255, 0.14);
  border: 1rpx solid rgba(143, 123, 255, 0.22);
}

.tag-warn {
  background: rgba(242, 193, 78, 0.14);
  border-color: rgba(242, 193, 78, 0.22);
  color: #f2c14e;
}

.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.08);
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
}

button::after {
  border: none;
}
