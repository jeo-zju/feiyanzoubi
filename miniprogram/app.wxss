/* ============================================================
 * 飞岩走壁 · 全局设计体系（唯一元素样式来源）
 * 字号层级：40 大标题/大数字 · 32 卡片区块标题 · 28 正文/按钮/输入 · 24 辅助/标签（最小字号）
 * 按钮：btn-primary 主操作 · btn-ghost 次操作 · btn-warn 提醒 · btn-danger 危险 · btn-text 文字按钮 · icon-btn 图标按钮 · .mini 小尺寸
 * 选择器：seg-tabs 分段切换 · picker+.field-select 枚举/时间/日期 · .sheet* 底部弹层（搜索+长列表）
 * ============================================================ */

page {
  background: #0b0d15;
  color: #e7e9f3;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 36rpx;
  box-sizing: border-box;
}

/* ---------- 通用布局 ---------- */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: rgba(231, 233, 243, 0.6);
}

.hint {
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(231, 233, 243, 0.6);
}

.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.08);
}

.flex { flex: 1; min-width: 0; }
.mt { margin-top: 24rpx; }
.mt-sm { margin-top: 16rpx; }
.mt-lg { margin-top: 40rpx; }
.mb { margin-bottom: 24rpx; }
.ml { margin-left: 16rpx; }

.ph { color: rgba(231, 233, 243, 0.42); }

/* ---------- 标题层级 ---------- */
.page-title {
  font-size: 40rpx;
  line-height: 1.3;
  font-weight: 900;
  color: #fff;
  overflow-wrap: break-word;
}

.page-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: rgba(231, 233, 243, 0.6);
}

.section-kicker {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #f2c14e;
  background: rgba(255, 255, 255, 0.08);
}

.section-title-lg {
  margin-top: 12rpx;
  font-size: 40rpx;
  line-height: 1.28;
  font-weight: 900;
  color: #fff;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
}

.section-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(231, 233, 243, 0.72);
}

.section-tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(231, 233, 243, 0.6);
}

/* 约爬/活动卡片标题——首页与我的约爬共用 */
.plan-title {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
  color: #fff;
  overflow-wrap: break-word;
}

/* 统一开关：所有 switch 用同一缩放，消除页面各自定义 */
.switch-sm {
  transform: scale(0.85);
  transform-origin: right center;
}

/* ---------- 卡片与面板（唯一卡片形态） ---------- */
.card {
  background: #171b28;
  border: 1rpx solid #2b3044;
  border-radius: 24rpx;
  overflow: hidden;
}

.card-soft {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.08);
}

.card-hero {
  background: linear-gradient(135deg, rgba(143, 123, 255, 0.18), rgba(242, 193, 78, 0.10));
  border-color: rgba(242, 193, 78, 0.16);
}

.card-pad {
  padding: 28rpx;
  box-sizing: border-box;
}

.card-hd {
  padding: 24rpx 28rpx 12rpx;
  font-weight: 800;
  font-size: 32rpx;
  color: #fff;
}

.card-bd {
  padding: 0 28rpx 28rpx;
}

.panel {
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.panel-soft {
  background: rgba(255, 255, 255, 0.03);
}

/* 统计数字 */
.stat-grid {
  display: flex;
  gap: 14rpx;
}

.stat-card {
  flex: 1;
  min-width: 0;
}

.stat-number {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 900;
  color: #fff;
}

.stat-number-warn {
  color: #f2c14e;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.62);
}

/* 列表行 */
.list {
  display: flex;
  flex-direction: column;
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.list-row:first-child {
  border-top: none;
}

/* ---------- 空/加载/失败状态（唯一状态形态） ---------- */
.empty-state {
  padding: 60rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.7;
  color: rgba(231, 233, 243, 0.6);
}

/* 列表尾部状态（加载中/无更多）——区别于首屏空态 */
.list-status {
  padding: 28rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.5);
}

.empty-state__title {
  font-size: 32rpx;
  font-weight: 800;
  color: #e7e9f3;
}

.empty-state__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(231, 233, 243, 0.58);
}

.empty-state .btn,
.empty-state .btn-text {
  margin-top: 24rpx;
}

/* ---------- 按钮体系（唯一按钮形态） ---------- */
.btn {
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
  box-sizing: border-box;
}

.btn.mini {
  min-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.btn--block {
  width: 100%;
}

.btn-primary {
  background: #8f7bff;
  color: #0b0d15;
}

.btn-primary:active {
  background: #7c6ee6;
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.06);
  color: #e7e9f3;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.btn-ghost:active {
  background: rgba(255, 255, 255, 0.1);
}

.btn-warn {
  background: rgba(242, 193, 78, 0.14);
  color: #f2c14e;
  border: 1rpx solid rgba(242, 193, 78, 0.3);
}

.btn-warn:active {
  background: rgba(242, 193, 78, 0.22);
}

.btn-danger {
  background: rgba(242, 139, 148, 0.1);
  color: #f28b94;
  border: 1rpx solid rgba(242, 139, 148, 0.28);
}

.btn-danger:active {
  background: rgba(242, 139, 148, 0.2);
}

.btn[disabled],
.btn--disabled {
  opacity: 0.45;
  pointer-events: none;
}

/* 文字按钮：行内轻量操作（接受/移除/分享/查看全部） */
.btn-text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  background: transparent;
  border: none;
  border-radius: 12rpx;
  color: #c5baff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.6;
}

.btn-text:active {
  background: rgba(143, 123, 255, 0.12);
}

.btn-text--danger {
  color: #f28b94;
}

.btn-text--danger:active {
  background: rgba(242, 139, 148, 0.12);
}

/* 圆形图标按钮：＋ ✕ ↻ ⚙ ‹ 等 */
.icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #e7e9f3;
  font-size: 32rpx;
  line-height: 1;
  box-sizing: border-box;
  flex-shrink: 0;
}

.icon-btn:active {
  background: rgba(143, 123, 255, 0.16);
  border-color: rgba(143, 123, 255, 0.32);
}

.icon-btn--sm {
  width: 56rpx;
  height: 56rpx;
  font-size: 28rpx;
}

.icon-btn--warn {
  background: rgba(242, 193, 78, 0.14);
  border-color: rgba(242, 193, 78, 0.36);
  color: #f2c14e;
}

.icon-btn--danger {
  background: rgba(242, 139, 148, 0.1);
  border-color: rgba(242, 139, 148, 0.28);
  color: #f28b94;
}

/* 底部固定操作栏（一个页面一个主操作） */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #0b0d15;
  z-index: 10;
}

.action-bar__row {
  display: flex;
  gap: 16rpx;
}

.action-bar__row .btn {
  flex: 1;
  min-width: 0;
}

/* ---------- 表单元素（唯一输入形态） ---------- */
.input {
  width: 100%;
  min-height: 80rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #e7e9f3;
  font-size: 28rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #e7e9f3;
  font-size: 28rpx;
  line-height: 1.6;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
}

/* picker 触发器：与输入框同形，包裹原生 <picker> 使用 */
.field-select {
  min-height: 80rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #e7e9f3;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
}

.field-select__value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.field-select__arrow {
  margin-left: auto;
  color: rgba(231, 233, 243, 0.5);
  font-size: 28rpx;
  flex-shrink: 0;
}

.field-label {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(231, 233, 243, 0.68);
  margin-bottom: 12rpx;
}

/* 搜索条 */
.searchbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 80rpx;
  padding: 0 16rpx 0 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
}

.searchbar__ic {
  font-size: 28rpx;
  color: rgba(231, 233, 243, 0.5);
  flex-shrink: 0;
}

.searchbar__input {
  flex: 1;
  min-width: 0;
  min-height: 80rpx;
  line-height: 80rpx;
  color: #e7e9f3;
  font-size: 28rpx;
}

.searchbar .btn {
  flex-shrink: 0;
}

/* ---------- 标签/徽章 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(231, 233, 243, 0.9);
  background: rgba(143, 123, 255, 0.14);
  border: 1rpx solid rgba(143, 123, 255, 0.22);
  box-sizing: border-box;
}

/* 多选选中态：紫色（与主操作一致） */
.tag--on {
  background: #8f7bff;
  border-color: #8f7bff;
  color: #0b0d15;
  font-weight: 700;
}

/* 未选中态：中性 */
.tag--off {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.08);
  color: rgba(231, 233, 243, 0.5);
}

/* 状态徽章：金色（待处理/进行中等状态，不用于选中） */
.tag-warn {
  background: rgba(242, 193, 78, 0.14);
  border-color: rgba(242, 193, 78, 0.26);
  color: #f2c14e;
}

/* ---------- 底部弹层（搜索+长列表选择的唯一形态） ---------- */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.sheet {
  width: 100%;
  max-height: 72vh;
  background: #171b28;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  border-top: 1rpx solid #2b3044;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet--sm { max-height: 48vh; }

.sheet__hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 18rpx;
  border-bottom: 1rpx solid #2b3044;
  flex-shrink: 0;
}

.sheet__title {
  font-size: 32rpx;
  font-weight: 800;
  color: #e7e9f3;
}

.sheet__close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(231, 233, 243, 0.72);
  font-size: 28rpx;
  flex-shrink: 0;
}

.sheet__search {
  padding: 20rpx 28rpx 4rpx;
  flex-shrink: 0;
}

.sheet__bd {
  flex: 1;
  overflow-y: auto;
  padding: 12rpx 0 20rpx;
  box-sizing: border-box;
}

.sheet__ft {
  flex-shrink: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #2b3044;
}

.sheet__ft .btn {
  flex: 1;
  min-width: 0;
}

.sheet-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 28rpx;
  min-height: 88rpx;
  box-sizing: border-box;
}

.sheet-item:active {
  background: rgba(143, 123, 255, 0.08);
}

.sheet-item--danger:active {
  background: rgba(242, 139, 148, 0.1);
}

.sheet-item--danger .sheet-item__label {
  color: rgba(255, 200, 200, 0.96);
}

.sheet-item__label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #e7e9f3;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-item__sub {
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.55);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-item__info {
  flex: 1;
  min-width: 0;
}

.sheet-item__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #e7e9f3;
}

.sheet-item__check {
  color: #8f7bff;
  font-size: 28rpx;
  font-weight: 700;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.sheet-item__arrow {
  color: rgba(231, 233, 243, 0.42);
  font-size: 32rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.sheet-item__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
}

.sheet-item__ic {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: rgba(143, 123, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.sheet-item__btn {
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #c5baff;
  background: rgba(143, 123, 255, 0.12);
  flex-shrink: 0;
}

.sheet-item__btn--danger {
  color: #f28b94;
  background: rgba(242, 139, 148, 0.1);
}

.sheet-item__actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.sheet-divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.08);
  margin: 8rpx 28rpx;
}

.sheet-empty {
  padding: 60rpx 28rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(231, 233, 243, 0.5);
}

.sheet-more {
  padding: 24rpx 28rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #c5baff;
}

.sheet-link-add {
  margin: 12rpx 28rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #c5baff;
  background: rgba(143, 123, 255, 0.1);
  border: 1rpx dashed rgba(143, 123, 255, 0.32);
}

.sheet-circle-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* 弹层内多选勾 */
.check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.check-box--on {
  background: rgba(143, 123, 255, 0.3);
  border-color: #8f7bff;
}

.check-box__t {
  color: #c5baff;
  font-size: 28rpx;
  font-weight: 700;
}

/* 弹层内名片摘要 */
.member-face {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 28rpx;
  text-align: center;
}

.member-face__avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(143, 123, 255, 0.3);
}

.member-face__name {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #e7e9f3;
}

.member-face__title {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.6);
}

.member-face__meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.55);
}

.member-face__tag,
.member-face__role {
  margin-top: 14rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #f2c14e;
  background: rgba(242, 193, 78, 0.12);
  border: 1rpx solid rgba(242, 193, 78, 0.28);
}

/* ---------- 顶部导航栏（自定义返回页统一形态） ---------- */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #e7e9f3;
}

.nav-placeholder {
  width: 72rpx;
  flex-shrink: 0;
}

/* ---------- 约爬流程页（social-* 为全局体系别名，勿在页面内重定义） ---------- */
.social-page {
  padding: 28rpx 28rpx 200rpx;
}

.social-panel {
  background: #171b28;
  border: 1rpx solid #2b3044;
  border-radius: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
  margin-top: 24rpx;
}

.social-title {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.4;
  color: #fff;
  overflow-wrap: break-word;
}

.social-sub {
  font-size: 28rpx;
  color: rgba(231, 233, 243, 0.6);
  line-height: 1.7;
  margin-top: 16rpx;
  overflow-wrap: break-word;
}

.social-label {
  font-size: 24rpx;
  color: #c5baff;
  margin-bottom: 14rpx;
  font-weight: 600;
}

.social-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.social-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
}

.social-person {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
}

.social-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #e7e9f3;
  overflow-wrap: break-word;
}

.social-small {
  font-size: 24rpx;
  color: rgba(231, 233, 243, 0.6);
  line-height: 1.6;
}

.social-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  background: transparent;
  border-radius: 12rpx;
  color: #c5baff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.6;
}

.social-action:active {
  background: rgba(143, 123, 255, 0.12);
}

.social-btn-danger {
  color: #f28b94;
}

.social-btn-danger:active {
  background: rgba(242, 139, 148, 0.12);
}

.social-state {
  padding: 60rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.7;
  color: rgba(231, 233, 243, 0.6);
}

.social-state .btn,
.social-state .btn-text {
  margin-top: 24rpx;
}

.social-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #0b0d15;
  padding: 20rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  z-index: 10;
}

.social-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.social-copy {
  white-space: pre-wrap;
  font-size: 28rpx;
  line-height: 1.75;
  overflow-wrap: break-word;
}

.social-notice {
  background: rgba(143, 123, 255, 0.14);
  color: #dfd5ff;
  padding: 22rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  margin-top: 22rpx;
}

.social-pill {
  font-size: 24rpx;
  color: #c5baff;
  background: rgba(143, 123, 255, 0.14);
  border: 1rpx solid rgba(143, 123, 255, 0.24);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

/* ---------- 原生组件重置 ---------- */
button {
  padding: 0;
  margin: 0;
  background: transparent;
  font-size: inherit;
  line-height: inherit;
}

button::after {
  border: none;
}
