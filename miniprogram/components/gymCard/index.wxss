.gc {
  padding: 20rpx 20rpx 18rpx;
  background: linear-gradient(135deg, rgba(143, 123, 255, 0.12) 0%, rgba(255, 255, 255, 0.06) 45%, rgba(242, 193, 78, 0.08) 100%);
  border-color: rgba(255, 255, 255, 0.14);
  box-shadow: 0 18rpx 42rpx rgba(0, 0, 0, 0.28);
}

.gc--compact {
  padding: 16rpx 18rpx 14rpx;
}

.gc--compact .tag {
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.gc-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.gc-title {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
}

.gc--compact .gc-title {
  font-size: 30rpx;
}

.gc-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.gc-row {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.gc-sub-inline {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gc-meta {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: nowrap;
  overflow: hidden;
}

.gc-hardness-tag {
  color: #f2c14e;
  border-color: rgba(242, 193, 78, 0.26);
  background: rgba(242, 193, 78, 0.1);
}

.gc-inline-tag {
  flex: none;
}

.gc-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.gc-tags--compact {
  margin-top: 12rpx;
  gap: 10rpx;
}

