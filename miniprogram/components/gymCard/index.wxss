/* 岩馆卡片：卡片/标签形态使用全局 .card / .tag 体系，本文件只保留岩馆卡特有布局 */
.gc {
  padding: 24rpx;
}

.gc--compact {
  padding: 20rpx;
}

.gc-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.gc-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gc-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.gc-row {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.gc-sub-inline {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gc-meta {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: nowrap;
  overflow: hidden;
}

.gc-hardness-tag {
  color: #f2c14e;
  border-color: rgba(242, 193, 78, 0.26);
  background: rgba(242, 193, 78, 0.1);
}

.gc-inline-tag {
  flex: none;
}

.gc-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.gc-tags--compact {
  margin-top: 12rpx;
  gap: 10rpx;
}
