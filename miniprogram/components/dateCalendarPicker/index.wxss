.dcp-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
  z-index: 999;
}

.dcp-panel {
  width: 100%;
  border-radius: 20rpx;
  background: rgba(20, 22, 35, 0.98);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  overflow: hidden;
}

.dcp-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 18rpx 18rpx 14rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.dcp-select {
  height: 64rpx;
  min-width: 160rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: rgba(231, 233, 243, 0.92);
  font-weight: 800;
}

.dcp-close {
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(242, 193, 78, 0.14);
  color: #f2c14e;
  border: 1rpx solid rgba(242, 193, 78, 0.25);
  font-weight: 800;
}

.dcp-week {
  display: flex;
  padding: 14rpx 18rpx 0;
}

.dcp-week-item {
  width: 14.285%;
  text-align: center;
  font-size: 24rpx;
}

.dcp-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 10rpx 12rpx 18rpx;
}

.dcp-cell {
  width: 14.285%;
  padding: 10rpx 6rpx;
  box-sizing: border-box;
}

.dcp-day {
  height: 68rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: rgba(231, 233, 243, 0.9);
  font-weight: 800;
}

.dcp-cell--empty .dcp-day {
  background: transparent;
  border-color: transparent;
  color: transparent;
}

.dcp-cell--disabled .dcp-day {
  opacity: 0.25;
}

.dcp-cell--selected .dcp-day {
  background: rgba(143, 123, 255, 0.2);
  border-color: rgba(143, 123, 255, 0.28);
  color: #e7e9f3;
}
