/* 日历选择器：弹层/选择器/按钮均使用全局 sheet / field-select / btn 体系，本文件只保留日历网格特有样式 */

.dcp-hd {
  gap: 16rpx;
}

.dcp-pick {
  flex: 1;
  min-width: 0;
}

.dcp-close {
  flex-shrink: 0;
}

.dcp-week {
  display: flex;
  padding: 16rpx 20rpx 0;
}

.dcp-week-item {
  width: 14.285%;
  text-align: center;
  font-size: 24rpx;
}

.dcp-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 16rpx 24rpx;
}

.dcp-cell {
  width: 14.285%;
  padding: 8rpx 6rpx;
  box-sizing: border-box;
}

.dcp-day {
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: rgba(231, 233, 243, 0.9);
  font-size: 28rpx;
  font-weight: 700;
}

.dcp-cell--empty .dcp-day {
  background: transparent;
  border-color: transparent;
  color: transparent;
}

.dcp-cell--disabled .dcp-day {
  opacity: 0.25;
}

.dcp-cell--selected .dcp-day {
  background: #8f7bff;
  border-color: #8f7bff;
  color: #0b0d15;
  font-weight: 800;
}
