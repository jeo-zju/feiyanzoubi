.sr {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 10rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  margin-top: 14rpx;
}

.sr-left {
  width: 300rpx;
}

.sr-label {
  font-weight: 800;
}

.sr-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.sr-mid {
  width: 90rpx;
  text-align: center;
  font-weight: 800;
}

.sr-actions {
  display: flex;
  gap: 14rpx;
}

.sr-btn {
  width: 72rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.sr-btn--inc {
  background: rgba(242, 193, 78, 0.14);
  color: #f2c14e;
  border-color: rgba(242, 193, 78, 0.25);
}

.sr-btn--disabled {
  opacity: 0.35;
}

