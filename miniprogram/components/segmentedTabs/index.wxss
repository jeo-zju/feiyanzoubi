.seg {
  display: flex;
  gap: 12rpx;
  padding: 10rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.seg-item {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(231, 233, 243, 0.75);
  transition: background 0.15s ease, color 0.15s ease;
}

.seg-item--active {
  background: #8f7bff;
  color: #0b0d15;
}
