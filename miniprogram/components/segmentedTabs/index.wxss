.seg {
  display: flex;
  gap: 16rpx;
  padding: 12rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.seg-item {
  flex: 1;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(231, 233, 243, 0.75);
  font-weight: 700;
}

.seg-item--active {
  background: rgba(143, 123, 255, 0.18);
  color: #e7e9f3;
  border: 1rpx solid rgba(143, 123, 255, 0.22);
}

