<template name="profileCard">
  <view class="shared-card">
    <view class="shared-card__bar">
      <view class="shared-card__bar-side"></view>
      <view class="shared-card__bar-title">{{brandText || '飞岩走壁 · 攀岩名片'}}</view>
      <view wx:if="{{showEditIcon}}" class="shared-card__bar-edit">✎</view>
      <view wx:else class="shared-card__bar-side"></view>
    </view>
    <view class="shared-card__body">
      <view class="shared-card__panel">
        <view class="shared-card__hero">
          <view class="shared-card__avatar-wrap">
            <image wx:if="{{avatarSrc}}" class="shared-card__avatar" mode="aspectFill" src="{{avatarSrc}}" />
            <view wx:else class="shared-card__avatar"></view>
            <view wx:if="{{showInlineEditors}}" class="shared-card__edit-inline shared-card__edit-inline--avatar" bindtap="openAvatarEditor">✎</view>
          </view>
          <view class="shared-card__identity">
            <view class="shared-card__line">
              <view class="shared-card__name">{{name}}</view>
              <view wx:if="{{showInlineEditors}}" class="shared-card__edit-inline" bindtap="openNameEditor">✎</view>
            </view>
            <view class="shared-card__line shared-card__line--sub">
              <view class="shared-card__title">{{title}}</view>
              <view wx:if="{{showInlineEditors}}" class="shared-card__edit-inline" bindtap="openTitlePicker">✎</view>
            </view>
            <view class="shared-card__tags">
              <view class="shared-card__tag-item">
                <view class="shared-card__tag shared-card__tag--mbti {{mbti ? '' : 'shared-card__tag--empty'}}">{{mbti || 'MBTI'}}</view>
                <view wx:if="{{showInlineEditors}}" class="shared-card__edit-inline shared-card__edit-inline--tag" bindtap="openMbtiPicker">✎</view>
              </view>
              <view class="shared-card__tag-item">
                <view class="shared-card__tag shared-card__tag--gym">{{gym}}</view>
                <view wx:if="{{showInlineEditors}}" class="shared-card__edit-inline shared-card__edit-inline--tag" bindtap="openGymsEditor">✎</view>
              </view>
            </view>
          </view>
        </view>
        <view class="shared-card__quote">
          <view class="shared-card__quote-mark">"</view>
          <view wx:if="{{showInlineEditors}}" class="shared-card__edit-inline shared-card__edit-inline--quote" bindtap="openStoryEditor">✎</view>
          <view class="shared-card__one">{{one}}</view>
        </view>
      </view>
    </view>
  </view>
</template>
