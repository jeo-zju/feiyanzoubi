.shared-card {
  width: 100%;
  height: 100%;
  background: #0b0d15;
  display: flex;
  flex-direction: column;
}

.shared-card__bar {
  height: 18%;
  background: linear-gradient(90deg, rgba(143, 123, 255, 0.95), rgba(242, 193, 78, 0.95));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.shared-card__bar-side {
  width: 48rpx;
  height: 48rpx;
  flex: none;
}

.shared-card__bar-title {
  flex: 1;
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(11, 13, 21, 0.48);
  letter-spacing: 1rpx;
  text-align: center;
  white-space: nowrap;
}

.shared-card__bar-edit {
  width: 48rpx;
  height: 48rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 900;
  color: rgba(11, 13, 21, 0.84);
  transform: scaleX(-1) rotate(-18deg);
  transform-origin: center;
  opacity: 0.8;
}

.shared-card__body {
  flex: 1;
  padding: 26rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.shared-card__panel {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
  padding: 26rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.shared-card__hero {
  display: flex;
  align-items: flex-start;
}

.shared-card__avatar-wrap {
  position: relative;
  flex: none;
}

.shared-card__avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 58rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 4rpx solid rgba(242, 193, 78, 0.76);
  box-sizing: border-box;
  flex: none;
}

.shared-card__identity {
  flex: 1;
  margin-left: 22rpx;
  min-width: 0;
}

.shared-card__line {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  max-width: 100%;
}

.shared-card__line--sub {
  margin-top: 12rpx;
}

.shared-card__name {
  font-size: 42rpx;
  font-weight: 900;
  color: #fff;
  line-height: 1.15;
  min-width: 0;
}

.shared-card__title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.90);
  line-height: 1.25;
  min-width: 0;
}

.shared-card__tags {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.shared-card__tag-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
}

.shared-card__tag {
  max-width: 100%;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.shared-card__tag--mbti {
  color: rgba(11, 13, 21, 0.90);
  background: rgba(242, 193, 78, 0.92);
}

.shared-card__tag--empty {
  color: rgba(255, 255, 255, 0.58);
  background: rgba(255, 255, 255, 0.10);
}

.shared-card__tag--gym {
  color: rgba(255, 255, 255, 0.86);
  background: rgba(255, 255, 255, 0.10);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.shared-card__quote {
  margin-top: 28rpx;
  min-height: 132rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  padding: 24rpx 22rpx 22rpx;
  box-sizing: border-box;
  position: relative;
}

.shared-card__edit-inline {
  width: auto;
  height: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.82);
  background: transparent;
  border: 0;
  box-shadow: none;
  transform: scaleX(-1);
}

.shared-card__edit-inline--avatar {
  position: absolute;
  right: 18rpx;
  bottom: 16rpx;
}

.shared-card__edit-inline--tag {
  margin-left: -2rpx;
}

.shared-card__edit-inline--quote {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
}

.shared-card__quote-mark {
  position: absolute;
  left: 18rpx;
  top: 6rpx;
  font-size: 52rpx;
  line-height: 1;
  color: rgba(242, 193, 78, 0.28);
}

.shared-card__one {
  padding-left: 22rpx;
  font-size: 30rpx;
  line-height: 1.48;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.95);
}
